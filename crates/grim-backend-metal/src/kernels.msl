#include <metal_stdlib>
using namespace metal;

kernel void grim_add(
    device const float* a [[buffer(0)]],
    device const float* b [[buffer(1)]],
    device float* c [[buffer(2)]],
    constant int& n [[buffer(3)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n)) {
        c[id] = a[id] + b[id];
    }
}

kernel void grim_mul(
    device const float* a [[buffer(0)]],
    device const float* b [[buffer(1)]],
    device float* c [[buffer(2)]],
    constant int& n [[buffer(3)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n)) {
        c[id] = a[id] * b[id];
    }
}

kernel void grim_silu_mul(
    device const float* gate [[buffer(0)]],
    device const float* up [[buffer(1)]],
    device float* out [[buffer(2)]],
    constant int& n [[buffer(3)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n)) {
        float g = gate[id];
        float s = g / (1.0f + exp(-g));
        out[id] = s * up[id];
    }
}

kernel void grim_silu_mul_backward(
    device const float* e [[buffer(0)]],
    device const float* g [[buffer(1)]],
    device const float* dw [[buffer(2)]],
    device float* df [[buffer(3)]],
    device float* de [[buffer(4)]],
    constant int& n [[buffer(5)]],
    uint id [[thread_position_in_grid]]) {
    if (id < uint(n)) {
        float e_val = e[id];
        float g_val = g[id];
        float dw_val = dw[id];
        float s = 1.0f / (1.0f + exp(-e_val));
        float silu = s * e_val;
        float dsilu = s * (1.0f + e_val * (1.0f - s));
        df[id] = dw_val * g_val * dsilu;
        de[id] = dw_val * silu;
    }
}

kernel void grim_rms_norm(
    device const float* x [[buffer(0)]],
    device const float* w [[buffer(1)]],
    device float* out [[buffer(2)]],
    constant int& row_len [[buffer(3)]],
    constant float& eps [[buffer(4)]],
    constant int& total [[buffer(5)]],
    uint idx [[thread_position_in_grid]]
) {
    if (idx < uint(total)) {
        int row = idx / row_len;
        int col = idx % row_len;

        float ss = 0.0f;
        for (int j = 0; j < row_len; ++j) {
            float val = x[row * row_len + j];
            ss += val * val;
        }
        float rms = sqrt(ss / (float)row_len + eps);
        out[idx] = x[idx] * w[col] / rms;
    }
}

kernel void grim_add_rms_norm(
    device const float* x [[buffer(0)]],
    device const float* residual [[buffer(1)]],
    device const float* w [[buffer(2)]],
    device float* y_out [[buffer(3)]],
    device float* norm_out [[buffer(4)]],
    constant int& row_len [[buffer(5)]],
    constant float& eps [[buffer(6)]],
    constant int& total [[buffer(7)]],
    uint idx [[thread_position_in_grid]]
) {
    if (idx < uint(total)) {
        int row = idx / row_len;
        int col = idx % row_len;

        float y_val = x[idx] + residual[idx];
        y_out[idx] = y_val;

        float ss = 0.0f;
        for (int j = 0; j < row_len; ++j) {
            float v = x[row * row_len + j] + residual[row * row_len + j];
            ss += v * v;
        }
        float rms = sqrt(ss / (float)row_len + eps);
        norm_out[idx] = y_val * w[col] / rms;
    }
}

// Convert float to FP8 E4M3 byte in MSL
static inline uchar float_to_fp8_e4m3_msl(float val) {
    if (isnan(val)) return 0x7Fu;
    float abs_val = abs(val);
    uchar sign = (val < 0.0f) ? 0x80u : 0x00u;
    if (abs_val > 448.0f) abs_val = 448.0f;
    if (abs_val < 0.001953125f) { // 2^-9
        uint mant = uint(round(abs_val * 512.0f));
        if (mant > 7u) mant = 7u;
        return sign | uchar(mant);
    }
    uint u = as_type<uint>(abs_val);
    int e = int((u >> 23u) & 0xFFu) - 127;
    uint m = u & 0x7FFFFFu;
    int e_fp8 = e + 7;
    if (e_fp8 >= 15) return sign | 0x7Eu;
    if (e_fp8 <= 0) {
        uint mant = uint(round(abs_val * 512.0f));
        if (mant > 7u) mant = 7u;
        return sign | uchar(mant);
    }
    uint mant_bits = (m >> 20u) & 0x7u;
    return sign | (uchar(e_fp8) << 3u) | uchar(mant_bits);
}

kernel void grim_quant_q8_0(
    device const float* x [[buffer(0)]],
    device uchar* out [[buffer(1)]],
    constant int& total [[buffer(2)]],
    uint tid [[thread_index_in_threadgroup]],
    uint block_idx [[threadgroup_position_in_grid]]
) {
    threadgroup float s_abs[32];

    uint idx = block_idx * 32u + tid;
    float val = (idx < uint(total)) ? x[idx] : 0.0f;
    s_abs[tid] = abs(val);

    threadgroup_barrier(mem_flags::mem_threadgroup);

    for (uint stride = 16u; stride > 0u; stride /= 2u) {
        if (tid < stride) {
            s_abs[tid] = max(s_abs[tid], s_abs[tid + stride]);
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    float amax = s_abs[0];
    float d = amax / 127.0f;
    float id = (d > 0.0f) ? (1.0f / d) : 0.0f;

    device uchar* block_out = out + block_idx * 34u;

    if (tid == 0u) {
        half d_h = half(d);
        ushort scale_bits = as_type<ushort>(d_h);
        block_out[0] = uchar(scale_bits & 0xFFu);
        block_out[1] = uchar((scale_bits >> 8u) & 0xFFu);
    }

    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (idx < uint(total)) {
        int q = int(round(val * id));
        q = clamp(q, -128, 127);
        block_out[2u + tid] = uchar(q & 0xFF);
    }
}

kernel void grim_quant_fp8(
    device const float* x [[buffer(0)]],
    device uchar* out [[buffer(1)]],
    constant int& total [[buffer(2)]],
    uint idx [[thread_position_in_grid]]
) {
    if (idx == 0u) {
        float scale = 1.0f;
        uint scale_bits = as_type<uint>(scale);
        out[0] = uchar(scale_bits & 0xFFu);
        out[1] = uchar((scale_bits >> 8u) & 0xFFu);
        out[2] = uchar((scale_bits >> 16u) & 0xFFu);
        out[3] = uchar((scale_bits >> 24u) & 0xFFu);
    }

    if (idx < uint(total)) {
        out[4u + idx] = float_to_fp8_e4m3_msl(x[idx]);
    }
}

// Helper: Convert float value to 4-bit MXFP4 E2M1 code
static inline uchar float_to_mxfp4_e2m1_code(float val, uchar shared_exp) {
    if (isnan(val)) return 0x0u;
    float scale = pow(2.0f, float(shared_exp) - 127.0f);
    float unscaled = (scale > 0.0f) ? (val / scale) : 0.0f;
    uchar sign = (unscaled < 0.0f) ? 0x8u : 0x0u;
    float abs_val = abs(unscaled);

    uchar code = 0;
    if (abs_val < 0.25f) {
        code = 0;
    } else if (abs_val < 0.75f) {
        code = 1;
    } else if (abs_val < 1.25f) {
        code = 2;
    } else if (abs_val < 1.75f) {
        code = 3;
    } else if (abs_val < 2.5f) {
        code = 4;
    } else if (abs_val < 3.5f) {
        code = 5;
    } else if (abs_val < 5.0f) {
        code = 6;
    } else {
        code = 7;
    }
    return sign | code;
}

kernel void grim_quant_mxfp4(
    device const float* x [[buffer(0)]],
    device uchar* codes [[buffer(1)]],
    device uchar* exps [[buffer(2)]],
    constant int& total [[buffer(3)]],
    uint tid [[thread_index_in_threadgroup]],
    uint group_idx [[threadgroup_position_in_grid]]
) {
    threadgroup float s_abs[32];
    uint idx = group_idx * 32u + tid;
    float val = (idx < uint(total)) ? x[idx] : 0.0f;
    s_abs[tid] = abs(val);
    threadgroup_barrier(mem_flags::mem_threadgroup);

    for (uint stride = 16u; stride > 0u; stride /= 2u) {
        if (tid < stride) {
            s_abs[tid] = max(s_abs[tid], s_abs[tid + stride]);
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    float amax = s_abs[0];
    uchar shared_exp = 0;
    if (amax > 0.0f) {
        int e = int(floor(log2(amax / 6.0f))) + 127;
        e = clamp(e, 0, 255);
        shared_exp = uchar(e);
    }

    if (tid == 0u) {
        exps[group_idx] = shared_exp;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    uchar nib = float_to_mxfp4_e2m1_code(val, shared_exp);
    uint pair_idx = (group_idx * 32u + tid) / 2u;
    if (tid % 2u == 0u) {
        codes[pair_idx] = (codes[pair_idx] & 0xF0u) | (nib & 0x0Fu);
    } else {
        codes[pair_idx] = (codes[pair_idx] & 0x0Fu) | ((nib & 0x0Fu) << 4u);
    }
}

kernel void grim_quant_mxfp8(
    device const float* x [[buffer(0)]],
    device uchar* codes [[buffer(1)]],
    device uchar* exps [[buffer(2)]],
    constant int& total [[buffer(3)]],
    uint tid [[thread_index_in_threadgroup]],
    uint group_idx [[threadgroup_position_in_grid]]
) {
    threadgroup float s_abs[32];
    uint idx = group_idx * 32u + tid;
    float val = (idx < uint(total)) ? x[idx] : 0.0f;
    s_abs[tid] = abs(val);
    threadgroup_barrier(mem_flags::mem_threadgroup);

    for (uint stride = 16u; stride > 0u; stride /= 2u) {
        if (tid < stride) {
            s_abs[tid] = max(s_abs[tid], s_abs[tid + stride]);
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    float amax = s_abs[0];
    uchar shared_exp = 0;
    if (amax > 0.0f) {
        int e = int(floor(log2(amax / 448.0f))) + 127;
        e = clamp(e, 0, 255);
        shared_exp = uchar(e);
    }

    if (tid == 0u) {
        exps[group_idx] = shared_exp;
    }

    if (idx < uint(total)) {
        float scale = pow(2.0f, float(shared_exp) - 127.0f);
        float unscaled = (scale > 0.0f) ? (val / scale) : 0.0f;
        codes[idx] = float_to_fp8_e4m3_msl(unscaled);
    }
}

kernel void grim_quant_q4k(
    device const float* x [[buffer(0)]],
    device uchar* out [[buffer(1)]],
    constant int& total [[buffer(2)]],
    uint tid [[thread_index_in_threadgroup]],
    uint block_idx [[threadgroup_position_in_grid]]
) {
    device uchar* block_out = out + block_idx * 144u;
    threadgroup float s_min[8];
    threadgroup float s_max[8];

    if (tid < 8u) {
        float sub_min = 1e30f;
        float sub_max = -1e30f;
        uint base_idx = block_idx * 256u + tid * 32u;
        for (uint i = 0u; i < 32u; ++i) {
            uint idx = base_idx + i;
            float val = (idx < uint(total)) ? x[idx] : 0.0f;
            sub_min = min(sub_min, val);
            sub_max = max(sub_max, val);
        }
        s_min[tid] = sub_min;
        s_max[tid] = sub_max;
    }

    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (tid == 0u) {
        float max_d = 0.0f;
        float max_m = 0.0f;
        for (int i = 0; i < 8; ++i) {
            float range = s_max[i] - s_min[i];
            float d_i = range / 15.0f;
            float m_i = -s_min[i] / 15.0f;
            if (d_i > max_d) max_d = d_i;
            if (m_i > max_m) max_m = m_i;
        }

        half d_h = half(max_d);
        half dmin_h = half(max_m);
        ushort d_bits = as_type<ushort>(d_h);
        ushort dmin_bits = as_type<ushort>(dmin_h);

        block_out[0] = uchar(d_bits & 0xFFu);
        block_out[1] = uchar((d_bits >> 8u) & 0xFFu);
        block_out[2] = uchar(dmin_bits & 0xFFu);
        block_out[3] = uchar((dmin_bits >> 8u) & 0xFFu);

        float id = (max_d > 0.0f) ? (1.0f / max_d) : 0.0f;
        float idmin = (max_m > 0.0f) ? (1.0f / max_m) : 0.0f;

        uchar sc[8];
        uchar m_sc[8];
        for (int i = 0; i < 8; ++i) {
            float range = s_max[i] - s_min[i];
            float d_i = range / 15.0f;
            float m_i = -s_min[i] / 15.0f;
            sc[i] = uchar(clamp(int(round(d_i * id)), 0, 63));
            m_sc[i] = uchar(clamp(int(round(m_i * idmin)), 0, 63));
        }

        for (int i = 0; i < 4; ++i) {
            block_out[4 + i] = sc[i] | ((sc[i + 4] & 0x03) << 6);
            block_out[8 + i] = m_sc[i] | ((m_sc[i + 4] & 0x03) << 6);
            block_out[12 + (i % 2) * 2 + i / 2] = ((sc[i + 4] >> 2) & 0x0F) | (((m_sc[i + 4] >> 2) & 0x0F) << 4);
        }
    }

    threadgroup_barrier(mem_flags::mem_threadgroup);

    device uchar* qs = block_out + 16u;
    for (uint i = tid; i < 128u; i += 32u) {
        uint sb = i / 16u;
        uint rel = (i % 16u);
        uint idx0 = block_idx * 256u + sb * 32u + rel;
        uint idx1 = idx0 + 16u;

        float v0 = (idx0 < uint(total)) ? x[idx0] : 0.0f;
        float v1 = (idx1 < uint(total)) ? x[idx1] : 0.0f;

        int q0 = clamp(int(round((v0 + 1.0f) * 7.5f)), 0, 15);
        int q1 = clamp(int(round((v1 + 1.0f) * 7.5f)), 0, 15);

        qs[i] = uchar((q0 & 0x0F) | ((q1 & 0x0F) << 4));
    }
}

kernel void grim_softmax(
    device const float* x [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& last_dim [[buffer(2)]],
    constant int& total [[buffer(3)]],
    uint idx [[thread_position_in_grid]]
) {
    if (idx < uint(total)) {
        int row = idx / last_dim;
        int col = idx % last_dim;

        float max_val = -1e30f;
        for (int j = 0; j < last_dim; ++j) {
            max_val = max(max_val, x[row * last_dim + j]);
        }

        float sum = 0.0f;
        for (int j = 0; j < last_dim; ++j) {
            sum += exp(x[row * last_dim + j] - max_val);
        }

        out[idx] = exp(x[idx] - max_val) / (sum > 0.0f ? sum : 1.0f);
    }
}

kernel void grim_embedding(
    device const float* weight [[buffer(0)]],
    device const uint* indices [[buffer(1)]],
    device float* out [[buffer(2)]],
    constant int& embedding_dim [[buffer(3)]],
    constant int& num_indices [[buffer(4)]],
    uint idx [[thread_position_in_grid]]
|) {
    int total = num_indices * embedding_dim;
    if (idx < uint(total)) {
        int token_idx = idx / embedding_dim;
        int embed_offset = idx % embedding_dim;

        uint word_idx = indices[token_idx];
        out[idx] = weight[word_idx * embedding_dim + embed_offset];
    }
}

// Reverse-mode autodiff for RMSNorm (warp-per-row).
// dx[i] = (w[i]/rms)*g[i] - x[i] * (sum_j g[j]*w[j]*x[j]) / (row_len * rms^3)
// dw[i] = sum_rows g[row,i] * (x[row,i] / rms)
kernel void grim_rmsnorm_backward(
    device const float* x [[buffer(0)]],
    device const float* w [[buffer(1)]],
    device const float* g [[buffer(2)]],
    device float* dx [[buffer(3)]],
    device float* dw [[buffer(4)]],
    constant int& row_len [[buffer(5)]],
    constant float& eps [[buffer(6)]],
    constant int& total [[buffer(7)]],
    constant int& num_rows [[buffer(8)]],
    uint2 gid [[threadgroup_position_in_grid]],
    uint tid [[thread_position_in_threadgroup]]
) {
    int warp_id = int(gid.y);
    int lane = int(tid.y);
    int rows = num_rows;
    if (warp_id >= rows) return;
    const device float* x_row = x + (size_t)warp_id * row_len;
    const device float* g_row = g + (size_t)warp_id * row_len;
    device float* dx_row = dx + (size_t)warp_id * row_len;
    const uint shfl_mask = 0xffffffffu;

    float ss = 0.0f;
    float sum_gw = 0.0f;
    for (int col = lane; col < row_len; col += 32) {
        float xv = x_row[col];
        float gv = g_row[col];
        float wv = w[col];
        ss += xv * xv;
        sum_gw += gv * wv * xv;
    }
    for (int off = 16; off > 0; off >>= 1) {
        ss += simd_xor(ss, off);
        sum_gw += simd_xor(sum_gw, off);
    }
    float rms = sqrt(ss / (float)row_len + eps);
    float rms_inv = 1.0f / rms;
    float scale_sub = (sum_gw / (float)row_len) * (rms_inv * rms_inv * rms_inv);

    for (int col = lane; col < row_len; col += 32) {
        float xv = x_row[col];
        float gv = g_row[col];
        float wv = w[col];
        dx_row[col] = (wv * rms_inv) * gv - xv * scale_sub;
    }
    // Accumulate dw: dw[i] += g[row, i] * (x[row, i] / rms)
    // We do this per-row and atomically accumulate into dw[i].
    // To avoid atomics per-element across rows, we do a two-pass:
    // first compute local dw_contrib per row, then use atomics across rows.
    // For simplicity (Metal native), we use atomics_add here.
    for (int col = lane; col < row_len; col += 32) {
        float xv = x_row[col];
        float gv = g_row[col];
        float contrib = gv * (xv * rms_inv);
        atomic_add_explicit(&dw[col], contrib, memory_order_relaxed);
    }
}

// Reverse-mode autodiff for Rotary Position Embedding (RoPE).
// dx0 = g0*cos + g1*sin, dx1 = -g0*sin + g1*cos
kernel void grim_rope_backward(
    device const float* out_grad [[buffer(0)]],
    device const float* cos_tab [[buffer(1)]],
    device const float* sin_tab [[buffer(2)]],
    device float* dx [[buffer(3)]],
    constant int& half_dim [[buffer(4)]],
    constant int& total_tokens [[buffer(5)]],
    uint idx [[thread_position_in_grid]]
) {
    int head_dim = half_dim * 2;
    int total_pairs = (total_tokens * head_dim) / 2;
    if (idx >= uint(total_pairs)) return;

    int t = idx / half_dim;
    int i = idx % half_dim;
    int offset = t * head_dim;

    float g0 = out_grad[offset + i];
    float g1 = out_grad[offset + half_dim + i];
    float c = cos_tab[i];
    float s = sin_tab[i];

    dx[offset + i] = g0 * c + g1 * s;
    dx[offset + half_dim + i] = -g0 * s + g1 * c;
}

// Reverse-mode autodiff for Softmax.
// dx_i = s_i * (g_i - sum_j g_j * s_j)
kernel void grim_softmax_backward(
    device const float* out_grad [[buffer(0)]],
    device const float* s_out [[buffer(1)]],
    device float* dx [[buffer(2)]],
    constant int& row_len [[buffer(3)]],
    constant int& total [[buffer(4)]],
    uint idx [[thread_position_in_grid]]
) {
    if (idx < uint(total)) {
        int row = idx / row_len;
        int col = idx % row_len;

        float max_val = -1e30f;
        for (int j = 0; j < row_len; ++j) {
            max_val = max(max_val, out_grad[(row * row_len) + j]);
        }
        float sum_g_s = 0.0f;
        for (int j = 0; j < row_len; ++j) {
            sum_g_s += out_grad[(row * row_len) + j] * s_out[(row * row_len) + j];
        }

        dx[idx] = s_out[idx] * (out_grad[idx] - sum_g_s);
    }
}

// Scatter-add for embedding backward.
// dweight[token_ids[t], :] += out_grad[t, :]
// We need two passes: zero-fill dweight, then scatter-add.
kernel void grim_embedding_scatter_add(
    device const float* out_grad [[buffer(0)]],
    device const uint* token_ids [[buffer(1)]],
    device float* dweight [[buffer(2)]],
    constant int& hidden_dim [[buffer(3)]],
    constant int& num_tokens [[buffer(4)]],
    uint idx [[thread_position_in_grid]]
) {
    int total = num_tokens * hidden_dim;
    if (idx < uint(total)) {
        int t = idx / hidden_dim;
        int h = idx % hidden_dim;
        uint word_idx = token_ids[t];
        float val = out_grad[idx];
        atomic_add_explicit(&dweight[word_idx * hidden_dim + h], val, memory_order_relaxed);
    }
}

// Zero-fill for embedding backward (dweight init).
kernel void grim_embedding_zero_fill(
    device float* dweight [[buffer(0)]],
    constant int& size [[buffer(1)]],
    uint idx [[thread_position_in_grid]]
) {
    if (idx < uint(size)) {
        dweight[idx] = 0.0f;
    }
}

// Zero-fill for general use (used by embedding_backward's two-pass approach)
kernel void grim_zeros_f32(
    device float* out [[buffer(0)]],
    constant int& size [[buffer(1)]],
    uint idx [[thread_position_in_grid]]
) {
    if (idx < uint(size)) {
        out[idx] = 0.0f;
    }
}

// MSL Specialization constants for T7 per-candidate specialization
constant int SPEC_BLOCK_M [[function_constant(0)]];
constant int SPEC_BLOCK_N [[function_constant(1)]];
constant int SPEC_BLOCK_K [[function_constant(2)]];
constant bool HAS_SPEC_CONSTANTS [[function_constant(3)]];

kernel void grim_matmul(
    device const float* a [[buffer(0)]],
    device const float* b [[buffer(1)]],
    device float* c [[buffer(2)]],
    constant int& m [[buffer(3)]],
    constant int& n [[buffer(4)]],
    constant int& k [[buffer(5)]],
    constant TileConfig& config [[buffer(6)]],
    uint2 tg_id [[threadgroup_position_in_grid]],
    uint2 tid [[thread_position_in_threadgroup]]
) {
    threadgroup float tile_a[64][64];
    threadgroup float tile_b[64][64];

    int block_m = HAS_SPEC_CONSTANTS ? SPEC_BLOCK_M : config.block_m;
    int block_n = HAS_SPEC_CONSTANTS ? SPEC_BLOCK_N : config.block_n;
    int block_k = HAS_SPEC_CONSTANTS ? SPEC_BLOCK_K : config.block_k;

    int row_start = tg_id.y * block_m;
    int col_start = tg_id.x * block_n;

    float acc = 0.0f;
    for (int bk = 0; bk < k; bk += block_k) {
        int t_row = tid.y;
        int t_col = tid.x;
        if (t_row < block_m && t_col < block_k) {
            if (row_start + t_row < m && bk + t_col < k) {
                tile_a[t_row][t_col] = a[(row_start + t_row) * k + (bk + t_col)];
            } else {
                tile_a[t_row][t_col] = 0.0f;
            }
        }

        if (t_row < block_k && t_col < block_n) {
            if (bk + t_row < k && col_start + t_col < n) {
                tile_b[t_row][t_col] = b[(bk + t_row) * n + (col_start + t_col)];
            } else {
                tile_b[t_row][t_col] = 0.0f;
            }
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);

        for (int i = 0; i < block_k; ++i) {
            acc += tile_a[t_row][i] * tile_b[i][t_col];
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    int out_row = row_start + tid.y;
    int out_col = col_start + tid.x;
    if (out_row < m && out_col < n) {
        c[out_row * n + out_col] = acc;
    }
}

// Split-K MSL path for parallelizing K-dimension reductions across threadgroups
kernel void grim_matmul_split_k(
    device const float* a [[buffer(0)]],
    device const float* b [[buffer(1)]],
    device float* partial_c [[buffer(2)]],
    constant int& m [[buffer(3)]],
    constant int& n [[buffer(4)]],
    constant int& k [[buffer(5)]],
    constant TileConfig& config [[buffer(6)]],
    constant int& num_k_splits [[buffer(7)]],
    uint3 tg_id [[threadgroup_position_in_grid]],
    uint2 tid [[thread_position_in_threadgroup]]
) {
    threadgroup float tile_a[32][32];
    threadgroup float tile_b[32][32];

    int block_m = config.block_m;
    int block_n = config.block_n;
    int block_k = config.block_k;

    int split_idx = tg_id.z;
    int k_chunk = (k + num_k_splits - 1) / num_k_splits;
    int k_start = split_idx * k_chunk;
    int k_end = min(k_start + k_chunk, k);

    int row_start = tg_id.y * block_m;
    int col_start = tg_id.x * block_n;

    float acc = 0.0f;
    for (int bk = k_start; bk < k_end; bk += block_k) {
        int t_row = tid.y;
        int t_col = tid.x;
        if (row_start + t_row < m && bk + t_col < k_end) {
            tile_a[t_row][t_col] = a[(row_start + t_row) * k + (bk + t_col)];
        } else {
            tile_a[t_row][t_col] = 0.0f;
        }

        if (bk + t_row < k_end && col_start + t_col < n) {
            tile_b[t_row][t_col] = b[(bk + t_row) * n + (col_start + t_col)];
        } else {
            tile_b[t_row][t_col] = 0.0f;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);

        for (int i = 0; i < block_k; ++i) {
            acc += tile_a[t_row][i] * tile_b[i][t_col];
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    int out_row = row_start + tid.y;
    int out_col = col_start + tid.x;
    if (out_row < m && out_col < n) {
        int partial_stride = m * n;
        partial_c[split_idx * partial_stride + out_row * n + out_col] = acc;
    }
}

kernel void grim_reduce_split_k(
    device const float* partial_c [[buffer(0)]],
    device float* out_c [[buffer(1)]],
    constant int& total_elements [[buffer(2)]],
    constant int& num_splits [[buffer(3)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(total_elements)) {
        float sum = 0.0f;
        for (int s = 0; s < num_splits; ++s) {
            sum += partial_c[s * total_elements + id];
        }
        out_c[id] = sum;
    }
}

kernel void grim_qkv_attention(
    device const float* q [[buffer(0)]],
    device const float* k_tensor [[buffer(1)]],
    device const float* v_tensor [[buffer(2)]],
    device float* out [[buffer(3)]],
    device float* out_max [[buffer(4)]],
    device float* out_sum [[buffer(5)]],
    constant int& num_heads [[buffer(6)]],
    constant int& num_kv_heads [[buffer(7)]],
    constant int& head_dim [[buffer(8)]],
    constant int& seq_len [[buffer(9)]],
    constant int& kv_seq_len [[buffer(10)]],
    constant int& cache_offset [[buffer(11)]],
    constant float& inv_sqrt_d [[buffer(12)]],
    constant int& window_lo [[buffer(13)]],
    constant int& has_window [[buffer(14)]],
    uint2 id [[thread_position_in_grid]],
    uint tid [[thread_index_in_threadgroup]],
    uint2 tg_id [[threadgroup_position_in_grid]]
) {
    uint i = tg_id.x;
    uint h = tg_id.y;
    if (i >= uint(seq_len) || h >= uint(num_heads)) return;

    int q_per_kv = num_heads / num_kv_heads;
    int kv_head = h / q_per_kv;
    int q_offset = (i * num_heads + h) * head_dim;
    int abs_i = cache_offset + i;
    int hi = (abs_i < kv_seq_len) ? (abs_i + 1) : kv_seq_len;
    // SWA lower bound: has_window > 0 ⇒ start at window_lo (0 = full causal).
    int lo = (has_window > 0) ? window_lo : 0;
    int range_len = (lo < hi) ? (hi - lo) : 0;

    // Threadgroup tiling buffers for key-value slots
    threadgroup float tile_k[32][32];
    threadgroup float tile_v[32][32];

    float running_max = -1e30f;
    float running_sum = 0.0f;

    // Output registers accumulator
    float acc[128] = {0.0f};

    // Load query locally
    float local_q[128];
    for (int d = 0; d < head_dim && d < 128; ++d) {
        local_q[d] = q[q_offset + d];
    }

    for (int block_start = lo; block_start < lo + range_len; block_start += 32) {
        int block_end = min(block_start + 32, hi);
        
        // Coalesced collaborative load from device memory to threadgroup shared storage
        if (tid < 32) {
            for (int d = 0; d < head_dim && d < 32; ++d) {
                int j = block_start + tid;
                if (j < block_end) {
                    tile_k[tid][d] = k_tensor[(j * num_kv_heads + kv_head) * head_dim + d];
                    tile_v[tid][d] = v_tensor[(j * num_kv_heads + kv_head) * head_dim + d];
                } else {
                    tile_k[tid][d] = 0.0f;
                    tile_v[tid][d] = 0.0f;
                }
            }
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);

        // Score evaluation & scaling over the block
        for (int j_local = 0; j_local < (block_end - block_start); ++j_local) {
            float score = 0.0f;
            for (int d = 0; d < head_dim && d < 32; ++d) {
                score += local_q[d] * tile_k[j_local][d];
            }
            score *= inv_sqrt_d;

            float prev_max = running_max;
            running_max = max(running_max, score);
            float scale_prev = exp(prev_max - running_max);
            float scale_score = exp(score - running_max);
            
            running_sum = running_sum * scale_prev + scale_score;

            for (int d = 0; d < head_dim && d < 128; ++d) {
                acc[d] = acc[d] * scale_prev + scale_score * tile_v[j_local][d];
            }
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    float inv_sum = running_sum > 0.0f ? (1.0f / running_sum) : 1.0f;
    for (int d = 0; d < head_dim && d < 128; ++d) {
        out[q_offset + d] = acc[d] * inv_sum;
    }

    if (out_max != nullptr) {
        out_max[i * num_heads + h] = running_max;
    }
    if (out_sum != nullptr) {
        out_sum[i * num_heads + h] = running_sum;
    }
}

kernel void grim_qkv_attention_paged(
    device const float* q [[buffer(0)]],
    device const float* k_pages [[buffer(1)]],
    device const float* v_pages [[buffer(2)]],
    device const uint* block_table [[buffer(3)]],
    device float* out [[buffer(4)]],
    constant int& batch [[buffer(5)]],
    constant int& num_heads [[buffer(6)]],
    constant int& head_dim [[buffer(7)]],
    constant int& page_size [[buffer(8)]],
    constant int& max_blocks [[buffer(9)]],
    constant int& kv_seq_len [[buffer(10)]],
    constant int& num_kv_heads [[buffer(11)]],
    constant int& window_lo [[buffer(12)]],
    constant int& has_window [[buffer(13)]],
    uint3 id [[thread_position_in_grid]]) {
    int d = int(id.x);
    int h = int(id.y);
    int b = int(id.z);
    if (b >= batch || h >= num_heads || d >= head_dim) return;
    int q_base = (b * num_heads + h) * head_dim;
    float scale = rsqrt(float(head_dim));
    float running_max = -1e30f;
    float running_sum = 0.0f;
    float acc = 0.0f;
    // SWA lower bound: has_window > 0 ⇒ start at window_lo (0 = full causal).
    int lo = (has_window > 0) ? window_lo : 0;
    for (int pos = lo; pos < kv_seq_len; ++pos) {
        int logical_block = pos / page_size;
        if (logical_block >= max_blocks) break;
        int physical_block = int(block_table[b * max_blocks + logical_block]);
        int offset = pos % page_size;
        int kv_head = h / (num_heads / num_kv_heads);
        int kv_base = ((physical_block * page_size + offset) * num_kv_heads + kv_head) * head_dim;
        float score = 0.0f;
        for (int qd = 0; qd < head_dim; ++qd) score += q[q_base + qd] * k_pages[kv_base + qd];
        score *= scale;
        float old_max = running_max;
        running_max = max(running_max, score);
        float old_weight = exp(old_max - running_max);
        float new_weight = exp(score - running_max);
        running_sum = running_sum * old_weight + new_weight;
        acc = acc * old_weight + new_weight * v_pages[kv_base + d];
    }
    out[q_base + d] = running_sum > 0.0f ? acc / running_sum : 0.0f;
}

kernel void grim_tree_attention(
    device const float* q [[buffer(0)]],
    device const float* k [[buffer(1)]],
    device const float* v [[buffer(2)]],
    device const uint* parents [[buffer(3)]],
    device float* out [[buffer(4)]],
    constant int& batch [[buffer(5)]],
    constant int& num_heads [[buffer(6)]],
    constant int& kv_seq_len [[buffer(7)]],
    constant int& head_dim [[buffer(8)]],
    constant int& gamma [[buffer(9)]],
    constant int& cache_offset [[buffer(10)]],
    constant int& num_kv_heads [[buffer(11)]],
    uint3 id [[thread_position_in_grid]]) {
    int d = int(id.x);
    int head_work = int(id.y);
    int b = int(id.z);
    int nodes = gamma + 1;
    int node = head_work / num_heads;
    int q_head = head_work % num_heads;
    if (b >= batch || node >= nodes || d >= head_dim) return;
    int q_base = ((b * nodes + node) * num_heads) * head_dim;
    float scale = rsqrt(float(head_dim));
    float running_max = -1e30f;
    float running_sum = 0.0f;
    float acc = 0.0f;
    for (int pos = 0; pos < kv_seq_len; ++pos) {
        bool attend = pos < cache_offset;
        if (!attend) {
            int tree_node = pos - cache_offset;
            if (tree_node <= node) {
                attend = tree_node == node;
                int cursor = node;
                for (int depth = 0; depth <= gamma && cursor > 0; ++depth) {
                    cursor = int(parents[cursor]);
                    if (cursor == tree_node) { attend = true; break; }
                }
            }
        }
        if (!attend) continue;
        int q_per_kv = num_heads / num_kv_heads;
        int kv_head = q_head / q_per_kv;
        int q_head_base = q_base + q_head * head_dim;
        int kv_base = ((b * kv_seq_len + pos) * num_kv_heads + kv_head) * head_dim;
        float score = 0.0f;
        for (int qd = 0; qd < head_dim; ++qd) score += q[q_head_base + qd] * k[kv_base + qd];
        score *= scale;
        float old_max = running_max;
        running_max = max(running_max, score);
        float old_weight = exp(old_max - running_max);
        float new_weight = exp(score - running_max);
        running_sum = running_sum * old_weight + new_weight;
        acc = acc * old_weight + new_weight * v[kv_base + d];
    }
    out[q_base + d] = running_sum > 0.0f ? acc / running_sum : 0.0f;
}

kernel void grim_kv_dequant_attention(
    device const float* q [[buffer(0)]],
    device const uchar* k_tensor [[buffer(1)]],
    device const float* k_scales [[buffer(2)]],
    device const uchar* v_tensor [[buffer(3)]],
    device const float* v_scales [[buffer(4)]],
    device float* out [[buffer(5)]],
    constant int& num_heads [[buffer(6)]],
    constant int& num_kv_heads [[buffer(7)]],
    constant int& head_dim [[buffer(8)]],
    constant int& seq_len [[buffer(9)]],
    constant int& kv_seq_len [[buffer(10)]],
    constant int& cache_offset [[buffer(11)]],
    constant float& inv_sqrt_d [[buffer(12)]],
    constant int& quant_bits [[buffer(13)]],
    uint2 tg_id [[threadgroup_position_in_grid]]
) {
    uint i = tg_id.x;
    uint h = tg_id.y;
    if (i >= uint(seq_len) || h >= uint(num_heads)) return;

    int q_per_kv = num_heads / num_kv_heads;
    int kv_head = h / q_per_kv;
    int q_offset = (i * num_heads + h) * head_dim;
    int abs_i = cache_offset + i;
    int range_len = (abs_i < kv_seq_len) ? (abs_i + 1) : kv_seq_len;

    float running_max = -1e30f;
    float running_sum = 0.0f;
    float acc[256] = {0.0f};

    // Load query locally
    float local_q[256];
    for (int d = 0; d < head_dim && d < 256; ++d) {
        local_q[d] = q[q_offset + d];
    }

    for (int j = 0; j < range_len; ++j) {
        float score = 0.0f;
        float scale_k = k_scales[j * num_kv_heads + kv_head];
        
        if (quant_bits == 8) {
            int k_row_offset = (j * num_kv_heads + kv_head) * head_dim;
            for (int d = 0; d < head_dim && d < 256; ++d) {
                float k_val = (((float)((int)k_tensor[k_row_offset + d]) - 128.0f) / 127.0f) * scale_k;
                score += local_q[d] * k_val;
            }
        } else {
            int k_row_offset = ((j * num_kv_heads + kv_head) * head_dim) / 2;
            for (int d = 0; d < head_dim && d < 256; ++d) {
                uchar byte = k_tensor[k_row_offset + d / 2];
                float nib = (float)((d % 2 == 0) ? (byte & 0xF) : (byte >> 4));
                float k_val = (nib - 8.0f) / 7.0f * scale_k;
                score += local_q[d] * k_val;
            }
        }
        score *= inv_sqrt_d;

        float prev_max = running_max;
        running_max = max(running_max, score);
        float scale_prev = exp(prev_max - running_max);
        float scale_score = exp(score - running_max);
        running_sum = running_sum * scale_prev + scale_score;

        float scale_v = v_scales[j * num_kv_heads + kv_head];
        if (quant_bits == 8) {
            int v_row_offset = (j * num_kv_heads + kv_head) * head_dim;
            for (int d = 0; d < head_dim && d < 256; ++d) {
                float v_val = (((float)((int)v_tensor[v_row_offset + d]) - 128.0f) / 127.0f) * scale_v;
                acc[d] = acc[d] * scale_prev + scale_score * v_val;
            }
        } else {
            int v_row_offset = ((j * num_kv_heads + kv_head) * head_dim) / 2;
            for (int d = 0; d < head_dim && d < 256; ++d) {
                uchar byte = v_tensor[v_row_offset + d / 2];
                float nib = (float)((d % 2 == 0) ? (byte & 0xF) : (byte >> 4));
                float v_val = (nib - 8.0f) / 7.0f * scale_v;
                acc[d] = acc[d] * scale_prev + scale_score * v_val;
            }
        }
    }

    float inv_sum = running_sum > 0.0f ? (1.0f / running_sum) : 1.0f;
    for (int d = 0; d < head_dim && d < 256; ++d) {
        out[q_offset + d] = acc[d] * inv_sum;
    }
}

kernel void grim_mul_scalar(
    device const float* x [[buffer(0)]],
    constant float& scalar [[buffer(1)]],
    device float* out [[buffer(2)]],
    constant int& n [[buffer(3)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n)) {
        out[id] = x[id] * scalar;
    }
}

kernel void grim_sqrt(
    device const float* x [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n)) {
        out[id] = sqrt(x[id]);
    }
}

kernel void grim_recip(
    device const float* x [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n)) {
        out[id] = 1.0f / x[id];
    }
}

kernel void grim_rope(
    device const float* x [[buffer(0)]],
    device const uint* pos [[buffer(1)]],
    device float* out [[buffer(2)]],
    constant int& num_tokens [[buffer(3)]],
    constant int& num_heads [[buffer(4)]],
    constant int& head_dim [[buffer(5)]],
    constant float& base [[buffer(6)]],
    uint idx [[thread_position_in_grid]]
) {
    int half_dim = head_dim / 2;
    int total = num_tokens * num_heads * half_dim;
    if (idx < uint(total)) {
        int pair_idx = idx % half_dim;
        int head_idx = (idx / half_dim) % num_heads;
        int token_idx = idx / (half_dim * num_heads);

        uint p = pos[token_idx];
        float freq = 1.0f / pow(base, (float)(2 * pair_idx) / (float)head_dim);
        float val = (float)p * freq;
        float cos_v = cos(val);
        float sin_v = sin(val);

        int base_offset = (token_idx * num_heads + head_idx) * head_dim;
        int i0 = base_offset + 2 * pair_idx;
        int i1 = base_offset + 2 * pair_idx + 1;

        float v0 = x[i0];
        float v1 = x[i1];

        out[i0] = v0 * cos_v - v1 * sin_v;
        out[i1] = v0 * sin_v + v1 * cos_v;
    }
}

// Partial-rotary + YaRN RoPE. Mirrors the HIP `grim_rope_yarn` numerically with
// the interleaved pair layout (2i, 2i+1) used by `grim_rope`. The YaRN
// frequency ramp + mscale are recomputed inside the kernel from the scalar
// arguments (no inv_freq buffer). The non-rotary tail [rotary_dim, head_dim)
// is copied verbatim by a second pass over the same thread pool.
kernel void grim_rope_yarn(
    device const float* x [[buffer(0)]],
    device const uint* pos [[buffer(1)]],
    device float* out [[buffer(2)]],
    constant int& num_tokens [[buffer(3)]],
    constant int& num_heads [[buffer(4)]],
    constant int& head_dim [[buffer(5)]],
    constant int& rotary_dim [[buffer(6)]],
    constant int& has_yarn [[buffer(7)]],
    constant float& base [[buffer(8)]],
    constant float& yarn_factor [[buffer(9)]],
    constant float& yarn_orig_max [[buffer(10)]],
    constant float& yarn_beta_fast [[buffer(11)]],
    constant float& yarn_beta_slow [[buffer(12)]],
    constant float& mscale [[buffer(13)]],
    uint idx [[thread_position_in_grid]]
) {
    int rdim = (rotary_dim <= 0) ? head_dim : rotary_dim;
    int rotary_half = rdim / 2;
    int copy_len = head_dim - rdim;

    // Pass 1: rotate the [0, rotary_half) pairs (interleaved layout).
    int total = num_tokens * num_heads * rotary_half;
    if (idx < uint(total)) {
        int pair_idx = idx % rotary_half;
        int head_idx = (idx / rotary_half) % num_heads;
        int token_idx = idx / (rotary_half * num_heads);

        uint p = pos[token_idx];
        float freq = 1.0f / pow(base, (float)(2 * pair_idx) / (float)head_dim);

        if (has_yarn > 0) {
            float wavelength = 2.0f * 3.14159265358979323846f / freq;
            float low = yarn_orig_max / yarn_beta_slow;
            float high = yarn_orig_max / yarn_beta_fast;
            if (wavelength < high) {
                // extrapolation region: unchanged
            } else if (wavelength > low) {
                freq = freq / yarn_factor;
            } else {
                float ramp = (yarn_orig_max / wavelength - yarn_beta_slow)
                             / (yarn_beta_fast - yarn_beta_slow);
                freq = (1.0f - ramp) * (freq / yarn_factor) + ramp * freq;
            }
        }

        float val = (float)p * freq;
        float cos_v = cos(val) * mscale;
        float sin_v = sin(val) * mscale;

        int base_offset = (token_idx * num_heads + head_idx) * head_dim;
        int i0 = base_offset + 2 * pair_idx;
        int i1 = base_offset + 2 * pair_idx + 1;

        float v0 = x[i0];
        float v1 = x[i1];
        out[i0] = v0 * cos_v - v1 * sin_v;
        out[i1] = v0 * sin_v + v1 * cos_v;
        return;
    }

    // Pass 2: copy the non-rotary tail [rdim, head_dim) verbatim.
    if (copy_len > 0) {
        int total2 = num_tokens * num_heads * copy_len;
        if (idx < uint(total2)) {
            int ci = idx % copy_len;
            int head_idx = (idx / copy_len) % num_heads;
            int token_idx = idx / (copy_len * num_heads);
            int src = (token_idx * num_heads + head_idx) * head_dim + rdim + ci;
            out[src] = x[src];
        }
    }
}

kernel void grim_quantized_matmul_q8_0(
    device const float* a [[buffer(0)]],
    device const uchar* b [[buffer(1)]],
    device const float* b_scales [[buffer(2)]],
    device float* out [[buffer(3)]],
    constant int& m [[buffer(4)]],
    constant int& n [[buffer(5)]],
    constant int& k [[buffer(6)]],
    uint2 id [[thread_position_in_grid]]
) {
    int row = id.y;
    int col = id.x;
    if (row < m && col < n) {
        float sum = 0.0f;
        int blocks_per_row = k / 32;
        for (int b_idx = 0; b_idx < blocks_per_row; ++b_idx) {
            float scale = b_scales[col * blocks_per_row + b_idx];
            int b_offset = (col * blocks_per_row + b_idx) * 32;
            int a_offset = row * k + b_idx * 32;
            for (int i = 0; i < 32; ++i) {
                char q = (char)b[b_offset + i];
                sum += a[a_offset + i] * ((float)q * scale);
            }
        }
        out[row * n + col] = sum;
    }
}

// ResidualPacked forward GEMM.  Codes are MSB-first within each byte and each
// logical output row has a 256-byte aligned stride.  Auxiliary arrays are
// explicit buffers: scales are decoded host-side, while outlier indices and
// values are uploaded as compact device arrays for a bounded lookup.
inline uint residual_code(device const uchar* b, uint row_base, uint index, uint bpw) {
    uint bit = index * bpw;
    uint byte = row_base + (bit >> 3);
    uint shift = 8u - bpw - (bit & 7u);
    return (uint(b[byte]) >> shift) & ((1u << bpw) - 1u);
}

kernel void grim_quantized_matmul_residualpacked(
    device const float* a [[buffer(0)]], device const uchar* b [[buffer(1)]],
    device const float* scales [[buffer(2)]], device const uint* outlier_indices [[buffer(3)]],
    device const float* outlier_values [[buffer(4)]], device float* out [[buffer(5)]],
    constant int& m [[buffer(6)]], constant int& n [[buffer(7)]], constant int& k [[buffer(8)]],
    constant int& bpw [[buffer(9)]], constant int& row_stride [[buffer(10)]],
    constant int& scale_offset [[buffer(11)]], constant int& backup1_bpw [[buffer(12)]],
    constant int& backup1_offset [[buffer(13)]], constant int& backup1_scale_offset [[buffer(14)]],
    constant int& backup2_bpw [[buffer(15)]], constant int& backup2_offset [[buffer(16)]],
    constant int& backup2_scale_offset [[buffer(17)]], constant int& outlier_count [[buffer(18)]],
    uint2 id [[thread_position_in_grid]]) {
    int row = int(id.y), col = int(id.x);
    if (row >= m || col >= n) return;
    float sum = 0.0f;
    for (int j = 0; j < k; ++j) {
        uint flat = uint(col * k + j);
        float value = float(residual_code(b, uint(col * row_stride), uint(j), uint(bpw))) * scales[col];
        if (backup1_bpw > 0)
            value += float(residual_code(b, uint(backup1_offset + col * row_stride), uint(j), uint(backup1_bpw))) * scales[n + col];
        if (backup2_bpw > 0)
            value += float(residual_code(b, uint(backup2_offset + col * row_stride), uint(j), uint(backup2_bpw))) * scales[2 * n + col];
        for (int oi = 0; oi < outlier_count; ++oi)
            if (outlier_indices[oi] == flat) { value = outlier_values[oi]; break; }
        sum += a[row * k + j] * value;
    }
    out[row * n + col] = sum;
}

kernel void grim_quantized_matmul_backward_q8_0(
    device const float* dy [[buffer(0)]],
    device const uchar* b [[buffer(1)]],
    device const float* scales [[buffer(2)]],
    device float* dx [[buffer(3)]],
    constant int& m [[buffer(4)]],
    constant int& n [[buffer(5)]],
    constant int& k [[buffer(6)]],
    uint2 id [[thread_position_in_grid]]) {
    int row = id.y;
    int k_idx = id.x;
    if (row < m && k_idx < k) {
        float sum = 0.0f;
        int blocks = k / 32;
        int block = k_idx / 32;
        int in_block = k_idx % 32;
        for (int col = 0; col < n; ++col) {
            int b_offset = (col * blocks + block) * 32 + in_block;
            char q = (char)b[b_offset];
            float scale = scales[col * blocks + block];
            sum += dy[row * n + col] * (float(q) * scale);
        }
        dx[row * k + k_idx] = sum;
    }
}

kernel void grim_quantized_matmul_q8_0(
    device const float* a [[buffer(0)]],
    device const uchar* b [[buffer(1)]],
    device const float* b_scales [[buffer(2)]],
    device float* out [[buffer(3)]],
    constant int& m [[buffer(4)]],
    constant int& n [[buffer(5)]],
    constant int& k [[buffer(6)]],
    uint2 id [[thread_position_in_grid]]
) {
    int row = id.y;
    int col = id.x;
    if (row < m && col < n) {
        float sum = 0.0f;
        int blocks_per_row = k / 32;
        for (int b_idx = 0; b_idx < blocks_per_row; ++b_idx) {
            float scale = b_scales[col * blocks_per_row + b_idx];
            int b_offset = (col * blocks_per_row + b_idx) * 32;
            int a_offset = row * k + b_idx * 32;
            for (int i = 0; i < 32; ++i) {
                char q = (char)b[b_offset + i];
                sum += a[a_offset + i] * ((float)q * scale);
            }
        }
        out[row * n + col] = sum;
    }
}

// ── SCYTHE-2 all_reduce accumulate kernel ─────────────────────────────
//   out[id] += a[id]
// Caller pre-zeros `out`, then dispatches once per input tensor to
// accumulate a sum across N same-shape inputs.
kernel void grim_all_reduce(
    device const float* a [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n)) {
        out[id] += a[id];
    }
}

// ── SCYTHE-2 comm_fuse_reduce scatter-copy kernel ──────────────────────
// Copies a column shard In[row, col] → Out[row, col_offset + col],
// where Out is [m, n_total] (pre-zeroed) and In is [m, n_src].
kernel void grim_comm_fuse_reduce(
    device const float* in [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& m [[buffer(2)]],
    constant int& n_src [[buffer(3)]],
    constant int& col_offset [[buffer(4)]],
    constant int& n_total [[buffer(5)]],
    uint2 id [[thread_position_in_grid]]
) {
    int row = int(id.y);
    int col = int(id.x);
    if (row < m && col < n_src) {
        out[row * n_total + col_offset + col] = in[row * n_src + col];
    }
}

// ── Standalone Dequantization MSL Kernels ──────────────────────────────

inline float metal_fp16_to_float(ushort h) {
    uint sign = (h >> 15) & 1;
    uint exp  = (h >> 10) & 0x1f;
    uint mant = h & 0x3ff;
    if (exp == 0) {
        if (mant == 0) return sign ? -0.0f : 0.0f;
        float res = (float)mant / 1024.0f * 0.00006103515625f;
        return sign ? -res : res;
    } else if (exp == 31) {
        return sign ? -1.0f/0.0f : 1.0f/0.0f;
    }
    float res = (1.0f + (float)mant / 1024.0f) * pow(2.0f, (float)exp - 15.0f);
    return sign ? -res : res;
}

inline float metal_fp8_e4m3_to_float(uchar val) {
    int sign = (val >> 7) & 1;
    int exp = (val >> 3) & 0x0F;
    int mant = val & 0x07;
    if (exp == 0xF) {
        if (mant == 7) return 0.0f / 0.0f; // NaN
        float v = 448.0f;
        return sign ? -v : v;
    }
    float res;
    if (exp != 0) {
        res = (1.0f + (float)mant / 8.0f) * pow(2.0f, (float)exp - 7.0f);
    } else {
        res = (float)mant / 512.0f;
    }
    return sign ? -res : res;
}

inline float metal_mxfp4_to_float(uchar code, uchar shared_exp) {
    int sign = (code >> 3) & 1;
    int exp = (code >> 1) & 3;
    int mant = code & 1;
    float base_val = 0.0f;
    if (exp == 0) {
        base_val = (float)mant * 0.5f;
    } else {
        base_val = (1.0f + (float)mant * 0.5f) * pow(2.0f, (float)exp - 1.0f);
    }
    if (sign) base_val = -base_val;
    float scale = pow(2.0f, (float)shared_exp - 127.0f);
    return base_val * scale;
}

kernel void grim_dequant_fp8(
    device const uchar* packed [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& elem_count [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(elem_count)) {
        out[id] = metal_fp8_e4m3_to_float(packed[id]);
    }
}

kernel void grim_dequant_mxfp4(
    device const uchar* codes [[buffer(0)]],
    device const uchar* exps [[buffer(1)]],
    device float* out [[buffer(2)]],
    constant int& elem_count [[buffer(3)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(elem_count)) {
        int byte_idx = id / 2;
        uchar packed = codes[byte_idx];
        uchar nib = (id % 2 == 0) ? (packed & 0x0F) : (packed >> 4);
        uchar shared_exp = exps[id / 32];
        out[id] = metal_mxfp4_to_float(nib, shared_exp);
    }
}

kernel void grim_dequant_mxfp8(
    device const uchar* codes [[buffer(0)]],
    device const uchar* exps [[buffer(1)]],
    device float* out [[buffer(2)]],
    constant int& elem_count [[buffer(3)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(elem_count)) {
        uchar code = codes[id];
        uchar shared_exp = exps[id / 32];
        float base_val = metal_fp8_e4m3_to_float(code);
        float scale = pow(2.0f, (float)shared_exp - 127.0f);
        out[id] = base_val * scale;
    }
}

kernel void grim_dequant_q4k(
    device const uchar* packed [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n_blocks [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n_blocks * 256)) {
        int block_idx = id / 256;
        int in_sb = id % 256;
        device const uchar* block_ptr = packed + block_idx * 144;
        device const ushort* h_ptr = (device const ushort*)block_ptr;
        float d = metal_fp16_to_float(h_ptr[0]);
        float dmin = metal_fp16_to_float(h_ptr[1]);

        device const uchar* scales = block_ptr + 4;
        device const uchar* qs = block_ptr + 16;

        int is = in_sb / 32;
        uchar sc, m;
        if (is < 4) {
            sc = scales[is] & 63;
            m  = scales[is + 4] & 63;
        } else {
            sc = (scales[is + 4] & 0xF) | ((scales[is - 4] >> 6) << 4);
            m  = (scales[is + 4] >> 4)  | ((scales[is] >> 6) << 4);
        }

        int il = in_sb % 32;
        uchar q;
        if (il < 16) {
            q = qs[is * 16 + il] & 0xF;
        } else {
            q = qs[is * 16 + il - 16] >> 4;
        }

        out[id] = d * (float)sc * (float)q - dmin * (float)m;
    }
}

kernel void grim_dequant_q8_0(
    device const uchar* packed [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n_blocks [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n_blocks * 32)) {
        int block_idx = id / 32;
        int in_block = id % 32;
        device const uchar* block_ptr = packed + block_idx * 34;
        device const ushort* h_ptr = (device const ushort*)block_ptr;
        float d = metal_fp16_to_float(h_ptr[0]);
        char q = (char)block_ptr[2 + in_block];
        out[id] = d * (float)q;
    }
}

kernel void grim_dequant_iq2xxs(
    device const uchar* packed [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n_blocks [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n_blocks * 256)) {
        int block_idx = id / 256;
        int in_sb = id % 256;
        device const uchar* block_ptr = packed + block_idx * 66;
        device const ushort* h_ptr = (device const ushort*)block_ptr;
        float d = metal_fp16_to_float(h_ptr[0]);
        uchar q = block_ptr[2 + in_sb / 4];
        uchar val = (q >> ((in_sb % 4) * 2)) & 3;
        out[id] = d * (float)val;
    }
}

kernel void grim_dequant_iq2xs(
    device const uchar* packed [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n_blocks [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n_blocks * 256)) {
        int block_idx = id / 256;
        int in_sb = id % 256;
        device const uchar* block_ptr = packed + block_idx * 74;
        device const ushort* h_ptr = (device const ushort*)block_ptr;
        float d = metal_fp16_to_float(h_ptr[0]);
        uchar q = block_ptr[2 + in_sb / 4];
        uchar val = (q >> ((in_sb % 4) * 2)) & 3;
        out[id] = d * (float)val;
    }
}

kernel void grim_dequant_iq2s(
    device const uchar* packed [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n_blocks [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n_blocks * 256)) {
        int block_idx = id / 256;
        int in_sb = id % 256;
        device const uchar* block_ptr = packed + block_idx * 82;
        device const ushort* h_ptr = (device const ushort*)block_ptr;
        float d = metal_fp16_to_float(h_ptr[0]);
        uchar q = block_ptr[2 + in_sb / 4];
        uchar val = (q >> ((in_sb % 4) * 2)) & 3;
        out[id] = d * (float)val;
    }
}

kernel void grim_dequant_iq3xxs(
    device const uchar* packed [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n_blocks [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n_blocks * 256)) {
        int block_idx = id / 256;
        int in_sb = id % 256;
        device const uchar* block_ptr = packed + block_idx * 96;
        device const ushort* h_ptr = (device const ushort*)block_ptr;
        float d = metal_fp16_to_float(h_ptr[0]);
        uchar q = block_ptr[2 + in_sb / 3];
        uchar val = (q >> ((in_sb % 3) * 2)) & 7;
        out[id] = d * (float)val;
    }
}

kernel void grim_dequant_iq3s(
    device const uchar* packed [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n_blocks [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n_blocks * 256)) {
        int block_idx = id / 256;
        int in_sb = id % 256;
        device const uchar* block_ptr = packed + block_idx * 110;
        device const ushort* h_ptr = (device const ushort*)block_ptr;
        float d = metal_fp16_to_float(h_ptr[0]);
        uchar q = block_ptr[2 + in_sb / 3];
        uchar val = (q >> ((in_sb % 3) * 2)) & 7;
        out[id] = d * (float)val;
    }
}

kernel void grim_dequant_iq4nl(
    device const uchar* packed [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n_blocks [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n_blocks * 256)) {
        int block_idx = id / 256;
        int in_sb = id % 256;
        device const uchar* block_ptr = packed + block_idx * 170;
        device const ushort* h_ptr = (device const ushort*)block_ptr;
        float d = metal_fp16_to_float(h_ptr[0]);
        uchar q = block_ptr[2 + in_sb / 2];
        uchar nib = (in_sb % 2 == 0) ? (q & 0x0F) : (q >> 4);
        out[id] = d * (float)nib;
    }
}

kernel void grim_dequant_iq4xs(
    device const uchar* packed [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n_blocks [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n_blocks * 256)) {
        int block_idx = id / 256;
        int in_sb = id % 256;
        device const uchar* block_ptr = packed + block_idx * 178;
        device const ushort* h_ptr = (device const ushort*)block_ptr;
        float d = metal_fp16_to_float(h_ptr[0]);
        uchar q = block_ptr[2 + in_sb / 2];
        uchar nib = (in_sb % 2 == 0) ? (q & 0x0F) : (q >> 4);
        out[id] = d * (float)nib;
    }
}

// ---- Fused grouped MoE dispatch (WI-M5) ----------------------------------
// One thread per output element of `out` ([batch, hidden]); each thread scans
// the routed (token, expert) pairs that target its token and accumulates the
// gated MLP contribution sequentially. Sequential accumulation (no atomics)
// makes the GPU result bit-for-bit reproducible against the CPU reference,
// which is what the parity test asserts. Contract matches the Vulkan/CUDA
// `moe_fused_dispatch` kernels.
kernel void grim_moe_fused_dispatch(
    device const float* x [[buffer(0)]],
    device const float* gate_w [[buffer(1)]],
    device const float* up_w [[buffer(2)]],
    device const float* down_w [[buffer(3)]],
    device const float* router_tokens [[buffer(4)]],
    device const float* router_experts [[buffer(5)]],
    device const float* router_weights [[buffer(6)]],
    device float* out [[buffer(7)]],
    constant int& hidden [[buffer(8)]],
    constant int& inter [[buffer(9)]],
    constant int& num_experts [[buffer(10)]],
    constant int& batch [[buffer(11)]],
    constant float& rsf [[buffer(12)]],
    constant int& num_pairs [[buffer(13)]],
    uint2 gid [[thread_position_in_grid]]
) {
    if (gid.x >= uint(batch) || gid.y >= uint(hidden)) return;
    int tok = int(gid.x);
    int h = int(gid.y);
    int x_base = tok * hidden;
    float acc = 0.0f; // accumulates this (tok,h) output across all routed pairs
    for (int p = 0; p < num_pairs; ++p) {
        if (int(router_tokens[p]) != tok) continue;
        int exp_id = int(router_experts[p]);
        float weight = router_weights[p];
        int gw_base = exp_id * inter * hidden;
        int uw_base = exp_id * inter * hidden;
        int dw_base = exp_id * hidden * inter;
        // Gate/up project hidden -> inter. `i` is the inter (expert-inner) index.
        float down = 0.0f;
        for (int i = 0; i < inter; ++i) {
            float g = 0.0f, u = 0.0f;
            for (int j = 0; j < hidden; ++j) {
                float xv = x[x_base + j];
                g += gate_w[gw_base + i * hidden + j] * xv;
                u += up_w[uw_base + i * hidden + j] * xv;
            }
            float a = g / (1.0f + exp(-g)) * u; // silu(g) * u
            down += down_w[dw_base + h * inter + i] * a;
        }
        acc += rsf * weight * down;
    }
    out[tok * hidden + h] = acc;
}

// ---------------------------------------------------------------------------
// DeepSeek MLA Matrix-Absorbed Decode Kernel
// ---------------------------------------------------------------------------
kernel void grim_mla_decode(
    device const float* q_absorbed [[buffer(0)]], // [num_heads, kv_lora_rank]
    device const float* q_rope [[buffer(1)]],     // [num_heads, qk_rope_dim]
    device const float* kv_cache [[buffer(2)]],   // [seq_len, kv_lora_rank + qk_rope_dim]
    device float* out [[buffer(3)]],              // [num_heads, kv_lora_rank]
    constant int& num_heads [[buffer(4)]],
    constant int& kv_lora_rank [[buffer(5)]],
    constant int& qk_rope_dim [[buffer(6)]],
    constant int& seq_len [[buffer(7)]],
    constant float& inv_sqrt_d [[buffer(8)]],
    uint h [[threadgroup_position_in_grid]],
    uint tid [[thread_position_in_threadgroup]],
    uint bdim [[threads_per_threadgroup]]
) {
    if (int(h) >= num_heads) return;

    int total_kv_dim = kv_lora_rank + qk_rope_dim;
    int q_c_base = int(h) * kv_lora_rank;
    int q_r_base = int(h) * qk_rope_dim;

    threadgroup float s_scores[4096];

    for (int j = 0; j < seq_len; ++j) {
        int token_base = j * total_kv_dim;
        float dot = 0.0f;

        for (int d = int(tid); d < kv_lora_rank; d += int(bdim)) {
            dot += q_absorbed[q_c_base + d] * kv_cache[token_base + d];
        }
        for (int d = int(tid); d < qk_rope_dim; d += int(bdim)) {
            dot += q_rope[q_r_base + d] * kv_cache[token_base + kv_lora_rank + d];
        }

        dot = simd_sum(dot);
        if (tid == 0) {
            s_scores[j] = dot * inv_sqrt_d;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    if (tid == 0) {
        float m = -1e20f;
        for (int j = 0; j < seq_len; ++j) {
            if (s_scores[j] > m) m = s_scores[j];
        }
        float sum_exp = 0.0f;
        for (int j = 0; j < seq_len; ++j) {
            s_scores[j] = exp(s_scores[j] - m);
            sum_exp += s_scores[j];
        }
        float inv_sum = 1.0f / max(sum_exp, 1e-8f);
        for (int j = 0; j < seq_len; ++j) {
            s_scores[j] *= inv_sum;
        }
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    int out_base = int(h) * kv_lora_rank;
    for (int d = int(tid); d < kv_lora_rank; d += int(bdim)) {
        float acc = 0.0f;
        for (int j = 0; j < seq_len; ++j) {
            int token_base = j * total_kv_dim;
            acc += s_scores[j] * kv_cache[token_base + d];
        }
        out[out_base + d] = acc;
    }
}

// ---------------------------------------------------------------------------
// Block-Quantized SageAttention Kernel
// ---------------------------------------------------------------------------
kernel void grim_sage_attention(
    device const float* q_in [[buffer(0)]],
    device const float* k_in [[buffer(1)]],
    device const float* v_in [[buffer(2)]],
    device float* out [[buffer(3)]],
    constant int& num_heads [[buffer(4)]],
    constant int& num_kv_heads [[buffer(5)]],
    constant int& head_dim [[buffer(6)]],
    constant int& kv_seq_len [[buffer(7)]],
    constant float& scale [[buffer(8)]],
    uint h [[threadgroup_position_in_grid]],
    uint tid [[thread_position_in_threadgroup]],
    uint bdim [[threads_per_threadgroup]]
) {
    if (int(h) >= num_heads) return;

    int gqa_ratio = num_heads / max(num_kv_heads, 1);
    int kv_h = int(h) / max(gqa_ratio, 1);
    int q_base = int(h) * head_dim;

    threadgroup float s_scores[4096];

    for (int j = 0; j < kv_seq_len; ++j) {
        int k_base = (j * num_kv_heads + kv_h) * head_dim;
        float dot = 0.0f;
        for (int d = int(tid); d < head_dim; d += int(bdim)) {
            dot += q_in[q_base + d] * k_in[k_base + d];
        }
        dot = simd_sum(dot);
        if (tid == 0) {
            s_scores[j] = dot * scale;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    if (tid == 0) {
        float max_s = -1e20f;
        for (int j = 0; j < kv_seq_len; ++j) {
            if (s_scores[j] > max_s) max_s = s_scores[j];
        }
        float sum_e = 0.0f;
        for (int j = 0; j < kv_seq_len; ++j) {
            s_scores[j] = exp(s_scores[j] - max_s);
            sum_e += s_scores[j];
        }
        float inv_sum = 1.0f / max(sum_e, 1e-8f);
        for (int j = 0; j < kv_seq_len; ++j) {
            s_scores[j] *= inv_sum;
        }
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    int out_base = int(h) * head_dim;
    for (int d = int(tid); d < head_dim; d += int(bdim)) {
        float acc = 0.0f;
        for (int j = 0; j < kv_seq_len; ++j) {
            int v_base = (j * num_kv_heads + kv_h) * head_dim;
            acc += s_scores[j] * v_in[v_base + d];
        }
        out[out_base + d] = acc;
    }
}

// ---------------------------------------------------------------------------
// Multimodal 3D Rotary Position Embedding (M-RoPE)
// ---------------------------------------------------------------------------
kernel void grim_mrope(
    device float* q [[buffer(0)]],
    device float* k [[buffer(1)]],
    device const int* positions [[buffer(2)]],
    constant int& num_tokens [[buffer(3)]],
    constant int& num_q_heads [[buffer(4)]],
    constant int& num_k_heads [[buffer(5)]],
    constant int& head_dim [[buffer(6)]],
    constant int& rotary_dim [[buffer(7)]],
    constant int& section_t [[buffer(8)]],
    constant int& section_h [[buffer(9)]],
    constant int& section_w [[buffer(10)]],
    constant float& rope_theta [[buffer(11)]],
    uint2 gid [[threadgroup_position_in_grid]],
    uint pair_idx [[thread_position_in_threadgroup]]
) {
    int t = int(gid.x);
    int head_idx = int(gid.y);

    int total_heads = num_q_heads + num_k_heads;
    if (t >= num_tokens || head_idx >= total_heads || int(pair_idx) >= (rotary_dim / 2)) return;

    bool is_q = (head_idx < num_q_heads);
    int local_head = is_q ? head_idx : (head_idx - num_q_heads);

    int pos_t = positions[t * 3 + 0];
    int pos_h = positions[t * 3 + 1];
    int pos_w = positions[t * 3 + 2];

    int pos = pos_t;
    if (int(pair_idx) >= section_t && int(pair_idx) < (section_t + section_h)) {
        pos = pos_h;
    } else if (int(pair_idx) >= (section_t + section_h)) {
        pos = pos_w;
    }

    float freq = 1.0f / pow(rope_theta, (2.0f * float(pair_idx)) / float(rotary_dim));
    float angle = float(pos) * freq;
    float cos_val = cos(angle);
    float sin_val = sin(angle);

    int idx0 = 2 * int(pair_idx);
    int idx1 = 2 * int(pair_idx) + 1;

    if (is_q) {
        int base = (t * num_q_heads + local_head) * head_dim;
        float x0 = q[base + idx0];
        float x1 = q[base + idx1];
        q[base + idx0] = x0 * cos_val - x1 * sin_val;
        q[base + idx1] = x0 * sin_val + x1 * cos_val;
    } else {
        int base = (t * num_k_heads + local_head) * head_dim;
        float x0 = k[base + idx0];
        float x1 = k[base + idx1];
        k[base + idx0] = x0 * cos_val - x1 * sin_val;
        k[base + idx1] = x0 * sin_val + x1 * cos_val;
    }
}

// ---------------------------------------------------------------------------
// Marlin 4-bit Fast GEMM Kernel
// ---------------------------------------------------------------------------
kernel void grim_marlin_gemm(
    device const float* a [[buffer(0)]],
    device const uint* b_packed [[buffer(1)]],
    device const float* scales [[buffer(2)]],
    device float* c [[buffer(3)]],
    constant int& m [[buffer(4)]],
    constant int& n [[buffer(5)]],
    constant int& k [[buffer(6)]],
    constant int& group_size [[buffer(7)]],
    uint2 gid [[thread_position_in_grid]]
) {
    int row = int(gid.y);
    int col = int(gid.x);

    if (row >= m || col >= n) return;

    float acc = 0.0f;
    int num_packed_k = k / 8;

    for (int pk = 0; pk < num_packed_k; ++pk) {
        int k_start = pk * 8;
        int scale_idx = (k_start / max(group_size, 1)) * n + col;
        float s = scales[scale_idx];

        uint packed_val = b_packed[pk * n + col];

        for (int ki = 0; ki < 8; ++ki) {
            int k_curr = k_start + ki;
            int q_val = int((packed_val >> (ki * 4)) & 0x0F) - 8;
            float w_val = float(q_val) * s;
            acc += a[row * k + k_curr] * w_val;
        }
    }

    c[row * n + col] = acc;
}

// ---------------------------------------------------------------------------
// On-Device Fused Linear Cross-Entropy Loss
// ---------------------------------------------------------------------------
kernel void grim_fused_linear_ce(
    device const float* hidden [[buffer(0)]],
    device const float* lm_head [[buffer(1)]],
    device const uint* targets [[buffer(2)]],
    device float* loss_out [[buffer(3)]],
    device float* lse_out [[buffer(4)]],
    constant int& batch [[buffer(5)]],
    constant int& hidden_dim [[buffer(6)]],
    constant int& vocab_size [[buffer(7)]],
    uint row [[threadgroup_position_in_grid]],
    uint tid [[thread_position_in_threadgroup]],
    uint bdim [[threads_per_threadgroup]]
) {
    if (int(row) >= batch) return;

    uint target = targets[row];
    float local_max = -1e20f;
    float local_sum = 0.0f;
    float target_l = 0.0f;
    bool is_target = false;

    for (int v = int(tid); v < vocab_size; v += int(bdim)) {
        float logit = 0.0f;
        int w_base = v * hidden_dim;
        int h_base = int(row) * hidden_dim;

        for (int d = 0; d < hidden_dim; ++d) {
            logit += hidden[h_base + d] * lm_head[w_base + d];
        }

        if (uint(v) == target) {
            target_l = logit;
            is_target = true;
        }

        if (logit > local_max) {
            local_sum = local_sum * exp(local_max - logit) + 1.0f;
            local_max = logit;
        } else {
            local_sum += exp(logit - local_max);
        }
    }

    threadgroup float s_max;
    threadgroup float s_target;
    threadgroup float s_sum;

    if (tid == 0) {
        s_max = -1e20f;
        s_target = 0.0f;
        s_sum = 0.0f;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (is_target) {
        s_target = target_l;
    }

    float global_m = simd_max(local_max);
    if (tid == 0) {
        s_max = global_m;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    float scaled_sum = local_sum * exp(local_max - s_max);
    float global_s = simd_sum(scaled_sum);
    if (tid == 0) {
        s_sum = global_s;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (tid == 0) {
        float lse = s_max + log(max(s_sum, 1e-8f));
        loss_out[row] = lse - s_target;
        lse_out[row] = lse;
    }
}

// ---------------------------------------------------------------------------
// On-Device Fused Linear Cross-Entropy Backward Pass
// ---------------------------------------------------------------------------
kernel void grim_fused_linear_ce_backward(
    device const float* hidden [[buffer(0)]],
    device const float* lm_head [[buffer(1)]],
    device const uint* targets [[buffer(2)]],
    device const float* lse [[buffer(3)]],
    device float* grad_h [[buffer(4)]],
    constant int& hidden_dim [[buffer(5)]],
    constant int& vocab_size [[buffer(6)]],
    constant int& v_tile_size [[buffer(7)]],
    constant float& inv_batch [[buffer(8)]],
    constant int& batch [[buffer(9)]],
    uint row [[thread_position_in_grid]]
) {
    if (int(row) >= batch) return;

    int tid = thread_position_in_threadgroup;
    int bdim = threads_per_threadgroup;
    int target = targets[row];
    float lse_row = lse[row];

    for (int d = tid; d < int(hidden_dim); d += int(bdim)) {
        grad_h[row * hidden_dim + d] = 0.0f;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    for (int v = 0; v < int(vocab_size); ++v) {
        float logit = 0.0f;
        int h_base = int(row) * hidden_dim;
        int w_base = v * hidden_dim;
        for (int d = 0; d < int(hidden_dim); ++d) {
            logit += hidden[h_base + d] * lm_head[w_base + d];
        }
        float dl = (exp(logit - lse_row) - (v == target ? 1.0f : 0.0f)) * inv_batch;
        for (int d = tid; d < int(hidden_dim); d += int(bdim)) {
            atomic_add(&grad_h[row * hidden_dim + d], dl * lm_head[w_base + d]);
        }
    }
}

// ---------------------------------------------------------------------------
// On-Device Fused AdamW & Lion Optimizers
// ---------------------------------------------------------------------------
kernel void grim_fused_adamw(
    device float* p [[buffer(0)]],
    device const float* g [[buffer(1)]],
    device float* m [[buffer(2)]],
    device float* v [[buffer(3)]],
    constant int& total [[buffer(4)]],
    constant float& lr [[buffer(5)]],
    constant float& beta1 [[buffer(6)]],
    constant float& beta2 [[buffer(7)]],
    constant float& eps [[buffer(8)]],
    constant float& weight_decay [[buffer(9)]],
    constant float& bc1 [[buffer(10)]],
    constant float& bc2 [[buffer(11)]],
    uint idx [[thread_position_in_grid]]
) {
    if (int(idx) >= total) return;

    float grad = g[idx];
    float param = p[idx];

    if (weight_decay != 0.0f) {
        param -= lr * weight_decay * param;
    }

    float m_val = beta1 * m[idx] + (1.0f - beta1) * grad;
    float v_val = beta2 * v[idx] + (1.0f - beta2) * grad * grad;

    m[idx] = m_val;
    v[idx] = v_val;

    float m_hat = m_val / max(bc1, 1e-7f);
    float v_hat = v_val / max(bc2, 1e-7f);

    param -= lr * m_hat / (sqrt(v_hat) + eps);
    p[idx] = param;
}

kernel void grim_fused_lion(
    device float* p [[buffer(0)]],
    device const float* g [[buffer(1)]],
    device float* exp_avg [[buffer(2)]],
    constant int& total [[buffer(3)]],
    constant float& lr [[buffer(4)]],
    constant float& beta1 [[buffer(5)]],
    constant float& beta2 [[buffer(6)]],
    constant float& weight_decay [[buffer(7)]],
    uint idx [[thread_position_in_grid]]
) {
    if (int(idx) >= total) return;

    float grad = g[idx];
    float param = p[idx];
    float m = exp_avg[idx];

    if (weight_decay != 0.0f) {
        param -= lr * weight_decay * param;
    }

    float c = beta1 * m + (1.0f - beta1) * grad;
    float update = (c > 0.0f) ? 1.0f : ((c < 0.0f) ? -1.0f : 0.0f);

    param -= lr * update;
    p[idx] = param;

    exp_avg[idx] = beta2 * m + (1.0f - beta2) * grad;
}

// ---------------------------------------------------------------------------
// FlashDecode Split-K Attention & Softmax Merge
// ---------------------------------------------------------------------------
kernel void grim_flash_decode_split_k(
    device const float* q_in [[buffer(0)]],
    device const float* k_in [[buffer(1)]],
    device const float* v_in [[buffer(2)]],
    device float* v_partial [[buffer(3)]],
    device float* m_partial [[buffer(4)]],
    device float* l_partial [[buffer(5)]],
    constant int& num_heads [[buffer(6)]],
    constant int& num_kv_heads [[buffer(7)]],
    constant int& head_dim [[buffer(8)]],
    constant int& kv_seq_len [[buffer(9)]],
    constant int& num_splits [[buffer(10)]],
    constant float& scale [[buffer(11)]],
    uint2 gid [[threadgroup_position_in_grid]],
    uint tid [[thread_position_in_threadgroup]],
    uint bdim [[threads_per_threadgroup]]
) {
    int h = int(gid.x);
    int split_idx = int(gid.y);

    if (h >= num_heads || split_idx >= num_splits) return;

    int gqa_ratio = num_heads / max(num_kv_heads, 1);
    int kv_h = h / max(gqa_ratio, 1);

    int chunk_len = (kv_seq_len + num_splits - 1) / num_splits;
    int start_pos = split_idx * chunk_len;
    int end_pos = min(start_pos + chunk_len, kv_seq_len);

    if (start_pos >= end_pos) {
        if (tid == 0) {
            int split_offset = h * num_splits + split_idx;
            m_partial[split_offset] = -1e20f;
            l_partial[split_offset] = 0.0f;
        }
        for (int d = int(tid); d < head_dim; d += int(bdim)) {
            v_partial[(h * num_splits + split_idx) * head_dim + d] = 0.0f;
        }
        return;
    }

    int local_len = end_pos - start_pos;
    int q_base = h * head_dim;

    threadgroup float s_scores[2048];

    for (int i = 0; i < local_len; ++i) {
        int pos = start_pos + i;
        int k_base = (pos * num_kv_heads + kv_h) * head_dim;
        float dot = 0.0f;
        for (int d = int(tid); d < head_dim; d += int(bdim)) {
            dot += q_in[q_base + d] * k_in[k_base + d];
        }
        dot = simd_sum(dot);
        if (tid == 0) {
            s_scores[i] = dot * scale;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    if (tid == 0) {
        float local_max = -1e20f;
        for (int i = 0; i < local_len; ++i) {
            if (s_scores[i] > local_max) local_max = s_scores[i];
        }
        float local_sum = 0.0f;
        for (int i = 0; i < local_len; ++i) {
            s_scores[i] = exp(s_scores[i] - local_max);
            local_sum += s_scores[i];
        }
        int split_offset = h * num_splits + split_idx;
        m_partial[split_offset] = local_max;
        l_partial[split_offset] = local_sum;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    int out_base = (h * num_splits + split_idx) * head_dim;
    for (int d = int(tid); d < head_dim; d += int(bdim)) {
        float acc = 0.0f;
        for (int i = 0; i < local_len; ++i) {
            int pos = start_pos + i;
            int v_base = (pos * num_kv_heads + kv_h) * head_dim;
            acc += s_scores[i] * v_in[v_base + d];
        }
        v_partial[out_base + d] = acc;
    }
}

kernel void grim_softmax_merge(
    device const float* v_partial [[buffer(0)]],
    device const float* m_partial [[buffer(1)]],
    device const float* l_partial [[buffer(2)]],
    device float* out [[buffer(3)]],
    constant int& num_heads [[buffer(4)]],
    constant int& num_splits [[buffer(5)]],
    constant int& head_dim [[buffer(6)]],
    uint h [[threadgroup_position_in_grid]],
    uint tid [[thread_position_in_threadgroup]],
    uint bdim [[threads_per_threadgroup]]
) {
    if (int(h) >= num_heads) return;

    threadgroup float s_global_max;
    threadgroup float s_global_sum;
    threadgroup float s_weights[64];

    if (tid == 0) {
        float m_max = -1e20f;
        for (int s = 0; s < num_splits; ++s) {
            float m = m_partial[int(h) * num_splits + s];
            if (m > m_max) m_max = m;
        }
        s_global_max = m_max;

        float total_l = 0.0f;
        for (int s = 0; s < num_splits; ++s) {
            float m = m_partial[int(h) * num_splits + s];
            float l = l_partial[int(h) * num_splits + s];
            float w = l * exp(m - m_max);
            s_weights[s] = w;
            total_l += w;
        }
        s_global_sum = max(total_l, 1e-8f);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    float inv_sum = 1.0f / s_global_sum;
    int out_base = int(h) * head_dim;

    for (int d = int(tid); d < head_dim; d += int(bdim)) {
        float final_v = 0.0f;
        for (int s = 0; s < num_splits; ++s) {
            float v_val = v_partial[(int(h) * num_splits + s) * head_dim + d];
            float m = m_partial[int(h) * num_splits + s];
            float exp_scale = exp(m - s_global_max);
            final_v += v_val * exp_scale;
        }
        out[out_base + d] = final_v * inv_sum;
    }
}

// ---------------------------------------------------------------------------
// Paged Quantized KV Attention
// ---------------------------------------------------------------------------
kernel void grim_qkv_attention_paged_dequant(
    device const float* q_in [[buffer(0)]],
    device const uint* block_table [[buffer(1)]],
    device const char* k_pages_int8 [[buffer(2)]],
    device const float* k_scales [[buffer(3)]],
    device const char* v_pages_int8 [[buffer(4)]],
    device const float* v_scales [[buffer(5)]],
    device float* out [[buffer(6)]],
    constant int& num_heads [[buffer(7)]],
    constant int& num_kv_heads [[buffer(8)]],
    constant int& head_dim [[buffer(9)]],
    constant int& kv_seq_len [[buffer(10)]],
    constant int& page_size [[buffer(11)]],
    constant float& scale [[buffer(12)]],
    uint h [[threadgroup_position_in_grid]],
    uint tid [[thread_position_in_threadgroup]],
    uint bdim [[threads_per_threadgroup]]
) {
    if (int(h) >= num_heads) return;

    int gqa_ratio = num_heads / max(num_kv_heads, 1);
    int kv_h = int(h) / max(gqa_ratio, 1);
    int q_base = int(h) * head_dim;

    threadgroup float s_scores[4096];

    for (int j = 0; j < kv_seq_len; ++j) {
        int block_idx = j / page_size;
        int page_offset = j % page_size;
        uint phys_block = block_table[block_idx];

        int k_entry = (int(phys_block) * page_size + page_offset) * (num_kv_heads * head_dim) + kv_h * head_dim;
        int scale_entry = (int(phys_block) * page_size + page_offset) * num_kv_heads + kv_h;
        float ks = k_scales[scale_entry];

        float dot = 0.0f;
        for (int d = int(tid); d < head_dim; d += int(bdim)) {
            float k_val = float(k_pages_int8[k_entry + d]) * ks;
            dot += q_in[q_base + d] * k_val;
        }

        dot = simd_sum(dot);
        if (tid == 0) {
            s_scores[j] = dot * scale;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    if (tid == 0) {
        float max_s = -1e20f;
        for (int j = 0; j < kv_seq_len; ++j) {
            if (s_scores[j] > max_s) max_s = s_scores[j];
        }
        float sum_e = 0.0f;
        for (int j = 0; j < kv_seq_len; ++j) {
            s_scores[j] = exp(s_scores[j] - max_s);
            sum_e += s_scores[j];
        }
        float inv_sum = 1.0f / max(sum_e, 1e-8f);
        for (int j = 0; j < kv_seq_len; ++j) {
            s_scores[j] *= inv_sum;
        }
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    int out_base = int(h) * head_dim;
    for (int d = int(tid); d < head_dim; d += int(bdim)) {
        float acc = 0.0f;
        for (int j = 0; j < kv_seq_len; ++j) {
            int block_idx = j / page_size;
            int page_offset = j % page_size;
            uint phys_block = block_table[block_idx];

            int v_entry = (int(phys_block) * page_size + page_offset) * (num_kv_heads * head_dim) + kv_h * head_dim;
            int scale_entry = (int(phys_block) * page_size + page_offset) * num_kv_heads + kv_h;
            float vs = v_scales[scale_entry];

            float v_val = float(v_pages_int8[v_entry + d]) * vs;
            acc += s_scores[j] * v_val;
        }
        out[out_base + d] = acc;
    }
}

// ---------------------------------------------------------------------------
// GPU Speculative Token Acceptor
// ---------------------------------------------------------------------------
kernel void grim_speculative_acceptor(
    device const float* target_probs [[buffer(0)]],
    device const float* draft_probs [[buffer(1)]],
    device const int* draft_tokens [[buffer(2)]],
    device const float* uniform_rands [[buffer(3)]],
    device int* accepted_tokens [[buffer(4)]],
    device int* accepted_lens [[buffer(5)]],
    constant int& batch_size [[buffer(6)]],
    constant int& num_draft_tokens [[buffer(7)]],
    constant int& vocab_size [[buffer(8)]],
    uint b [[threadgroup_position_in_grid]],
    uint tid [[thread_position_in_threadgroup]]
) {
    if (int(b) >= batch_size) return;

    if (tid == 0) {
        int accepted_count = 0;
        for (int k = 0; k < num_draft_tokens; ++k) {
            int draft_tok = draft_tokens[int(b) * num_draft_tokens + k];
            if (draft_tok < 0 || draft_tok >= vocab_size) {
                break;
            }

            int t_idx = (int(b) * (num_draft_tokens + 1) + k) * vocab_size + draft_tok;
            int d_idx = (int(b) * num_draft_tokens + k) * vocab_size + draft_tok;

            float p = target_probs[t_idx];
            float q = draft_probs[d_idx];
            float r = uniform_rands[int(b) * (num_draft_tokens + 1) + k];

            float accept_prob = (q > 0.0f) ? min(1.0f, p / q) : 1.0f;

            if (r <= accept_prob) {
                accepted_tokens[int(b) * (num_draft_tokens + 1) + accepted_count] = draft_tok;
                accepted_count++;
            } else {
                break;
            }
        }
        accepted_lens[b] = accepted_count;
    }
}

// ---------------------------------------------------------------------------
// SIMDgroup Matrix GEMM (Apple AMX / SIMD-matrix hardware acceleration)
// ---------------------------------------------------------------------------
#if defined(__METAL_VERSION__) && (__METAL_VERSION__ >= 230)
kernel void grim_matmul_simdgroup(
    device const half* a [[buffer(0)]],
    device const half* b [[buffer(1)]],
    device half* c [[buffer(2)]],
    constant int& m [[buffer(3)]],
    constant int& n [[buffer(4)]],
    constant int& k [[buffer(5)]],
    uint2 tg_id [[threadgroup_position_in_grid]],
    uint simd_lane [[thread_index_in_simdgroup]],
    uint simd_group_id [[simdgroup_index_in_threadgroup]]
) {
    simdgroup_half8x8 sg_a;
    simdgroup_half8x8 sg_b;
    simdgroup_half8x8 sg_c = make_filled_simdgroup_matrix<half, 8, 8>(0.0h);

    int row_start = (int(tg_id.y) * 4 + int(simd_group_id)) * 8;
    int col_start = int(tg_id.x) * 8;

    if (row_start >= m || col_start >= n) return;

    for (int bk = 0; bk < k; bk += 8) {
        simdgroup_load(sg_a, a + row_start * k + bk, k);
        simdgroup_load(sg_b, b + bk * n + col_start, n);
        simdgroup_multiply_accumulate(sg_c, sg_a, sg_b, sg_c);
    }

    simdgroup_store(sg_c, c + row_start * n + col_start, n);
}
#endif

// ---------------------------------------------------------------------------
// Fused Dequant GEMM with SIMDgroup dot-product acceleration
// ---------------------------------------------------------------------------
kernel void grim_fused_dequant_gemm_q8_0(
    device const float* a [[buffer(0)]],
    device const uchar* b_q [[buffer(1)]],
    device const float* b_scales [[buffer(2)]],
    device float* c [[buffer(3)]],
    constant int& m [[buffer(4)]],
    constant int& n [[buffer(5)]],
    constant int& k [[buffer(6)]],
    uint2 gid [[thread_position_in_grid]]
) {
    int row = int(gid.y);
    int col = int(gid.x);

    if (row >= m || col >= n) return;

    float acc = 0.0f;
    int num_blocks = k / 32;

    for (int b = 0; b < num_blocks; ++b) {
        float scale = b_scales[col * num_blocks + b];
        int b_base = (col * num_blocks + b) * 32;
        int a_base = row * k + b * 32;

        for (int i = 0; i < 32; ++i) {
            char q = (char)b_q[b_base + i];
            acc += a[a_base + i] * (float(q) * scale);
        }
    }

    c[row * n + col] = acc;
}

// Q4_K Fused Dequant GEMM (Superblock 144 bytes / 256 weights)
kernel void grim_fused_dequant_gemm_q4k(
    device const float* a [[buffer(0)]],
    device const uchar* b_packed [[buffer(1)]],
    device float* c [[buffer(2)]],
    constant int& m [[buffer(3)]],
    constant int& n [[buffer(4)]],
    constant int& k [[buffer(5)]],
    uint2 gid [[thread_position_in_grid]]
) {
    int row = int(gid.y);
    int col = int(gid.x);

    if (row >= m || col >= n) return;

    float acc = 0.0f;
    int num_sb = k / 256;
    int col_sb_base = col * num_sb;

    for (int sb = 0; sb < num_sb; ++sb) {
        device const uchar* block_ptr = b_packed + (col_sb_base + sb) * 144;
        device const ushort* h_ptr = (device const ushort*)block_ptr;
        float d = metal_fp16_to_float(h_ptr[0]);
        float dmin = metal_fp16_to_float(h_ptr[1]);

        device const uchar* scales = block_ptr + 4;
        device const uchar* qs = block_ptr + 16;
        int a_sb_base = row * k + sb * 256;

        for (int is = 0; is < 8; ++is) {
            uchar sc, mins;
            if (is < 4) {
                sc   = scales[is] & 63;
                mins = scales[is + 4] & 63;
            } else {
                sc   = (scales[is + 4] & 0xF) | ((scales[is - 4] >> 6) << 4);
                mins = (scales[is + 4] >> 4)  | ((scales[is] >> 6) << 4);
            }
            float d_sc = d * float(sc);
            float dmin_m = dmin * float(mins);

            int a_chunk_base = a_sb_base + is * 32;
            int q_offset = is * 16;

            for (int il = 0; il < 16; ++il) {
                uchar q_byte = qs[q_offset + il];
                uchar q0 = q_byte & 0x0F;
                uchar q1 = q_byte >> 4;

                float w0 = d_sc * float(q0) - dmin_m;
                float w1 = d_sc * float(q1) - dmin_m;

                acc += a[a_chunk_base + il] * w0;
                acc += a[a_chunk_base + il + 16] * w1;
            }
        }
    }

    c[row * n + col] = acc;
}

// FP8 Fused Dequant GEMM (E4M3)
kernel void grim_fused_dequant_gemm_fp8(
    device const float* a [[buffer(0)]],
    device const uchar* b_packed [[buffer(1)]],
    device float* c [[buffer(2)]],
    constant int& m [[buffer(3)]],
    constant int& n [[buffer(4)]],
    constant int& k [[buffer(5)]],
    uint2 gid [[thread_position_in_grid]]
) {
    int row = int(gid.y);
    int col = int(gid.x);

    if (row >= m || col >= n) return;

    float acc = 0.0f;
    int a_base = row * k;
    int b_base = col * k;

    for (int i = 0; i < k; ++i) {
        float w = metal_fp8_e4m3_to_float(b_packed[b_base + i]);
        acc += a[a_base + i] * w;
    }

    c[row * n + col] = acc;
}

kernel void grim_sub(
    device const float* a [[buffer(0)]],
    device const float* b [[buffer(1)]],
    device float* c [[buffer(2)]],
    constant int& n [[buffer(3)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n)) {
        c[id] = a[id] - b[id];
    }
}

kernel void grim_reduce_sum(
    device const float* in [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n [[buffer(2)]],
    uint tid [[thread_position_in_threadgroup]],
    uint bid [[threadgroup_position_in_grid]],
    uint bdim [[threads_per_threadgroup]]
) {
    threadgroup float sdata[256];
    uint global_idx = bid * bdim + tid;
    float my_val = (global_idx < uint(n)) ? in[global_idx] : 0.0f;
    sdata[tid] = my_val;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    for (uint s = bdim / 2; s > 0; s >>= 1) {
        if (tid < s) {
            sdata[tid] += sdata[tid + s];
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    if (tid == 0) {
        out[bid] = sdata[0];
    }
}

kernel void grim_reduce_max(
    device const float* in [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n [[buffer(2)]],
    uint tid [[thread_position_in_threadgroup]],
    uint bid [[threadgroup_position_in_grid]],
    uint bdim [[threads_per_threadgroup]]
) {
    threadgroup float sdata[256];
    uint global_idx = bid * bdim + tid;
    float my_val = (global_idx < uint(n)) ? in[global_idx] : -1e30f;
    sdata[tid] = my_val;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    for (uint s = bdim / 2; s > 0; s >>= 1) {
        if (tid < s) {
            sdata[tid] = max(sdata[tid], sdata[tid + s]);
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    if (tid == 0) {
        out[bid] = sdata[0];
    }
}

kernel void grim_argmax(
    device const float* in [[buffer(0)]],
    device uint* out_idx [[buffer(1)]],
    constant int& n [[buffer(2)]],
    uint tid [[thread_position_in_threadgroup]],
    uint bid [[threadgroup_position_in_grid]],
    uint bdim [[threads_per_threadgroup]]
) {
    threadgroup float s_val[256];
    threadgroup uint s_idx[256];
    uint global_idx = bid * bdim + tid;

    if (global_idx < uint(n)) {
        s_val[tid] = in[global_idx];
        s_idx[tid] = global_idx;
    } else {
        s_val[tid] = -1e30f;
        s_idx[tid] = 0;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    for (uint s = bdim / 2; s > 0; s >>= 1) {
        if (tid < s) {
            if (s_val[tid + s] > s_val[tid] || (s_val[tid + s] == s_val[tid] && s_idx[tid + s] > s_idx[tid])) {
                s_val[tid] = s_val[tid + s];
                s_idx[tid] = s_idx[tid + s];
            }
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    if (tid == 0) {
        out_idx[bid] = s_idx[0];
    }
}
