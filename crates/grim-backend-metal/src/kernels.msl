#include <metal_stdlib>
using namespace metal;

kernel void grim_add(
    device const float* a [[buffer(0)]],
    device const float* b [[buffer(1)]],
    device float* c [[buffer(2)]],
    constant int& n [[buffer(3)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n)) {
        c[id] = a[id] + b[id];
    }
}

kernel void grim_mul(
    device const float* a [[buffer(0)]],
    device const float* b [[buffer(1)]],
    device float* c [[buffer(2)]],
    constant int& n [[buffer(3)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n)) {
        c[id] = a[id] * b[id];
    }
}

kernel void grim_silu_mul(
    device const float* gate [[buffer(0)]],
    device const float* up [[buffer(1)]],
    device float* out [[buffer(2)]],
    constant int& n [[buffer(3)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n)) {
        float g = gate[id];
        float s = g / (1.0f + exp(-g));
        out[id] = s * up[id];
    }
}

kernel void grim_silu_mul_backward(
    device const float* e [[buffer(0)]],
    device const float* g [[buffer(1)]],
    device const float* dw [[buffer(2)]],
    device float* df [[buffer(3)]],
    device float* de [[buffer(4)]],
    constant int& n [[buffer(5)]],
    uint id [[thread_position_in_grid]]) {
    if (id < uint(n)) {
        float e_val = e[id];
        float g_val = g[id];
        float dw_val = dw[id];
        float s = 1.0f / (1.0f + exp(-e_val));
        float silu = s * e_val;
        float dsilu = s * (1.0f + e_val * (1.0f - s));
        df[id] = dw_val * g_val * dsilu;
        de[id] = dw_val * silu;
    }
}

kernel void grim_rms_norm(
    device const float* x [[buffer(0)]],
    device const float* w [[buffer(1)]],
    device float* out [[buffer(2)]],
    constant int& row_len [[buffer(3)]],
    constant float& eps [[buffer(4)]],
    constant int& total [[buffer(5)]],
    uint idx [[thread_position_in_grid]]
) {
    if (idx < uint(total)) {
        int row = idx / row_len;
        int col = idx % row_len;

        float ss = 0.0f;
        for (int j = 0; j < row_len; ++j) {
            float val = x[row * row_len + j];
            ss += val * val;
        }
        float rms = sqrt(ss / (float)row_len + eps);
        out[idx] = x[idx] * w[col] / rms;
    }
}

kernel void grim_add_rms_norm(
    device const float* x [[buffer(0)]],
    device const float* residual [[buffer(1)]],
    device const float* w [[buffer(2)]],
    device float* y_out [[buffer(3)]],
    device float* norm_out [[buffer(4)]],
    constant int& row_len [[buffer(5)]],
    constant float& eps [[buffer(6)]],
    constant int& total [[buffer(7)]],
    uint idx [[thread_position_in_grid]]
) {
    if (idx < uint(total)) {
        int row = idx / row_len;
        int col = idx % row_len;

        float y_val = x[idx] + residual[idx];
        y_out[idx] = y_val;

        float ss = 0.0f;
        for (int j = 0; j < row_len; ++j) {
            float v = x[row * row_len + j] + residual[row * row_len + j];
            ss += v * v;
        }
        float rms = sqrt(ss / (float)row_len + eps);
        norm_out[idx] = y_val * w[col] / rms;
    }
}

// Convert float to FP8 E4M3 byte in MSL
static inline uchar float_to_fp8_e4m3_msl(float val) {
    if (isnan(val)) return 0x7Fu;
    float abs_val = abs(val);
    uchar sign = (val < 0.0f) ? 0x80u : 0x00u;
    if (abs_val > 448.0f) abs_val = 448.0f;
    if (abs_val < 0.001953125f) { // 2^-9
        uint mant = uint(round(abs_val * 512.0f));
        if (mant > 7u) mant = 7u;
        return sign | uchar(mant);
    }
    uint u = as_type<uint>(abs_val);
    int e = int((u >> 23u) & 0xFFu) - 127;
    uint m = u & 0x7FFFFFu;
    int e_fp8 = e + 7;
    if (e_fp8 >= 15) return sign | 0x7Eu;
    if (e_fp8 <= 0) {
        uint mant = uint(round(abs_val * 512.0f));
        if (mant > 7u) mant = 7u;
        return sign | uchar(mant);
    }
    uint mant_bits = (m >> 20u) & 0x7u;
    return sign | (uchar(e_fp8) << 3u) | uchar(mant_bits);
}

kernel void grim_quant_q8_0(
    device const float* x [[buffer(0)]],
    device uchar* out [[buffer(1)]],
    constant int& total [[buffer(2)]],
    uint tid [[thread_index_in_threadgroup]],
    uint block_idx [[threadgroup_position_in_grid]]
) {
    threadgroup float s_abs[32];

    uint idx = block_idx * 32u + tid;
    float val = (idx < uint(total)) ? x[idx] : 0.0f;
    s_abs[tid] = abs(val);

    threadgroup_barrier(mem_flags::mem_threadgroup);

    for (uint stride = 16u; stride > 0u; stride /= 2u) {
        if (tid < stride) {
            s_abs[tid] = max(s_abs[tid], s_abs[tid + stride]);
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    float amax = s_abs[0];
    float d = amax / 127.0f;
    float id = (d > 0.0f) ? (1.0f / d) : 0.0f;

    device uchar* block_out = out + block_idx * 34u;

    if (tid == 0u) {
        half d_h = half(d);
        ushort scale_bits = as_type<ushort>(d_h);
        block_out[0] = uchar(scale_bits & 0xFFu);
        block_out[1] = uchar((scale_bits >> 8u) & 0xFFu);
    }

    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (idx < uint(total)) {
        int q = int(round(val * id));
        q = clamp(q, -128, 127);
        block_out[2u + tid] = uchar(q & 0xFF);
    }
}

kernel void grim_quant_fp8(
    device const float* x [[buffer(0)]],
    device uchar* out [[buffer(1)]],
    constant int& total [[buffer(2)]],
    uint idx [[thread_position_in_grid]]
) {
    if (idx == 0u) {
        float scale = 1.0f;
        uint scale_bits = as_type<uint>(scale);
        out[0] = uchar(scale_bits & 0xFFu);
        out[1] = uchar((scale_bits >> 8u) & 0xFFu);
        out[2] = uchar((scale_bits >> 16u) & 0xFFu);
        out[3] = uchar((scale_bits >> 24u) & 0xFFu);
    }

    if (idx < uint(total)) {
        out[4u + idx] = float_to_fp8_e4m3_msl(x[idx]);
    }
}

// Helper: Convert float value to 4-bit MXFP4 E2M1 code
static inline uchar float_to_mxfp4_e2m1_code(float val, uchar shared_exp) {
    if (isnan(val)) return 0x0u;
    float scale = pow(2.0f, float(shared_exp) - 127.0f);
    float unscaled = (scale > 0.0f) ? (val / scale) : 0.0f;
    uchar sign = (unscaled < 0.0f) ? 0x8u : 0x0u;
    float abs_val = abs(unscaled);

    uchar code = 0;
    if (abs_val < 0.25f) {
        code = 0;
    } else if (abs_val < 0.75f) {
        code = 1;
    } else if (abs_val < 1.25f) {
        code = 2;
    } else if (abs_val < 1.75f) {
        code = 3;
    } else if (abs_val < 2.5f) {
        code = 4;
    } else if (abs_val < 3.5f) {
        code = 5;
    } else if (abs_val < 5.0f) {
        code = 6;
    } else {
        code = 7;
    }
    return sign | code;
}

kernel void grim_quant_mxfp4(
    device const float* x [[buffer(0)]],
    device uchar* codes [[buffer(1)]],
    device uchar* exps [[buffer(2)]],
    constant int& total [[buffer(3)]],
    uint tid [[thread_index_in_threadgroup]],
    uint group_idx [[threadgroup_position_in_grid]]
) {
    threadgroup float s_abs[32];
    uint idx = group_idx * 32u + tid;
    float val = (idx < uint(total)) ? x[idx] : 0.0f;
    s_abs[tid] = abs(val);
    threadgroup_barrier(mem_flags::mem_threadgroup);

    for (uint stride = 16u; stride > 0u; stride /= 2u) {
        if (tid < stride) {
            s_abs[tid] = max(s_abs[tid], s_abs[tid + stride]);
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    float amax = s_abs[0];
    uchar shared_exp = 0;
    if (amax > 0.0f) {
        int e = int(floor(log2(amax / 6.0f))) + 127;
        e = clamp(e, 0, 255);
        shared_exp = uchar(e);
    }

    if (tid == 0u) {
        exps[group_idx] = shared_exp;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    uchar nib = float_to_mxfp4_e2m1_code(val, shared_exp);
    uint pair_idx = (group_idx * 32u + tid) / 2u;
    if (tid % 2u == 0u) {
        codes[pair_idx] = (codes[pair_idx] & 0xF0u) | (nib & 0x0Fu);
    } else {
        codes[pair_idx] = (codes[pair_idx] & 0x0Fu) | ((nib & 0x0Fu) << 4u);
    }
}

kernel void grim_quant_mxfp8(
    device const float* x [[buffer(0)]],
    device uchar* codes [[buffer(1)]],
    device uchar* exps [[buffer(2)]],
    constant int& total [[buffer(3)]],
    uint tid [[thread_index_in_threadgroup]],
    uint group_idx [[threadgroup_position_in_grid]]
) {
    threadgroup float s_abs[32];
    uint idx = group_idx * 32u + tid;
    float val = (idx < uint(total)) ? x[idx] : 0.0f;
    s_abs[tid] = abs(val);
    threadgroup_barrier(mem_flags::mem_threadgroup);

    for (uint stride = 16u; stride > 0u; stride /= 2u) {
        if (tid < stride) {
            s_abs[tid] = max(s_abs[tid], s_abs[tid + stride]);
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    float amax = s_abs[0];
    uchar shared_exp = 0;
    if (amax > 0.0f) {
        int e = int(floor(log2(amax / 448.0f))) + 127;
        e = clamp(e, 0, 255);
        shared_exp = uchar(e);
    }

    if (tid == 0u) {
        exps[group_idx] = shared_exp;
    }

    if (idx < uint(total)) {
        float scale = pow(2.0f, float(shared_exp) - 127.0f);
        float unscaled = (scale > 0.0f) ? (val / scale) : 0.0f;
        codes[idx] = float_to_fp8_e4m3_msl(unscaled);
    }
}

kernel void grim_quant_q4k(
    device const float* x [[buffer(0)]],
    device uchar* out [[buffer(1)]],
    constant int& total [[buffer(2)]],
    uint tid [[thread_index_in_threadgroup]],
    uint block_idx [[threadgroup_position_in_grid]]
) {
    device uchar* block_out = out + block_idx * 144u;
    threadgroup float s_min[8];
    threadgroup float s_max[8];

    if (tid < 8u) {
        float sub_min = 1e30f;
        float sub_max = -1e30f;
        uint base_idx = block_idx * 256u + tid * 32u;
        for (uint i = 0u; i < 32u; ++i) {
            uint idx = base_idx + i;
            float val = (idx < uint(total)) ? x[idx] : 0.0f;
            sub_min = min(sub_min, val);
            sub_max = max(sub_max, val);
        }
        s_min[tid] = sub_min;
        s_max[tid] = sub_max;
    }

    threadgroup_barrier(mem_flags::mem_threadgroup);

    if (tid == 0u) {
        float max_d = 0.0f;
        float max_m = 0.0f;
        for (int i = 0; i < 8; ++i) {
            float range = s_max[i] - s_min[i];
            float d_i = range / 15.0f;
            float m_i = -s_min[i] / 15.0f;
            if (d_i > max_d) max_d = d_i;
            if (m_i > max_m) max_m = m_i;
        }

        half d_h = half(max_d);
        half dmin_h = half(max_m);
        ushort d_bits = as_type<ushort>(d_h);
        ushort dmin_bits = as_type<ushort>(dmin_h);

        block_out[0] = uchar(d_bits & 0xFFu);
        block_out[1] = uchar((d_bits >> 8u) & 0xFFu);
        block_out[2] = uchar(dmin_bits & 0xFFu);
        block_out[3] = uchar((dmin_bits >> 8u) & 0xFFu);

        float id = (max_d > 0.0f) ? (1.0f / max_d) : 0.0f;
        float idmin = (max_m > 0.0f) ? (1.0f / max_m) : 0.0f;

        uchar sc[8];
        uchar m_sc[8];
        for (int i = 0; i < 8; ++i) {
            float range = s_max[i] - s_min[i];
            float d_i = range / 15.0f;
            float m_i = -s_min[i] / 15.0f;
            sc[i] = uchar(clamp(int(round(d_i * id)), 0, 63));
            m_sc[i] = uchar(clamp(int(round(m_i * idmin)), 0, 63));
        }

        for (int i = 0; i < 4; ++i) {
            block_out[4 + i] = sc[i] | ((sc[i + 4] & 0x03) << 6);
            block_out[8 + i] = m_sc[i] | ((m_sc[i + 4] & 0x03) << 6);
            block_out[12 + (i % 2) * 2 + i / 2] = ((sc[i + 4] >> 2) & 0x0F) | (((m_sc[i + 4] >> 2) & 0x0F) << 4);
        }
    }

    threadgroup_barrier(mem_flags::mem_threadgroup);

    device uchar* qs = block_out + 16u;
    for (uint i = tid; i < 128u; i += 32u) {
        uint sb = i / 16u;
        uint rel = (i % 16u);
        uint idx0 = block_idx * 256u + sb * 32u + rel;
        uint idx1 = idx0 + 16u;

        float v0 = (idx0 < uint(total)) ? x[idx0] : 0.0f;
        float v1 = (idx1 < uint(total)) ? x[idx1] : 0.0f;

        int q0 = clamp(int(round((v0 + 1.0f) * 7.5f)), 0, 15);
        int q1 = clamp(int(round((v1 + 1.0f) * 7.5f)), 0, 15);

        qs[i] = uchar((q0 & 0x0F) | ((q1 & 0x0F) << 4));
    }
}

kernel void grim_softmax(
    device const float* x [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& last_dim [[buffer(2)]],
    constant int& total [[buffer(3)]],
    uint idx [[thread_position_in_grid]]
) {
    if (idx < uint(total)) {
        int row = idx / last_dim;
        int col = idx % last_dim;

        float max_val = -1e30f;
        for (int j = 0; j < last_dim; ++j) {
            max_val = max(max_val, x[row * last_dim + j]);
        }

        float sum = 0.0f;
        for (int j = 0; j < last_dim; ++j) {
            sum += exp(x[row * last_dim + j] - max_val);
        }

        out[idx] = exp(x[idx] - max_val) / (sum > 0.0f ? sum : 1.0f);
    }
}

kernel void grim_embedding(
    device const float* weight [[buffer(0)]],
    device const uint* indices [[buffer(1)]],
    device float* out [[buffer(2)]],
    constant int& embedding_dim [[buffer(3)]],
    constant int& num_indices [[buffer(4)]],
    uint idx [[thread_position_in_grid]]
) {
    int total = num_indices * embedding_dim;
    if (idx < uint(total)) {
        int token_idx = idx / embedding_dim;
        int embed_offset = idx % embedding_dim;

        uint word_idx = indices[token_idx];
        out[idx] = weight[word_idx * embedding_dim + embed_offset];
    }
}

struct TileConfig {
    int block_m;
    int block_n;
    int block_k;
};

kernel void grim_matmul(
    device const float* a [[buffer(0)]],
    device const float* b [[buffer(1)]],
    device float* c [[buffer(2)]],
    constant int& m [[buffer(3)]],
    constant int& n [[buffer(4)]],
    constant int& k [[buffer(5)]],
    constant TileConfig& config [[buffer(6)]],
    uint2 tg_id [[threadgroup_position_in_grid]],
    uint2 tid [[thread_position_in_threadgroup]]
) {
    threadgroup float tile_a[32][32];
    threadgroup float tile_b[32][32];

    int block_m = config.block_m;
    int block_n = config.block_n;
    int block_k = config.block_k;

    int row_start = tg_id.y * block_m;
    int col_start = tg_id.x * block_n;

    float acc = 0.0f;
    for (int bk = 0; bk < k; bk += block_k) {
        int t_row = tid.y;
        int t_col = tid.x;
        if (row_start + t_row < m && bk + t_col < k) {
            tile_a[t_row][t_col] = a[(row_start + t_row) * k + (bk + t_col)];
        } else {
            tile_a[t_row][t_col] = 0.0f;
        }

        if (bk + t_row < k && col_start + t_col < n) {
            tile_b[t_row][t_col] = b[(bk + t_row) * n + (col_start + t_col)];
        } else {
            tile_b[t_row][t_col] = 0.0f;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);

        for (int i = 0; i < block_k; ++i) {
            acc += tile_a[t_row][i] * tile_b[i][t_col];
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    int out_row = row_start + tid.y;
    int out_col = col_start + tid.x;
    if (out_row < m && out_col < n) {
        c[out_row * n + out_col] = acc;
    }
}

kernel void grim_qkv_attention(
    device const float* q [[buffer(0)]],
    device const float* k_tensor [[buffer(1)]],
    device const float* v_tensor [[buffer(2)]],
    device float* out [[buffer(3)]],
    device float* out_max [[buffer(4)]],
    device float* out_sum [[buffer(5)]],
    constant int& num_heads [[buffer(6)]],
    constant int& num_kv_heads [[buffer(7)]],
    constant int& head_dim [[buffer(8)]],
    constant int& seq_len [[buffer(9)]],
    constant int& kv_seq_len [[buffer(10)]],
    constant int& cache_offset [[buffer(11)]],
    constant float& inv_sqrt_d [[buffer(12)]],
    uint2 id [[thread_position_in_grid]],
    uint tid [[thread_index_in_threadgroup]],
    uint2 tg_id [[threadgroup_position_in_grid]]
) {
    uint i = tg_id.x;
    uint h = tg_id.y;
    if (i >= uint(seq_len) || h >= uint(num_heads)) return;

    int q_per_kv = num_heads / num_kv_heads;
    int kv_head = h / q_per_kv;
    int q_offset = (i * num_heads + h) * head_dim;
    int abs_i = cache_offset + i;
    int range_len = (abs_i < kv_seq_len) ? (abs_i + 1) : kv_seq_len;

    // Threadgroup tiling buffers for key-value slots
    threadgroup float tile_k[32][32];
    threadgroup float tile_v[32][32];

    float running_max = -1e30f;
    float running_sum = 0.0f;
    
    // Output registers accumulator
    float acc[128] = {0.0f};

    // Load query locally
    float local_q[128];
    for (int d = 0; d < head_dim && d < 128; ++d) {
        local_q[d] = q[q_offset + d];
    }

    for (int block_start = 0; block_start < range_len; block_start += 32) {
        int block_end = min(block_start + 32, range_len);
        
        // Coalesced collaborative load from device memory to threadgroup shared storage
        if (tid < 32) {
            for (int d = 0; d < head_dim && d < 32; ++d) {
                int j = block_start + tid;
                if (j < block_end) {
                    tile_k[tid][d] = k_tensor[(j * num_kv_heads + kv_head) * head_dim + d];
                    tile_v[tid][d] = v_tensor[(j * num_kv_heads + kv_head) * head_dim + d];
                } else {
                    tile_k[tid][d] = 0.0f;
                    tile_v[tid][d] = 0.0f;
                }
            }
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);

        // Score evaluation & scaling over the block
        for (int j_local = 0; j_local < (block_end - block_start); ++j_local) {
            float score = 0.0f;
            for (int d = 0; d < head_dim && d < 32; ++d) {
                score += local_q[d] * tile_k[j_local][d];
            }
            score *= inv_sqrt_d;

            float prev_max = running_max;
            running_max = max(running_max, score);
            float scale_prev = exp(prev_max - running_max);
            float scale_score = exp(score - running_max);
            
            running_sum = running_sum * scale_prev + scale_score;

            for (int d = 0; d < head_dim && d < 128; ++d) {
                acc[d] = acc[d] * scale_prev + scale_score * tile_v[j_local][d];
            }
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    float inv_sum = running_sum > 0.0f ? (1.0f / running_sum) : 1.0f;
    for (int d = 0; d < head_dim && d < 128; ++d) {
        out[q_offset + d] = acc[d] * inv_sum;
    }

    if (out_max != nullptr) {
        out_max[i * num_heads + h] = running_max;
    }
    if (out_sum != nullptr) {
        out_sum[i * num_heads + h] = running_sum;
    }
}

kernel void grim_qkv_attention_paged(
    device const float* q [[buffer(0)]],
    device const float* k_pages [[buffer(1)]],
    device const float* v_pages [[buffer(2)]],
    device const uint* block_table [[buffer(3)]],
    device float* out [[buffer(4)]],
    constant int& batch [[buffer(5)]],
    constant int& num_heads [[buffer(6)]],
    constant int& head_dim [[buffer(7)]],
    constant int& page_size [[buffer(8)]],
    constant int& max_blocks [[buffer(9)]],
    constant int& kv_seq_len [[buffer(10)]],
    constant int& num_kv_heads [[buffer(11)]],
    uint3 id [[thread_position_in_grid]]) {
    int d = int(id.x);
    int h = int(id.y);
    int b = int(id.z);
    if (b >= batch || h >= num_heads || d >= head_dim) return;
    int q_base = (b * num_heads + h) * head_dim;
    float scale = rsqrt(float(head_dim));
    float running_max = -1e30f;
    float running_sum = 0.0f;
    float acc = 0.0f;
    for (int pos = 0; pos < kv_seq_len; ++pos) {
        int logical_block = pos / page_size;
        if (logical_block >= max_blocks) break;
        int physical_block = int(block_table[b * max_blocks + logical_block]);
        int offset = pos % page_size;
        int kv_head = h / (num_heads / num_kv_heads);
        int kv_base = ((physical_block * page_size + offset) * num_kv_heads + kv_head) * head_dim;
        float score = 0.0f;
        for (int qd = 0; qd < head_dim; ++qd) score += q[q_base + qd] * k_pages[kv_base + qd];
        score *= scale;
        float old_max = running_max;
        running_max = max(running_max, score);
        float old_weight = exp(old_max - running_max);
        float new_weight = exp(score - running_max);
        running_sum = running_sum * old_weight + new_weight;
        acc = acc * old_weight + new_weight * v_pages[kv_base + d];
    }
    out[q_base + d] = running_sum > 0.0f ? acc / running_sum : 0.0f;
}

kernel void grim_tree_attention(
    device const float* q [[buffer(0)]],
    device const float* k [[buffer(1)]],
    device const float* v [[buffer(2)]],
    device const uint* parents [[buffer(3)]],
    device float* out [[buffer(4)]],
    constant int& batch [[buffer(5)]],
    constant int& num_heads [[buffer(6)]],
    constant int& kv_seq_len [[buffer(7)]],
    constant int& head_dim [[buffer(8)]],
    constant int& gamma [[buffer(9)]],
    constant int& cache_offset [[buffer(10)]],
    constant int& num_kv_heads [[buffer(11)]],
    uint3 id [[thread_position_in_grid]]) {
    int d = int(id.x);
    int head_work = int(id.y);
    int b = int(id.z);
    int nodes = gamma + 1;
    int node = head_work / num_heads;
    int q_head = head_work % num_heads;
    if (b >= batch || node >= nodes || d >= head_dim) return;
    int q_base = ((b * nodes + node) * num_heads) * head_dim;
    float scale = rsqrt(float(head_dim));
    float running_max = -1e30f;
    float running_sum = 0.0f;
    float acc = 0.0f;
    for (int pos = 0; pos < kv_seq_len; ++pos) {
        bool attend = pos < cache_offset;
        if (!attend) {
            int tree_node = pos - cache_offset;
            if (tree_node <= node) {
                attend = tree_node == node;
                int cursor = node;
                for (int depth = 0; depth <= gamma && cursor > 0; ++depth) {
                    cursor = int(parents[cursor]);
                    if (cursor == tree_node) { attend = true; break; }
                }
            }
        }
        if (!attend) continue;
        int q_per_kv = num_heads / num_kv_heads;
        int kv_head = q_head / q_per_kv;
        int q_head_base = q_base + q_head * head_dim;
        int kv_base = ((b * kv_seq_len + pos) * num_kv_heads + kv_head) * head_dim;
        float score = 0.0f;
        for (int qd = 0; qd < head_dim; ++qd) score += q[q_head_base + qd] * k[kv_base + qd];
        score *= scale;
        float old_max = running_max;
        running_max = max(running_max, score);
        float old_weight = exp(old_max - running_max);
        float new_weight = exp(score - running_max);
        running_sum = running_sum * old_weight + new_weight;
        acc = acc * old_weight + new_weight * v[kv_base + d];
    }
    out[q_base + d] = running_sum > 0.0f ? acc / running_sum : 0.0f;
}

kernel void grim_kv_dequant_attention(
    device const float* q [[buffer(0)]],
    device const uchar* k_tensor [[buffer(1)]],
    device const float* k_scales [[buffer(2)]],
    device const uchar* v_tensor [[buffer(3)]],
    device const float* v_scales [[buffer(4)]],
    device float* out [[buffer(5)]],
    constant int& num_heads [[buffer(6)]],
    constant int& num_kv_heads [[buffer(7)]],
    constant int& head_dim [[buffer(8)]],
    constant int& seq_len [[buffer(9)]],
    constant int& kv_seq_len [[buffer(10)]],
    constant int& cache_offset [[buffer(11)]],
    constant float& inv_sqrt_d [[buffer(12)]],
    constant int& quant_bits [[buffer(13)]],
    uint2 tg_id [[threadgroup_position_in_grid]]
) {
    uint i = tg_id.x;
    uint h = tg_id.y;
    if (i >= uint(seq_len) || h >= uint(num_heads)) return;

    int q_per_kv = num_heads / num_kv_heads;
    int kv_head = h / q_per_kv;
    int q_offset = (i * num_heads + h) * head_dim;
    int abs_i = cache_offset + i;
    int range_len = (abs_i < kv_seq_len) ? (abs_i + 1) : kv_seq_len;

    float running_max = -1e30f;
    float running_sum = 0.0f;
    float acc[256] = {0.0f};

    // Load query locally
    float local_q[256];
    for (int d = 0; d < head_dim && d < 256; ++d) {
        local_q[d] = q[q_offset + d];
    }

    for (int j = 0; j < range_len; ++j) {
        float score = 0.0f;
        float scale_k = k_scales[j * num_kv_heads + kv_head];
        
        if (quant_bits == 8) {
            int k_row_offset = (j * num_kv_heads + kv_head) * head_dim;
            for (int d = 0; d < head_dim && d < 256; ++d) {
                float k_val = (((float)((int)k_tensor[k_row_offset + d]) - 128.0f) / 127.0f) * scale_k;
                score += local_q[d] * k_val;
            }
        } else {
            int k_row_offset = ((j * num_kv_heads + kv_head) * head_dim) / 2;
            for (int d = 0; d < head_dim && d < 256; ++d) {
                uchar byte = k_tensor[k_row_offset + d / 2];
                float nib = (float)((d % 2 == 0) ? (byte & 0xF) : (byte >> 4));
                float k_val = (nib - 8.0f) / 7.0f * scale_k;
                score += local_q[d] * k_val;
            }
        }
        score *= inv_sqrt_d;

        float prev_max = running_max;
        running_max = max(running_max, score);
        float scale_prev = exp(prev_max - running_max);
        float scale_score = exp(score - running_max);
        running_sum = running_sum * scale_prev + scale_score;

        float scale_v = v_scales[j * num_kv_heads + kv_head];
        if (quant_bits == 8) {
            int v_row_offset = (j * num_kv_heads + kv_head) * head_dim;
            for (int d = 0; d < head_dim && d < 256; ++d) {
                float v_val = (((float)((int)v_tensor[v_row_offset + d]) - 128.0f) / 127.0f) * scale_v;
                acc[d] = acc[d] * scale_prev + scale_score * v_val;
            }
        } else {
            int v_row_offset = ((j * num_kv_heads + kv_head) * head_dim) / 2;
            for (int d = 0; d < head_dim && d < 256; ++d) {
                uchar byte = v_tensor[v_row_offset + d / 2];
                float nib = (float)((d % 2 == 0) ? (byte & 0xF) : (byte >> 4));
                float v_val = (nib - 8.0f) / 7.0f * scale_v;
                acc[d] = acc[d] * scale_prev + scale_score * v_val;
            }
        }
    }

    float inv_sum = running_sum > 0.0f ? (1.0f / running_sum) : 1.0f;
    for (int d = 0; d < head_dim && d < 256; ++d) {
        out[q_offset + d] = acc[d] * inv_sum;
    }
}

kernel void grim_mul_scalar(
    device const float* x [[buffer(0)]],
    constant float& scalar [[buffer(1)]],
    device float* out [[buffer(2)]],
    constant int& n [[buffer(3)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n)) {
        out[id] = x[id] * scalar;
    }
}

kernel void grim_sqrt(
    device const float* x [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n)) {
        out[id] = sqrt(x[id]);
    }
}

kernel void grim_recip(
    device const float* x [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n)) {
        out[id] = 1.0f / x[id];
    }
}

kernel void grim_rope(
    device const float* x [[buffer(0)]],
    device const uint* pos [[buffer(1)]],
    device float* out [[buffer(2)]],
    constant int& num_tokens [[buffer(3)]],
    constant int& num_heads [[buffer(4)]],
    constant int& head_dim [[buffer(5)]],
    constant float& base [[buffer(6)]],
    uint idx [[thread_position_in_grid]]
) {
    int half_dim = head_dim / 2;
    int total = num_tokens * num_heads * half_dim;
    if (idx < uint(total)) {
        int pair_idx = idx % half_dim;
        int head_idx = (idx / half_dim) % num_heads;
        int token_idx = idx / (half_dim * num_heads);

        uint p = pos[token_idx];
        float freq = 1.0f / pow(base, (float)(2 * pair_idx) / (float)head_dim);
        float val = (float)p * freq;
        float cos_v = cos(val);
        float sin_v = sin(val);

        int base_offset = (token_idx * num_heads + head_idx) * head_dim;
        int i0 = base_offset + 2 * pair_idx;
        int i1 = base_offset + 2 * pair_idx + 1;

        float v0 = x[i0];
        float v1 = x[i1];

        out[i0] = v0 * cos_v - v1 * sin_v;
        out[i1] = v0 * sin_v + v1 * cos_v;
    }
}

kernel void grim_quantized_matmul_q8_0(
    device const float* a [[buffer(0)]],
    device const uchar* b [[buffer(1)]],
    device const float* b_scales [[buffer(2)]],
    device float* out [[buffer(3)]],
    constant int& m [[buffer(4)]],
    constant int& n [[buffer(5)]],
    constant int& k [[buffer(6)]],
    uint2 id [[thread_position_in_grid]]
) {
    int row = id.y;
    int col = id.x;
    if (row < m && col < n) {
        float sum = 0.0f;
        int blocks_per_row = k / 32;
        for (int b_idx = 0; b_idx < blocks_per_row; ++b_idx) {
            float scale = b_scales[col * blocks_per_row + b_idx];
            int b_offset = (col * blocks_per_row + b_idx) * 32;
            int a_offset = row * k + b_idx * 32;
            for (int i = 0; i < 32; ++i) {
                char q = (char)b[b_offset + i];
                sum += a[a_offset + i] * ((float)q * scale);
            }
        }
        out[row * n + col] = sum;
    }
}

// ResidualPacked forward GEMM.  Codes are MSB-first within each byte and each
// logical output row has a 256-byte aligned stride.  Auxiliary arrays are
// explicit buffers: scales are decoded host-side, while outlier indices and
// values are uploaded as compact device arrays for a bounded lookup.
inline uint residual_code(device const uchar* b, uint row_base, uint index, uint bpw) {
    uint bit = index * bpw;
    uint byte = row_base + (bit >> 3);
    uint shift = 8u - bpw - (bit & 7u);
    return (uint(b[byte]) >> shift) & ((1u << bpw) - 1u);
}

kernel void grim_quantized_matmul_residualpacked(
    device const float* a [[buffer(0)]], device const uchar* b [[buffer(1)]],
    device const float* scales [[buffer(2)]], device const uint* outlier_indices [[buffer(3)]],
    device const float* outlier_values [[buffer(4)]], device float* out [[buffer(5)]],
    constant int& m [[buffer(6)]], constant int& n [[buffer(7)]], constant int& k [[buffer(8)]],
    constant int& bpw [[buffer(9)]], constant int& row_stride [[buffer(10)]],
    constant int& scale_offset [[buffer(11)]], constant int& backup1_bpw [[buffer(12)]],
    constant int& backup1_offset [[buffer(13)]], constant int& backup1_scale_offset [[buffer(14)]],
    constant int& backup2_bpw [[buffer(15)]], constant int& backup2_offset [[buffer(16)]],
    constant int& backup2_scale_offset [[buffer(17)]], constant int& outlier_count [[buffer(18)]],
    uint2 id [[thread_position_in_grid]]) {
    int row = int(id.y), col = int(id.x);
    if (row >= m || col >= n) return;
    float sum = 0.0f;
    for (int j = 0; j < k; ++j) {
        uint flat = uint(col * k + j);
        float value = float(residual_code(b, uint(col * row_stride), uint(j), uint(bpw))) * scales[col];
        if (backup1_bpw > 0)
            value += float(residual_code(b, uint(backup1_offset + col * row_stride), uint(j), uint(backup1_bpw))) * scales[n + col];
        if (backup2_bpw > 0)
            value += float(residual_code(b, uint(backup2_offset + col * row_stride), uint(j), uint(backup2_bpw))) * scales[2 * n + col];
        for (int oi = 0; oi < outlier_count; ++oi)
            if (outlier_indices[oi] == flat) { value = outlier_values[oi]; break; }
        sum += a[row * k + j] * value;
    }
    out[row * n + col] = sum;
}

kernel void grim_quantized_matmul_backward_q8_0(
    device const float* dy [[buffer(0)]],
    device const uchar* b [[buffer(1)]],
    device const float* scales [[buffer(2)]],
    device float* dx [[buffer(3)]],
    constant int& m [[buffer(4)]],
    constant int& n [[buffer(5)]],
    constant int& k [[buffer(6)]],
    uint2 id [[thread_position_in_grid]]) {
    int row = id.y;
    int k_idx = id.x;
    if (row < m && k_idx < k) {
        float sum = 0.0f;
        int blocks = k / 32;
        int block = k_idx / 32;
        int in_block = k_idx % 32;
        for (int col = 0; col < n; ++col) {
            int b_offset = (col * blocks + block) * 32 + in_block;
            char q = (char)b[b_offset];
            float scale = scales[col * blocks + block];
            sum += dy[row * n + col] * (float(q) * scale);
        }
        dx[row * k + k_idx] = sum;
    }
}

kernel void grim_quantized_matmul_q8_0(
    device const float* a [[buffer(0)]],
    device const uchar* b [[buffer(1)]],
    device const float* b_scales [[buffer(2)]],
    device float* out [[buffer(3)]],
    constant int& m [[buffer(4)]],
    constant int& n [[buffer(5)]],
    constant int& k [[buffer(6)]],
    uint2 id [[thread_position_in_grid]]
) {
    int row = id.y;
    int col = id.x;
    if (row < m && col < n) {
        float sum = 0.0f;
        int blocks_per_row = k / 32;
        for (int b_idx = 0; b_idx < blocks_per_row; ++b_idx) {
            float scale = b_scales[col * blocks_per_row + b_idx];
            int b_offset = (col * blocks_per_row + b_idx) * 32;
            int a_offset = row * k + b_idx * 32;
            for (int i = 0; i < 32; ++i) {
                char q = (char)b[b_offset + i];
                sum += a[a_offset + i] * ((float)q * scale);
            }
        }
        out[row * n + col] = sum;
    }
}

// ── SCYTHE-2 all_reduce accumulate kernel ─────────────────────────────
//   out[id] += a[id]
// Caller pre-zeros `out`, then dispatches once per input tensor to
// accumulate a sum across N same-shape inputs.
kernel void grim_all_reduce(
    device const float* a [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n)) {
        out[id] += a[id];
    }
}

// ── SCYTHE-2 comm_fuse_reduce scatter-copy kernel ──────────────────────
// Copies a column shard In[row, col] → Out[row, col_offset + col],
// where Out is [m, n_total] (pre-zeroed) and In is [m, n_src].
kernel void grim_comm_fuse_reduce(
    device const float* in [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& m [[buffer(2)]],
    constant int& n_src [[buffer(3)]],
    constant int& col_offset [[buffer(4)]],
    constant int& n_total [[buffer(5)]],
    uint2 id [[thread_position_in_grid]]
) {
    int row = int(id.y);
    int col = int(id.x);
    if (row < m && col < n_src) {
        out[row * n_total + col_offset + col] = in[row * n_src + col];
    }
}

// ── Standalone Dequantization MSL Kernels ──────────────────────────────

inline float metal_fp16_to_float(ushort h) {
    uint sign = (h >> 15) & 1;
    uint exp  = (h >> 10) & 0x1f;
    uint mant = h & 0x3ff;
    if (exp == 0) {
        if (mant == 0) return sign ? -0.0f : 0.0f;
        float res = (float)mant / 1024.0f * 0.00006103515625f;
        return sign ? -res : res;
    } else if (exp == 31) {
        return sign ? -1.0f/0.0f : 1.0f/0.0f;
    }
    float res = (1.0f + (float)mant / 1024.0f) * pow(2.0f, (float)exp - 15.0f);
    return sign ? -res : res;
}

inline float metal_fp8_e4m3_to_float(uchar val) {
    int sign = (val >> 7) & 1;
    int exp = (val >> 3) & 0x0F;
    int mant = val & 0x07;
    if (exp == 0xF) {
        if (mant == 7) return 0.0f / 0.0f; // NaN
        float v = 448.0f;
        return sign ? -v : v;
    }
    float res;
    if (exp != 0) {
        res = (1.0f + (float)mant / 8.0f) * pow(2.0f, (float)exp - 7.0f);
    } else {
        res = (float)mant / 512.0f;
    }
    return sign ? -res : res;
}

inline float metal_mxfp4_to_float(uchar code, uchar shared_exp) {
    int sign = (code >> 3) & 1;
    int exp = (code >> 1) & 3;
    int mant = code & 1;
    float base_val = 0.0f;
    if (exp == 0) {
        base_val = (float)mant * 0.5f;
    } else {
        base_val = (1.0f + (float)mant * 0.5f) * pow(2.0f, (float)exp - 1.0f);
    }
    if (sign) base_val = -base_val;
    float scale = pow(2.0f, (float)shared_exp - 127.0f);
    return base_val * scale;
}

kernel void grim_dequant_fp8(
    device const uchar* packed [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& elem_count [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(elem_count)) {
        out[id] = metal_fp8_e4m3_to_float(packed[id]);
    }
}

kernel void grim_dequant_mxfp4(
    device const uchar* codes [[buffer(0)]],
    device const uchar* exps [[buffer(1)]],
    device float* out [[buffer(2)]],
    constant int& elem_count [[buffer(3)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(elem_count)) {
        int byte_idx = id / 2;
        uchar packed = codes[byte_idx];
        uchar nib = (id % 2 == 0) ? (packed & 0x0F) : (packed >> 4);
        uchar shared_exp = exps[id / 32];
        out[id] = metal_mxfp4_to_float(nib, shared_exp);
    }
}

kernel void grim_dequant_mxfp8(
    device const uchar* codes [[buffer(0)]],
    device const uchar* exps [[buffer(1)]],
    device float* out [[buffer(2)]],
    constant int& elem_count [[buffer(3)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(elem_count)) {
        uchar code = codes[id];
        uchar shared_exp = exps[id / 32];
        float base_val = metal_fp8_e4m3_to_float(code);
        float scale = pow(2.0f, (float)shared_exp - 127.0f);
        out[id] = base_val * scale;
    }
}

kernel void grim_dequant_q4k(
    device const uchar* packed [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n_blocks [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n_blocks * 256)) {
        int block_idx = id / 256;
        int in_sb = id % 256;
        device const uchar* block_ptr = packed + block_idx * 144;
        device const ushort* h_ptr = (device const ushort*)block_ptr;
        float d = metal_fp16_to_float(h_ptr[0]);
        float dmin = metal_fp16_to_float(h_ptr[1]);

        device const uchar* scales = block_ptr + 4;
        device const uchar* qs = block_ptr + 16;

        int is = in_sb / 32;
        uchar sc, m;
        if (is < 4) {
            sc = scales[is] & 63;
            m  = scales[is + 4] & 63;
        } else {
            sc = (scales[is + 4] & 0xF) | ((scales[is - 4] >> 6) << 4);
            m  = (scales[is + 4] >> 4)  | ((scales[is] >> 6) << 4);
        }

        int il = in_sb % 32;
        uchar q;
        if (il < 16) {
            q = qs[is * 16 + il] & 0xF;
        } else {
            q = qs[is * 16 + il - 16] >> 4;
        }

        out[id] = d * (float)sc * (float)q - dmin * (float)m;
    }
}

kernel void grim_dequant_q8_0(
    device const uchar* packed [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n_blocks [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n_blocks * 32)) {
        int block_idx = id / 32;
        int in_block = id % 32;
        device const uchar* block_ptr = packed + block_idx * 34;
        device const ushort* h_ptr = (device const ushort*)block_ptr;
        float d = metal_fp16_to_float(h_ptr[0]);
        char q = (char)block_ptr[2 + in_block];
        out[id] = d * (float)q;
    }
}

kernel void grim_dequant_iq2xxs(
    device const uchar* packed [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n_blocks [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n_blocks * 256)) {
        int block_idx = id / 256;
        int in_sb = id % 256;
        device const uchar* block_ptr = packed + block_idx * 66;
        device const ushort* h_ptr = (device const ushort*)block_ptr;
        float d = metal_fp16_to_float(h_ptr[0]);
        uchar q = block_ptr[2 + in_sb / 4];
        uchar val = (q >> ((in_sb % 4) * 2)) & 3;
        out[id] = d * (float)val;
    }
}

kernel void grim_dequant_iq2xs(
    device const uchar* packed [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n_blocks [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n_blocks * 256)) {
        int block_idx = id / 256;
        int in_sb = id % 256;
        device const uchar* block_ptr = packed + block_idx * 74;
        device const ushort* h_ptr = (device const ushort*)block_ptr;
        float d = metal_fp16_to_float(h_ptr[0]);
        uchar q = block_ptr[2 + in_sb / 4];
        uchar val = (q >> ((in_sb % 4) * 2)) & 3;
        out[id] = d * (float)val;
    }
}

kernel void grim_dequant_iq2s(
    device const uchar* packed [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n_blocks [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n_blocks * 256)) {
        int block_idx = id / 256;
        int in_sb = id % 256;
        device const uchar* block_ptr = packed + block_idx * 82;
        device const ushort* h_ptr = (device const ushort*)block_ptr;
        float d = metal_fp16_to_float(h_ptr[0]);
        uchar q = block_ptr[2 + in_sb / 4];
        uchar val = (q >> ((in_sb % 4) * 2)) & 3;
        out[id] = d * (float)val;
    }
}

kernel void grim_dequant_iq3xxs(
    device const uchar* packed [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n_blocks [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n_blocks * 256)) {
        int block_idx = id / 256;
        int in_sb = id % 256;
        device const uchar* block_ptr = packed + block_idx * 96;
        device const ushort* h_ptr = (device const ushort*)block_ptr;
        float d = metal_fp16_to_float(h_ptr[0]);
        uchar q = block_ptr[2 + in_sb / 3];
        uchar val = (q >> ((in_sb % 3) * 2)) & 7;
        out[id] = d * (float)val;
    }
}

kernel void grim_dequant_iq3s(
    device const uchar* packed [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n_blocks [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n_blocks * 256)) {
        int block_idx = id / 256;
        int in_sb = id % 256;
        device const uchar* block_ptr = packed + block_idx * 110;
        device const ushort* h_ptr = (device const ushort*)block_ptr;
        float d = metal_fp16_to_float(h_ptr[0]);
        uchar q = block_ptr[2 + in_sb / 3];
        uchar val = (q >> ((in_sb % 3) * 2)) & 7;
        out[id] = d * (float)val;
    }
}

kernel void grim_dequant_iq4nl(
    device const uchar* packed [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n_blocks [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n_blocks * 256)) {
        int block_idx = id / 256;
        int in_sb = id % 256;
        device const uchar* block_ptr = packed + block_idx * 170;
        device const ushort* h_ptr = (device const ushort*)block_ptr;
        float d = metal_fp16_to_float(h_ptr[0]);
        uchar q = block_ptr[2 + in_sb / 2];
        uchar nib = (in_sb % 2 == 0) ? (q & 0x0F) : (q >> 4);
        out[id] = d * (float)nib;
    }
}

kernel void grim_dequant_iq4xs(
    device const uchar* packed [[buffer(0)]],
    device float* out [[buffer(1)]],
    constant int& n_blocks [[buffer(2)]],
    uint id [[thread_position_in_grid]]
) {
    if (id < uint(n_blocks * 256)) {
        int block_idx = id / 256;
        int in_sb = id % 256;
        device const uchar* block_ptr = packed + block_idx * 178;
        device const ushort* h_ptr = (device const ushort*)block_ptr;
        float d = metal_fp16_to_float(h_ptr[0]);
        uchar q = block_ptr[2 + in_sb / 2];
        uchar nib = (in_sb % 2 == 0) ? (q & 0x0F) : (q >> 4);
        out[id] = d * (float)nib;
    }
}

// ---- Fused grouped MoE dispatch (WI-M5) ----------------------------------
// One thread per output element of `out` ([batch, hidden]); each thread scans
// the routed (token, expert) pairs that target its token and accumulates the
// gated MLP contribution sequentially. Sequential accumulation (no atomics)
// makes the GPU result bit-for-bit reproducible against the CPU reference,
// which is what the parity test asserts. Contract matches the Vulkan/CUDA
// `moe_fused_dispatch` kernels.
kernel void grim_moe_fused_dispatch(
    device const float* x [[buffer(0)]],
    device const float* gate_w [[buffer(1)]],
    device const float* up_w [[buffer(2)]],
    device const float* down_w [[buffer(3)]],
    device const float* router_tokens [[buffer(4)]],
    device const float* router_experts [[buffer(5)]],
    device const float* router_weights [[buffer(6)]],
    device float* out [[buffer(7)]],
    constant int& hidden [[buffer(8)]],
    constant int& inter [[buffer(9)]],
    constant int& num_experts [[buffer(10)]],
    constant int& batch [[buffer(11)]],
    constant float& rsf [[buffer(12)]],
    constant int& num_pairs [[buffer(13)]],
    uint2 gid [[thread_position_in_grid]]
) {
    if (gid.x >= uint(batch) || gid.y >= uint(hidden)) return;
    int tok = int(gid.x);
    int h = int(gid.y);
    int x_base = tok * hidden;
    float acc = 0.0f; // accumulates this (tok,h) output across all routed pairs
    for (int p = 0; p < num_pairs; ++p) {
        if (int(router_tokens[p]) != tok) continue;
        int exp_id = int(router_experts[p]);
        float weight = router_weights[p];
        int gw_base = exp_id * inter * hidden;
        int uw_base = exp_id * inter * hidden;
        int dw_base = exp_id * hidden * inter;
        // Gate/up project hidden -> inter. `i` is the inter (expert-inner) index.
        float down = 0.0f;
        for (int i = 0; i < inter; ++i) {
            float g = 0.0f, u = 0.0f;
            for (int j = 0; j < hidden; ++j) {
                float xv = x[x_base + j];
                g += gate_w[gw_base + i * hidden + j] * xv;
                u += up_w[uw_base + i * hidden + j] * xv;
            }
            float a = g / (1.0f + exp(-g)) * u; // silu(g) * u
            down += down_w[dw_base + h * inter + i] * a;
        }
        acc += rsf * weight * down;
    }
    out[tok * hidden + h] = acc;
}

