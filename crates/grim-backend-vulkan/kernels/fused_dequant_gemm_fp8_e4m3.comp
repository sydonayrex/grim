// fused_dequant_gemm_fp8_e4m3.comp
//
// Fused dequantize-GEMM for FP8 E4M3 (block-scaled) weights.
//
// Block layout (4-byte global scale + 1 FP8 byte per weight):
//   [0..3]   global_scale : f32 — global multiplier for all weights
//   [4..]    codes        : 1×u8 per weight (FP8 E4M3, bias=7)
//
// Each weight: fp8_e4m3_to_f32(code) * global_scale
//
// E4M3 (1 sign | 4 exp | 3 mantissa, bias = 7):
//   exp == 0xF, mant == 7 → NaN
//   exp == 0xF            → ±448.0
//   exp == 0              → mant / 512.0
//   else                  → (1 + mant/8) * 2^(exp - 7)
//
// Contract: K can be any size; no block alignment required.

#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint size;
    uint dim;
    uint k;
    uint n;
    uint m;
    float eps;
} params;

layout(std430, binding = 0) readonly buffer BufA   { float A[]; };
layout(std430, binding = 1) readonly buffer BufB   { uint  B_bytes[]; };
layout(std430, binding = 2) writeonly buffer BufC  { float C[]; };

uint get_byte(uint byte_idx) {
    uint word  = B_bytes[byte_idx / 4u];
    uint shift = (byte_idx % 4u) * 8u;
    return (word >> shift) & 0xFFu;
}

// E4M3: bit7=sign, bits[6:3]=exponent (4 bits, bias 7), bits[2:0]=mantissa (3 bits)
float fp8_e4m3_to_f32(uint byte) {
    uint sign = (byte >> 7u) & 1u;
    uint exp  = (byte >> 3u) & 0x0Fu;
    uint mant = byte & 0x07u;

    if (exp == 0x0Fu) {
        if (mant == 7u) {
            return uintBitsToFloat(0x7FC00000u); // NaN
        }
        float val = 448.0;
        return sign == 1u ? -val : val;
    }

    if (exp == 0u) {
        float result = float(mant) / 512.0;
        return sign == 1u ? -result : result;
    }

    float result = (1.0 + float(mant) / 8.0) * exp2(float(exp) - 7.0);
    return sign == 1u ? -result : result;
}

float read_global_scale() {
    uint f0 = get_byte(0u) | (get_byte(1u) << 8u) | (get_byte(2u) << 16u) | (get_byte(3u) << 24u);
    return uintBitsToFloat(f0);
}

shared float s_a[16][16];
shared float s_b[16][16];

void main() {
    uint M = params.m;
    uint N = params.n;
    uint K = params.k;

    uint bx = gl_WorkGroupID.x;
    uint by = gl_WorkGroupID.y;
    uint tx = gl_LocalInvocationID.x;
    uint ty = gl_LocalInvocationID.y;

    uint row = by * 16u + ty;
    uint col = bx * 16u + tx;

    float global_scale = read_global_scale();

    float acc = 0.0;

    // FP8: 1 byte per weight, starting after 4-byte global scale header.
    uint code_base = 4u;

    for (uint bk = 0u; bk < K; bk += 16u) {
        if (row < M && (bk + tx) < K) {
            s_a[ty][tx] = A[row * K + bk + tx];
        } else {
            s_a[ty][tx] = 0.0;
        }

        uint k_idx = bk + ty;
        if (col < N && k_idx < K) {
            uint flat_weight_idx = col * K + k_idx;
            uint code_byte = get_byte(code_base + flat_weight_idx);
            s_b[ty][tx] = fp8_e4m3_to_f32(code_byte) * global_scale;
        } else {
            s_b[ty][tx] = 0.0;
        }

        barrier();

        for (uint k = 0u; k < 16u; ++k) {
            acc += s_a[ty][k] * s_b[k][tx];
        }

        barrier();
    }

    if (row < M && col < N) {
        C[row * N + col] = acc;
    }
}
