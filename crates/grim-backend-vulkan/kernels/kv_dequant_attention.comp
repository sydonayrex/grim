#version 450

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint size;
    uint dim;
    uint k;
    uint n;
    uint m;
    float eps;
} params;

layout(std430, binding = 0) readonly buffer BufQ { float Q[]; };
layout(std430, binding = 1) readonly buffer BufK { uint K_bytes[]; };
layout(std430, binding = 2) readonly buffer BufV { uint V_bytes[]; };
layout(std430, binding = 3) writeonly buffer BufOut { float Out[]; };

uint get_byte_k(uint byte_idx) {
    uint word = K_bytes[byte_idx / 4u];
    uint shift = (byte_idx % 4u) * 8u;
    return (word >> shift) & 0xFFu;
}

uint get_byte_v(uint byte_idx) {
    uint word = V_bytes[byte_idx / 4u];
    uint shift = (byte_idx % 4u) * 8u;
    return (word >> shift) & 0xFFu;
}

float unpack_f16_bytes(uint b0, uint b1) {
    uint bits = b0 | (b1 << 8u);
    if (bits == 0u) return 0.0;
    uint sign = (bits >> 15u) & 1u;
    uint exp = (bits >> 10u) & 0x1Fu;
    uint mant = bits & 0x3FFu;
    if (exp == 0u) {
        if (mant == 0u) return 0.0;
        float f = float(mant) / 1024.0 * exp2(-14.0);
        return sign == 1u ? -f : f;
    } else if (exp == 31u) {
        return sign == 1u ? -1.0 / 0.0 : 1.0 / 0.0;
    } else {
        float f = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
        return sign == 1u ? -f : f;
    }
}

void main() {
    uint seq_len = params.m;
    uint head_dim = params.n;
    uint tid = gl_GlobalInvocationID.x;

    if (tid >= head_dim) return;

    float scale = 1.0 / sqrt(float(head_dim));
    float q_val = Q[tid] * scale;

    float acc_out = 0.0;
    float sum_exp = 0.0;
    float max_score = -1e30;

    for (uint t = 0u; t < seq_len; ++t) {
        uint block_start = t * 34u;
        float d_k = unpack_f16_bytes(get_byte_k(block_start), get_byte_k(block_start + 1u));
        uint raw_k = get_byte_k(block_start + 2u + (tid % 32u));
        int sb_k = (raw_k >= 128u) ? int(raw_k) - 256 : int(raw_k);
        float k_val = d_k * float(sb_k);

        float score = q_val * k_val;
        if (score > max_score) {
            sum_exp = sum_exp * exp(max_score - score) + 1.0;
            max_score = score;
        } else {
            sum_exp += exp(score - max_score);
        }

        float d_v = unpack_f16_bytes(get_byte_v(block_start), get_byte_v(block_start + 1u));
        uint raw_v = get_byte_v(block_start + 2u + (tid % 32u));
        int sb_v = (raw_v >= 128u) ? int(raw_v) - 256 : int(raw_v);
        float v_val = d_v * float(sb_v);

        float p = exp(score - max_score);
        acc_out += p * v_val;
    }

    if (sum_exp > 0.0) {
        Out[tid] = acc_out / sum_exp;
    } else {
        Out[tid] = 0.0;
    }
}
