#version 450

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint seq_len;
    uint head_dim;
    uint quant_bits;  // 8 for Q8_0, 4 for Q4_K
    uint num_heads;
    uint block_stride; // bytes per KV block (34 for Q8_0, 16 for Q4_K)
    float inv_sqrt_d;
} params;

layout(std430, binding = 0) readonly buffer BufQ { float Q[]; };
layout(std430, binding = 1) readonly buffer BufK { uint K_packed[]; };
layout(std430, binding = 2) readonly buffer BufV { uint V_packed[]; };
layout(std430, binding = 3) readonly buffer BufKScales { float K_scales[]; };
layout(std430, binding = 4) readonly buffer BufVScales { float V_scales[]; };
layout(std430, binding = 5) writeonly buffer BufOut { float Out[]; };

// Q8_0 dequant: 1 byte per value, scale per block
float dequant_q8(uint byte_idx, float scale) {
    uint word = K_packed[byte_idx / 4u];
    uint shift = (byte_idx % 4u) * 8u;
    uint raw = (word >> shift) & 0xFFu;
    int sb = (raw >= 128u) ? int(raw) - 256 : int(raw);
    return scale * float(sb);
}

// Q4_K dequant: 2 values per byte (low nibble first), scale per block
float dequant_q4(uint byte_idx, uint elem_offset, float scale) {
    uint word = K_packed[byte_idx / 4u];
    uint shift = (byte_idx % 4u) * 8u;
    uint byte_val = (word >> shift) & 0xFFu;
    uint nibble = (elem_offset % 2u == 0u) ? (byte_val & 0xFu) : ((byte_val >> 4u) & 0xFu);
    int sb = (nibble >= 8u) ? int(nibble) - 16 : int(nibble);
    return scale * float(sb);
}

float dequant_k(uint t, uint d, uint head_dim) {
    if (params.quant_bits == 8u) {
        uint block_start = t * params.block_stride;
        float d_k = K_scales[t];
        return dequant_q8(block_start + d, d_k);
    } else {
        // Q4_K: block_stride=16 bytes per block (8 bytes scales + 8 bytes packed)
        uint block_start = t * params.block_stride;
        float d_k = K_scales[t];
        uint byte_idx = block_start + (d / 2u);
        return dequant_q4(byte_idx, d, d_k);
    }
}

float dequant_v(uint t, uint d, uint head_dim) {
    if (params.quant_bits == 8u) {
        uint block_start = t * params.block_stride;
        float d_v = V_scales[t];
        return dequant_q8(block_start + d, d_v);
    } else {
        uint block_start = t * (params.block_stride);
        float d_v = V_scales[t];
        uint byte_idx = block_start + (d / 2u);
        uint word = V_packed[byte_idx / 4u];
        uint shift = (byte_idx % 4u) * 8u;
        uint byte_val = (word >> shift) & 0xFFu;
        uint nibble = (d % 2u == 0u) ? (byte_val & 0xFu) : ((byte_val >> 4u) & 0xFu);
        int sb = (nibble >= 8u) ? int(nibble) - 16 : int(nibble);
        return d_v * float(sb);
    }
}

void main() {
    uint seq_len = params.seq_len;
    uint head_dim = params.head_dim;
    uint tid = gl_GlobalInvocationID.x;

    if (tid >= head_dim) return;

    float q_val = Q[tid] * params.inv_sqrt_d;

    float acc_out = 0.0;
    float sum_exp = 0.0;
    float max_score = -1e30;

    for (uint t = 0u; t < seq_len; ++t) {
        float k_val = dequant_k(t, tid % head_dim, head_dim);
        float v_val = dequant_v(t, tid % head_dim, head_dim);

        float score = q_val * k_val;
        if (score > max_score) {
            sum_exp = sum_exp * exp(max_score - score) + 1.0;
            max_score = score;
        } else {
            sum_exp += exp(score - max_score);
        }

        float p = exp(score - max_score);
        acc_out += p * v_val;
    }

    if (sum_exp > 0.0) {
        Out[tid] = acc_out / sum_exp;
    } else {
        Out[tid] = 0.0;
    }
}
