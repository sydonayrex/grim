#version 450

layout(local_size_x = 256) in;

layout(push_constant) uniform Params {
    uint size;
    uint dim;
    uint k;
    uint n;
    uint m;
    float eps;
} params;

layout(std430, binding = 0) readonly buffer BIAS { float bias[]; };
layout(std430, binding = 1) writeonly buffer OutBuf { float data[]; };

// Replicate the 1-D bias [out_dim] row-wise into [batch, out_dim].
void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= params.size) return;
    uint out_dim = params.n;
    data[id] = bias[id % out_dim];
}
