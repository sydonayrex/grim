#version 450

layout(local_size_x = 256) in;

layout(push_constant) uniform Params {
    uint size;
    uint dim;
    uint k;
    uint n;
    uint m;
    float eps;
} params;

layout(std430, binding = 0) readonly buffer Grad { float g[]; };
layout(std430, binding = 1) readonly buffer Cos { float c[]; };
layout(std430, binding = 2) readonly buffer Sin { float s[]; };
layout(std430, binding = 3) writeonly buffer Dx { float dx[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.size) return;
    // Only even indices start a pair; the even thread writes both elements.
    if (i % 2 == 0 && i + 1 < params.size) {
        float g0 = g[i];
        float g1 = g[i + 1];
        float cv = c[i];
        float sv = s[i];
        // Inverse rotation: swap the sign of the sin term.
        dx[i] = g0 * cv + g1 * sv;
        dx[i + 1] = -g0 * sv + g1 * cv;
    }
}
