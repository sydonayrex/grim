// fused_dequant_gemm_iq3xxs.comp
//
// Fused dequantize-GEMM for IQ3_XXS weights (llama.cpp block_iq3_xxs).
//
// Block layout (96 bytes, 256 elements per block):
//   [0..1]    d     : f16   — global scale (2 bytes)
//   [2..65]   qs    : 64 bytes — grid indices (1 byte per 8 weights, via i/8)
//   [66..95]  signs : 30 bytes — sign bits (1 bit per weight, wraps at 30 bytes)
//
// Value reconstruction for element i:
//   grid_idx  = qs[i / 8]
//   sub_idx   = i % 8
//   base_val  = ((grid_idx + sub_idx * 17) % 7) - 3    →  {-3..4}
//   sign_bit  = (signs[i / 8] >> (i % 8)) & 1
//   result    = d * base_val * 0.25 * sign
//
// Contract: K must be divisible by 256.

#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint size;
    uint dim;
    uint k;
    uint n;
    uint m;
    float eps;
} params;

layout(std430, binding = 0) readonly buffer BufA   { float A[]; };
layout(std430, binding = 1) readonly buffer BufB   { uint  B_bytes[]; };
layout(std430, binding = 2) writeonly buffer BufC  { float C[]; };

uint get_byte(uint byte_idx) {
    uint word  = B_bytes[byte_idx / 4u];
    uint shift = (byte_idx % 4u) * 8u;
    return (word >> shift) & 0xFFu;
}

float unpack_f16_bytes(uint b0, uint b1) {
    uint bits = b0 | (b1 << 8u);
    if (bits == 0u) return 0.0;
    uint sign = (bits >> 15u) & 1u;
    uint exp  = (bits >> 10u) & 0x1Fu;
    uint mant =  bits         & 0x3FFu;
    if (exp == 0u) {
        if (mant == 0u) return 0.0;
        float f = float(mant) / 1024.0 * exp2(-14.0);
        return sign == 1u ? -f : f;
    } else if (exp == 31u) {
        return sign == 1u ? -1.0/0.0 : 1.0/0.0;
    } else {
        float f = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
        return sign == 1u ? -f : f;
    }
}

/// Dequantize one element from an IQ3_XXS block.
/// block_start: byte offset of the 96-byte block.
/// in_sb      : element index within the 256-element block (0..255).
float dequant_iq3xxs_element(uint block_start, uint in_sb) {
    float d = unpack_f16_bytes(get_byte(block_start), get_byte(block_start + 1u));

    uint group = in_sb / 8u;
    uint sub_idx = in_sb % 8u;

    uint grid_idx = uint(get_byte(block_start + 2u + group));
    float base_val = float((grid_idx + sub_idx * 17u) % 7u) - 3.0;

    // Signs start at block_start + 66 (2 + 64). 30 bytes, index wraps.
    uint signs_idx = group % 30u;
    uint signs_byte = get_byte(block_start + 66u + signs_idx);
    uint sign_bit = (signs_byte >> sub_idx) & 1u;
    float sign = sign_bit == 0u ? 1.0 : -1.0;

    return d * base_val * 0.25 * sign;
}

shared float s_a[16][16];
shared float s_b[16][16];

void main() {
    uint M = params.m;
    uint N = params.n;
    uint K = params.k;

    uint bx = gl_WorkGroupID.x;
    uint by = gl_WorkGroupID.y;
    uint tx = gl_LocalInvocationID.x;
    uint ty = gl_LocalInvocationID.y;

    uint row = by * 16u + ty;
    uint col = bx * 16u + tx;

    // IQ3_XXS: 256 elements per block, 96 bytes per block.
    uint blocks_per_col = K / 256u;
    uint col_stride     = blocks_per_col * 96u;

    float acc = 0.0;

    for (uint bk = 0u; bk < K; bk += 16u) {
        if (row < M && (bk + tx) < K) {
            s_a[ty][tx] = A[row * K + bk + tx];
        } else {
            s_a[ty][tx] = 0.0;
        }

        uint k_idx = bk + ty;
        if (col < N && k_idx < K) {
            uint sb_idx      = k_idx / 256u;
            uint in_sb       = k_idx % 256u;
            uint block_start = col * col_stride + sb_idx * 96u;
            s_b[ty][tx] = dequant_iq3xxs_element(block_start, in_sb);
        } else {
            s_b[ty][tx] = 0.0;
        }

        barrier();

        for (uint k = 0u; k < 16u; ++k) {
            acc += s_a[ty][k] * s_b[k][tx];
        }

        barrier();
    }

    if (row < M && col < N) {
        C[row * N + col] = acc;
    }
}
