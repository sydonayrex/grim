#version 450

layout(local_size_x = 256) in;

layout(push_constant) uniform Params {
    uint size;
    uint dim;
    uint k;
    uint n;
    uint m;
    float eps;
} params;

layout(std430, binding = 0) readonly buffer X { float x[]; };
layout(std430, binding = 1) writeonly buffer Y { float y[]; };

// Barrier-free (see reduce_sum.comp). Ties resolve to the LAST index
// (greater-or-equal update), matching the trait contract
// (Iterator::max_by returns the last maximum). Index is written as a
// bit-cast u32.
void main() {
    if (gl_GlobalInvocationID.x != 0) return;
    float best = -3.402823466e38;
    uint best_idx = 0;
    for (uint i = 0; i < params.size; i++) {
        if (x[i] >= best) {
            best = x[i];
            best_idx = i;
        }
    }
    y[0] = uintBitsToFloat(best_idx);
}
