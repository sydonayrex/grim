// fused_dequant_gemm_iq2xxs.comp
//
// Fused dequantize-GEMM for IQ2_XXS weights (llama.cpp block_iq2_xxs).
//
// Block layout (66 bytes, 256 elements per block):
//   [0..1]    d     : f16   — global scale (2 bytes)
//   [2..33]   qs    : 32 bytes — 8D grid indices (1 byte per 8 weights)
//   [34..65]  signs : 32 bytes — sign bits (256 bits packed, 1 bit per weight)
//
// Value reconstruction: for element i,
//   grid_idx  = qs[i / 8]
//   val       = ((grid_idx + (i % 8)) % 4) - 1.5   →  {-1.5, -0.5, 0.5, 1.5}
//   sign_bit  = (signs[i / 8] >> (i % 8)) & 1
//   result    = d * val * sign
//
// Contract: K must be divisible by 256.

#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint size;
    uint dim;
    uint k;
    uint n;
    uint m;
    float eps;
} params;

layout(std430, binding = 0) readonly buffer BufA   { float A[]; };
layout(std430, binding = 1) readonly buffer BufB   { uint  B_bytes[]; };
layout(std430, binding = 2) writeonly buffer BufC  { float C[]; };

uint get_byte(uint byte_idx) {
    uint word  = B_bytes[byte_idx / 4u];
    uint shift = (byte_idx % 4u) * 8u;
    return (word >> shift) & 0xFFu;
}

float unpack_f16_bytes(uint b0, uint b1) {
    uint bits = b0 | (b1 << 8u);
    if (bits == 0u) return 0.0;
    uint sign = (bits >> 15u) & 1u;
    uint exp  = (bits >> 10u) & 0x1Fu;
    uint mant =  bits         & 0x3FFu;
    if (exp == 0u) {
        if (mant == 0u) return 0.0;
        float f = float(mant) / 1024.0 * exp2(-14.0);
        return sign == 1u ? -f : f;
    } else if (exp == 31u) {
        return sign == 1u ? -1.0/0.0 : 1.0/0.0;
    } else {
        float f = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
        return sign == 1u ? -f : f;
    }
}

/// Dequantize one element from an IQ2_XXS block.
/// block_start: byte offset of the 66-byte block.
/// in_sb      : element index within the 256-element block (0..255).
float dequant_iq2xxs_element(uint block_start, uint in_sb) {
    float d = unpack_f16_bytes(get_byte(block_start), get_byte(block_start + 1u));

    uint group = in_sb / 8u;
    uint bit_in_group = in_sb % 8u;

    // Grid index from qs (block_start + 2).
    uint grid_idx = uint(get_byte(block_start + 2u + group));

    float val = float((grid_idx + bit_in_group) % 4u) - 1.5;

    // Sign from signs (block_start + 2 + 32 = block_start + 34).
    uint signs_byte = get_byte(block_start + 34u + group);
    uint sign_bit = (signs_byte >> bit_in_group) & 1u;
    float sign = sign_bit == 0u ? 1.0 : -1.0;

    return d * val * sign;
}

shared float s_a[16][16];
shared float s_b[16][16];

void main() {
    uint M = params.m;
    uint N = params.n;
    uint K = params.k;

    uint bx = gl_WorkGroupID.x;
    uint by = gl_WorkGroupID.y;
    uint tx = gl_LocalInvocationID.x;
    uint ty = gl_LocalInvocationID.y;

    uint row = by * 16u + ty;
    uint col = bx * 16u + tx;

    // IQ2_XXS: 256 elements per block, 66 bytes per block.
    uint blocks_per_col = K / 256u;
    uint col_stride     = blocks_per_col * 66u;

    float acc = 0.0;

    for (uint bk = 0u; bk < K; bk += 16u) {
        if (row < M && (bk + tx) < K) {
            s_a[ty][tx] = A[row * K + bk + tx];
        } else {
            s_a[ty][tx] = 0.0;
        }

        uint k_idx = bk + ty;
        if (col < N && k_idx < K) {
            uint sb_idx      = k_idx / 256u;
            uint in_sb       = k_idx % 256u;
            uint block_start = col * col_stride + sb_idx * 66u;
            s_b[ty][tx] = dequant_iq2xxs_element(block_start, in_sb);
        } else {
            s_b[ty][tx] = 0.0;
        }

        barrier();

        for (uint k = 0u; k < 16u; ++k) {
            acc += s_a[ty][k] * s_b[k][tx];
        }

        barrier();
    }

    if (row < M && col < N) {
        C[row * N + col] = acc;
    }
}
