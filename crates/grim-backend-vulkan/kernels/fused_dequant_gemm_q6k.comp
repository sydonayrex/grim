// fused_dequant_gemm_q6k.comp
//
// Fused dequantize-GEMM for Q6_K weights (llama.cpp block_q6_K).
//
// Block layout (210 bytes, 256 elements per block):
//   [0..127]   ql    : 128×u8  — low 4 bits of each 6-bit quant (2 packed per byte)
//   [128..191] qh    : 64×u8   — high 2 bits for each pair of quants (4 packed per byte)
//   [192..207] scales: 16×i8   — signed int8 scale per sub-block (8 sub-blocks of 32)
//   [208..209] d     : f16     — super-block scale
//
// Contract: K must be divisible by 256.

#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint size;
    uint dim;
    uint k;
    uint n;
    uint m;
    float eps;
} params;

layout(std430, binding = 0) readonly buffer BufA  { float A[]; };
layout(std430, binding = 1) readonly buffer BufB  { uint  B_bytes[]; };
layout(std430, binding = 2) writeonly buffer BufC { float C[]; };

uint get_byte(uint byte_idx) {
    uint word  = B_bytes[byte_idx / 4u];
    uint shift = (byte_idx % 4u) * 8u;
    return (word >> shift) & 0xFFu;
}

float unpack_f16_bytes(uint b0, uint b1) {
    uint bits = b0 | (b1 << 8u);
    if (bits == 0u) return 0.0;
    uint sign = (bits >> 15u) & 1u;
    uint exp  = (bits >> 10u) & 0x1Fu;
    uint mant =  bits         & 0x3FFu;
    if (exp == 0u) {
        if (mant == 0u) return 0.0;
        float f = float(mant) / 1024.0 * exp2(-14.0);
        return sign == 1u ? -f : f;
    } else if (exp == 31u) {
        return sign == 1u ? -1.0/0.0 : 1.0/0.0;
    } else {
        float f = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
        return sign == 1u ? -f : f;
    }
}

/// Dequantize one Q6_K element.
///
/// block_start: byte offset of the 210-byte block (ql starts at offset 0).
/// in_sb      : element index within the 256-element block (0..255).
float dequant_q6k_element(uint block_start, uint in_sb) {
    // Super-block scale d at [208..209].
    float d = unpack_f16_bytes(get_byte(block_start + 208u), get_byte(block_start + 209u));

    // Sub-block index (0..7) and position within sub-block (0..31).
    uint isb        = in_sb / 32u;
    uint idx_in_sub = in_sb % 32u;

    // Signed scale for this sub-block from scales[isb] at [192..207].
    uint sc_raw  = get_byte(block_start + 192u + isb);
    int  sc_sign = (sc_raw >= 128u) ? int(sc_raw) - 256 : int(sc_raw);
    float sc     = float(sc_sign);

    // Low 4 bits: ql layout — 128 bytes, one byte per pair of adjacent elements.
    // Elements (i, i+128) share one byte: lo=i%128, hi=(i+128)%128.
    // Here in_sb ∈ [0..255]:
    //   ql byte = in_sb % 128, nibble = (in_sb >= 128) ? hi : lo.
    uint ql_offset = block_start + in_sb % 128u;
    uint ql_byte   = get_byte(ql_offset);
    uint ql        = (in_sb >= 128u) ? (ql_byte >> 4u) : (ql_byte & 0x0Fu);

    // High 2 bits: qh layout — 64 bytes, four 2-bit codes per byte.
    // Byte = in_sb / 4, bit-pair shift = (in_sb % 4) * 2.
    uint qh_offset = block_start + 128u + in_sb / 4u;
    uint qh_byte   = get_byte(qh_offset);
    uint qh        = (qh_byte >> ((in_sb % 4u) * 2u)) & 0x3u;

    // 6-bit unsigned value, biased by 32 to get signed [-32..31].
    uint q_raw    = ql | (qh << 4u);
    int  q_signed = int(q_raw) - 32;

    return d * sc * float(q_signed);
}

shared float s_a[16][16];
shared float s_b[16][16];

void main() {
    uint M = params.m;
    uint N = params.n;
    uint K = params.k;

    uint bx = gl_WorkGroupID.x;
    uint by = gl_WorkGroupID.y;
    uint tx = gl_LocalInvocationID.x;
    uint ty = gl_LocalInvocationID.y;

    uint row = by * 16u + ty;
    uint col = bx * 16u + tx;

    // Q6_K: 256 elements per block, 210 bytes per block.
    uint blocks_per_col = K / 256u;
    uint col_stride     = blocks_per_col * 210u;

    float acc = 0.0;

    for (uint bk = 0u; bk < K; bk += 16u) {
        if (row < M && (bk + tx) < K) {
            s_a[ty][tx] = A[row * K + bk + tx];
        } else {
            s_a[ty][tx] = 0.0;
        }

        uint k_idx = bk + ty;
        if (col < N && k_idx < K) {
            uint sb_idx      = k_idx / 256u;
            uint in_sb       = k_idx % 256u;
            uint block_start = col * col_stride + sb_idx * 210u;
            s_b[ty][tx] = dequant_q6k_element(block_start, in_sb);
        } else {
            s_b[ty][tx] = 0.0;
        }

        barrier();

        for (uint k = 0u; k < 16u; ++k) {
            acc += s_a[ty][k] * s_b[k][tx];
        }

        barrier();
    }

    if (row < M && col < N) {
        C[row * N + col] = acc;
    }
}
