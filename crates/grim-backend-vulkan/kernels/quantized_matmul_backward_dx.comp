#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint size;
    uint dim;
    uint k;
    uint n;
    uint m;
    float eps;
} params;

layout(std430, binding = 0) readonly buffer BufDY { float dY[]; };
layout(std430, binding = 1) readonly buffer BufB { uint B_bytes[]; };
layout(std430, binding = 2) writeonly buffer BufDX { float dX[]; };

uint get_byte(uint byte_idx) {
    uint word = B_bytes[byte_idx / 4u];
    uint shift = (byte_idx % 4u) * 8u;
    return (word >> shift) & 0xFFu;
}

float unpack_f16_bytes(uint b0, uint b1) {
    uint bits = b0 | (b1 << 8u);
    if (bits == 0u) return 0.0;
    uint sign = (bits >> 15u) & 1u;
    uint exp = (bits >> 10u) & 0x1Fu;
    uint mant = bits & 0x3FFu;
    if (exp == 0u) {
        if (mant == 0u) return 0.0;
        float f = float(mant) / 1024.0 * exp2(-14.0);
        return sign == 1u ? -f : f;
    } else if (exp == 31u) {
        return sign == 1u ? -1.0 / 0.0 : 1.0 / 0.0;
    } else {
        float f = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
        return sign == 1u ? -f : f;
    }
}

void get_scale_min_k4(uint j, uint scale_offset, out float sc, out float m_val) {
    uint sc_u = 0u;
    uint m_u = 0u;
    if (j < 4u) {
        sc_u = get_byte(scale_offset + j) & 63u;
        m_u = get_byte(scale_offset + j + 4u) & 63u;
    } else {
        uint j4 = j - 4u;
        sc_u = (get_byte(scale_offset + j4 + 8u) & 0x0Fu) | ((get_byte(scale_offset + j4) >> 6u) << 4u);
        m_u = (get_byte(scale_offset + j4 + 8u) >> 4u) | ((get_byte(scale_offset + j4 + 4u) >> 6u) << 4u);
    }
    sc = float(sc_u);
    m_val = float(m_u);
}

float dequant_q4k_element(uint block_start, uint in_sb) {
    float d = unpack_f16_bytes(get_byte(block_start), get_byte(block_start + 1u));
    float dmin = unpack_f16_bytes(get_byte(block_start + 2u), get_byte(block_start + 3u));
    uint isb = in_sb / 32u;
    uint idx_in_sub = in_sb % 32u;
    float sc, m_val;
    get_scale_min_k4(isb, block_start + 4u, sc, m_val);
    uint q_byte_offset = block_start + 16u + (isb * 16u) + (idx_in_sub % 16u);
    uint q_byte = get_byte(q_byte_offset);
    uint q_val = (idx_in_sub >= 16u) ? (q_byte >> 4u) : (q_byte & 0x0Fu);
    return d * sc * float(q_val) - dmin * m_val;
}

void main() {
    uint M = params.m;
    uint N = params.n;
    uint K = params.k;

    uint row = gl_GlobalInvocationID.y;
    uint k_idx = gl_GlobalInvocationID.x;

    if (row >= M || k_idx >= K) return;

    uint blocks_per_row = K / 256u;
    uint row_bytes = blocks_per_row * 144u;
    uint sb_idx = k_idx / 256u;
    uint in_sb = k_idx % 256u;

    float acc = 0.0;
    for (uint n = 0u; n < N; ++n) {
        float dy_val = dY[row * N + n];
        uint block_start = n * row_bytes + sb_idx * 144u;
        float w_val = dequant_q4k_element(block_start, in_sb);
        acc += dy_val * w_val;
    }

    dX[row * K + k_idx] = acc;
}
