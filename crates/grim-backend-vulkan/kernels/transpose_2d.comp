#version 450

layout(local_size_x = 256) in;

layout(push_constant) uniform Params {
    uint size;   // rows
    uint dim;    // cols
    uint k;
    uint n;
    uint m;
    float eps;
} params;

layout(std430, binding = 0) readonly buffer SRC { float src[]; };
layout(std430, binding = 1) writeonly buffer DST { float dst[]; };

// [rows, cols] -> [cols, rows]. One thread per output element.
void main() {
    uint id = gl_GlobalInvocationID.x;
    uint rows = params.size;
    uint cols = params.dim;
    if (id >= rows * cols) return;
    uint r = id / cols;
    uint c = id % cols;
    dst[c * rows + r] = src[r * cols + c];
}
