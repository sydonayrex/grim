#version 450

layout(local_size_x = 256) in;

layout(push_constant) uniform Params {
    uint size;
    uint dim;
    uint k;
    uint n;
    uint m;
    float eps;
} params;

layout(std430, binding = 0) readonly buffer X { float x[]; };
layout(std430, binding = 1) readonly buffer R { float r[]; };
layout(std430, binding = 2) readonly buffer W { float w[]; };
layout(std430, binding = 3) writeonly buffer Y { float y[]; };
layout(std430, binding = 4) writeonly buffer N { float normOut[]; };

// Fused Add + RMSNorm: y[id] = x[id] + r[id];
// normOut[id] = (y[id] / rms) * w[col], rms = sqrt(mean(y^2) + eps) over the row.
// Mirrors grim_add_rms_norm on ROCm (HIP) and Metal (MSL) 1:1.
void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= params.size) return;
    uint row = id / params.dim;
    uint col = id % params.dim;

    float yv = x[id] + r[id];
    y[id] = yv;

    float sum_sq = 0.0;
    for (uint i = 0u; i < params.dim; ++i) {
        float v = x[row * params.dim + i] + r[row * params.dim + i];
        sum_sq += v * v;
    }
    float rms = sqrt(sum_sq / float(params.dim) + params.eps);
    normOut[id] = (yv / rms) * w[col];
}
