    #[test]
    fn gdl_forward_matches_gla_oracle() {
        // GRAVE Phase 2 verification: the `forward_gdl` inline recurrence must
        // match the gla.rs f64 oracle (gdn2_step) driven with the same
        // projections, L2-normalized q/k, and the block's gate triple — through
        // a full block forward (norm -> GDL attention -> residual -> FFN).
        let (hidden, heads, kv_heads, head_dim) = (8usize, 2usize, 2usize, 4usize);
        let inter = 16usize;
        let eps = 1e-5f32;
        let steps = 3usize;
        let gates = [0.93f64, 0.5, 0.6]; // decay, erase, write

        let rand = |n: usize, seed: u64| -> Vec<f32> {
            let mut s = seed;
            (0..n)
                .map(|_| {
                    s = s
                        .wrapping_mul(6364136223846793005)
                        .wrapping_add(1442695040888963407);
                    ((s >> 33) as f32 / (u32::MAX as f32)) - 0.5
                })
                .collect()
        };
        let lin = |out: usize, inn: usize, seed: u64| -> Linear {
            Linear::from_tensor(
                cpu_tensor(rand(out * inn, seed), grim_tensor::Shape::new(vec![out, inn])),
                None,
            )
        };
        let matmul = |a: &[f32], w: &[f32], rows: usize, inn: usize, out: usize| -> Vec<f32> {
            (0..rows)
                .flat_map(|r| {
                    (0..out).map(move |o| {
                        (0..inn).map(|i| a[r * inn + i] * w[o * inn + i]).sum::<f32>()
                    })
                })
                .collect()
        };
        let silu = |v: f32| v / (1.0 + (-v).exp());

        let norm_w = vec![1.0f32; hidden];
        let norm = RmsNorm {
            weight: cpu_tensor(norm_w.clone(), grim_tensor::Shape::new(vec![hidden])),
            eps,
        };
        let wq = rand(hidden * hidden, 1);
        let wk = rand(hidden * hidden, 2);
        let wv = rand(hidden * hidden, 3);
        let wo = rand(hidden * hidden, 4);
        let wg = rand(inter * hidden, 5);
        let wu = rand(inter * hidden, 6);
        let wd = rand(hidden * inter, 7);

        let block = Lfm2Block {
            index: 0,
            attn_norm: norm.clone(),
            wq: Some(lin(hidden, hidden, 1)),
            wk: Some(lin(hidden, hidden, 2)),
            wv: Some(lin(hidden, hidden, 3)),
            wo: Some(lin(hidden, hidden, 4)),
            attn_q_norm: None,
            attn_k_norm: None,
            wqkv_codes: None,
            wqkv_exps: None,
            gamma_q: None,
            gamma_k: None,
            w_gate_up_q80_fused: None,
            shortconv_in_proj: None,
            shortconv_conv: None,
            shortconv_conv_vec: None,
            shortconv_out_proj: None,
            ffn_norm: norm.clone(),
            ffn_gate: lin(inter, hidden, 5),
            ffn_up: lin(inter, hidden, 6),
            ffn_down: lin(hidden, inter, 7),
            ffn_gate_inp: None,
            ffn_gate_exps: None,
            ffn_up_exps: None,
            ffn_down_exps: None,
            ffn_exp_probs_b: None,
            is_moe: false,
            n_expert: 0,
            n_expert_used: 1,
            charon_cache: crate::shared_moe::CharonCache::new(),
            moe_experts_cache: std::sync::OnceLock::new(),
            num_heads: heads,
            num_kv_heads: kv_heads,
            head_dim,
            rope_theta: 10_000.0,
            eps,
            attention_mode: Lfm2AttentionMode::Gdl,
            gdl_gates: gates,
        };

        // Actual: full block forward in Gdl mode.
        let x = rand(steps * hidden, 9);
        let x_t = cpu_tensor(x.clone(), grim_tensor::Shape::new(vec![steps, hidden]));
        let mut cache: Option<Lfm2LayerCache> = None;
        let got = block.forward(&x_t, &mut cache).unwrap().to_vec_f32().unwrap();

        // Expected: same math with the recurrence delegated to gla::gdn2_step.
        let wq_w = rand(hidden * hidden, 1);
        let wk_w = rand(hidden * hidden, 2);
        let wv_w = rand(hidden * hidden, 3);
        let wo_w = rand(hidden * hidden, 4);
        let wg_w = rand(inter * hidden, 5);
        let wu_w = rand(inter * hidden, 6);
        let wd_w = rand(hidden * inter, 7);
        let _ = (wq_w, wk_w, wv_w, wo_w, wg_w, wu_w, wd_w);

        let mut x32: Vec<f32> = x.clone();
        for row in 0..steps {
            let inp: Vec<f32> = x32[row * hidden..(row + 1) * hidden].to_vec();
            // RMSNorm (w = 1)
            let ss: f32 = inp.iter().map(|v| v * v).sum();
            let nx: Vec<f32> = inp
                .iter()
                .map(|&v| v / ((ss / hidden as f32 + eps).sqrt()))
                .collect();
            let q = matmul(&nx, &wq, 1, hidden, hidden);
            let k = matmul(&nx, &wk, 1, hidden, hidden);
            let v = matmul(&nx, &wv, 1, hidden, hidden);
            let mut attn = vec![0.0f32; hidden];
            for h in 0..heads {
                let kvs = h / (heads / kv_heads) * head_dim;
                let q_h = &q[qs(h, head_dim)..qs(h, head_dim) + head_dim];
                let k_h = &k[kvs..kvs + head_dim];
                let v_h = &v[kvs..kvs + head_dim];
                let kn: f32 = k_h.iter().map(|v| v * v).sum::<f32>().sqrt().max(1e-12);
                let qn: f32 = q_h.iter().map(|v| v * v).sum::<f32>().sqrt().max(1e-12);
                let k_hat: Vec<f32> = k_h.iter().map(|&v| v / kn).collect();
                let q_hat: Vec<f32> = q_h.iter().map(|&v| v / qn).collect();
                let mut st = vec![vec![0.0f64; head_dim]; head_dim];
                let alpha = vec![gates[0]; head_dim];
                let b = vec![gates[1]; head_dim];
                let w = vec![gates[2]; head_dim];
                let o = crate::gla::gdn2_step(
                    &mut st,
                    &q_hat.iter().map(|&x| x as f64).collect::<Vec<_>>(),
                    &k_hat.iter().map(|&x| x as f64).collect::<Vec<_>>(),
                    &v_h.iter().map(|&x| x as f64).collect::<Vec<_>>(),
                    &alpha,
                    &b,
                    &w,
                );
                for (j, ov) in o.iter().enumerate() {
                    attn[j] += *ov as f32;
                }
            }
            let mut x_added = vec![0.0f32; hidden];
            for j in 0..hidden {
                x_added[j] = inp[j] + attn[j];
            }
            let n2 = rms(&x_added);
            let mut g = matmul(&n2, &wg, 1, hidden, inter);
            let u = matmul(&n2, &wu, 1, hidden, inter);
            for val in g.iter_mut() {
                *val = silu(*val);
            }
            let mut act = vec![0.0f32; inter];
            for (a, (gv, uv)) in act.iter_mut().zip(g.iter().zip(&u)) {
                *a = gv * uv;
            }
            let down = matmul(&act, &wd, 1, inter, hidden);
            for j in 0..hidden {
                x32[row * hidden + j] += down[j];
            }
        }

        for (i, (g, w)) in got.iter().zip(&x32).enumerate() {
            assert!(
                (g - w).abs() <= 5e-4 + w.abs() * 1e-3,
                "GDL forward mismatch at {i}: {g} vs {w}"
            );
        }
    }
