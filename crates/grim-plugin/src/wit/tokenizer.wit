/// WIT (WebAssembly Interface Types) definition for tokenizer plugins.
/// §6.1.1 — Canonical interface definition for WASM tokenizer plugins.

package grim:plugin@0.1.0;

interface tokenizer {
    // Get tokenizer name
    get-name: func() -> string;

    // Encode text to token IDs
    encode: func(text: string) -> result<list<u32>, string>;

    // Decode token IDs to text
    decode: func(tokens: list<u32>) -> result<string, string>;

    // Get vocabulary size
    vocab-size: func() -> u32;

    // Memory usage query
    memory-usage: func() -> u32;
}

world grim-tokenizer {
    export tokenizer;
}
