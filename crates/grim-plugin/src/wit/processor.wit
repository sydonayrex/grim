/// WIT (WebAssembly Interface Types) definition for pre/post-processor plugins.
/// §6.1.1 — Canonical interface definition for WASM prompt/output processor plugins.

package grim:plugin@0.1.0;

interface processor {
    // Get processor name
    get-name: func() -> string;

    // Pre-process input text or prompt templates
    preprocess: func(input: string, context-json: string) -> result<string, string>;

    // Post-process generated output text
    postprocess: func(output: string, context-json: string) -> result<string, string>;

    // Memory usage query
    memory-usage: func() -> u32;
}

world grim-processor {
    export processor;
}
