#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufA { float a[]; };
layout(std430, binding = 1) readonly buffer BufB { float b[]; };
layout(std430, binding = 2) writeonly buffer BufC { float c[]; };

layout(push_constant) uniform Params {
    uint size;
    uint dim;
    uint k;
    uint n;
    uint m;
    float eps;
} params;

shared float a_tile[32][16];
shared float b_tile[16][32];

void main() {
    uint m = params.m;
    uint n = params.n;
    uint k = params.k;

    uint tile_m = 32u;
    uint tile_n = 32u;
    uint tile_k = 16u;

    uint tile_row = gl_WorkGroupID.y * tile_m;
    uint tile_col = gl_WorkGroupID.x * tile_n;

    uint local_row = gl_LocalInvocationID.y;
    uint local_col = gl_LocalInvocationID.x;

    uint global_row = tile_row + local_row * 4u;
    uint global_col = tile_col + local_col * 4u;

    float accum[4][4] = float[4][4](
        float[4](0.0, 0.0, 0.0, 0.0),
        float[4](0.0, 0.0, 0.0, 0.0),
        float[4](0.0, 0.0, 0.0, 0.0),
        float[4](0.0, 0.0, 0.0, 0.0)
    );

    for (uint tk = 0u; tk < k; tk += tile_k) {
        for (uint i = 0u; i < 4u; ++i) {
            uint row = tile_row + local_row * 4u + i;
            uint col = tk + local_col;
            if (row < m && col < k) {
                a_tile[local_row * 4u + i][local_col] = a[row * k + col];
            } else {
                a_tile[local_row * 4u + i][local_col] = 0.0;
            }
        }

        for (uint i = 0u; i < 4u; ++i) {
            uint row = tk + local_row;
            uint col = tile_col + local_col * 4u + i;
            if (row < k && col < n) {
                b_tile[local_row][local_col * 4u + i] = b[row * n + col];
            } else {
                b_tile[local_row][local_col * 4u + i] = 0.0;
            }
        }

        barrier();

        for (uint kk = 0u; kk < tile_k; ++kk) {
            float a_reg[4];
            a_reg[0] = a_tile[local_row * 4u + 0u][kk];
            a_reg[1] = a_tile[local_row * 4u + 1u][kk];
            a_reg[2] = a_tile[local_row * 4u + 2u][kk];
            a_reg[3] = a_tile[local_row * 4u + 3u][kk];

            float b_reg[4];
            b_reg[0] = b_tile[kk][local_col * 4u + 0u];
            b_reg[1] = b_tile[kk][local_col * 4u + 1u];
            b_reg[2] = b_tile[kk][local_col * 4u + 2u];
            b_reg[3] = b_tile[kk][local_col * 4u + 3u];

            accum[0][0] += a_reg[0] * b_reg[0];
            accum[0][1] += a_reg[0] * b_reg[1];
            accum[0][2] += a_reg[0] * b_reg[2];
            accum[0][3] += a_reg[0] * b_reg[3];
            accum[1][0] += a_reg[1] * b_reg[0];
            accum[1][1] += a_reg[1] * b_reg[1];
            accum[1][2] += a_reg[1] * b_reg[2];
            accum[1][3] += a_reg[1] * b_reg[3];
            accum[2][0] += a_reg[2] * b_reg[0];
            accum[2][1] += a_reg[2] * b_reg[1];
            accum[2][2] += a_reg[2] * b_reg[2];
            accum[2][3] += a_reg[2] * b_reg[3];
            accum[3][0] += a_reg[3] * b_reg[0];
            accum[3][1] += a_reg[3] * b_reg[1];
            accum[3][2] += a_reg[3] * b_reg[2];
            accum[3][3] += a_reg[3] * b_reg[3];
        }

        barrier();
    }

    for (uint i = 0u; i < 4u; ++i) {
        for (uint j = 0u; j < 4u; ++j) {
            uint row = global_row + i;
            uint col = global_col + j;
            if (row < m && col < n) {
                c[row * n + col] = accum[i][j];
            }
        }
    }
}