// fused_dequant_gemm_iq4xs.comp
//
// Fused dequantize-GEMM for IQ4_XS weights (llama.cpp block_iq4_xs).
//
// Block layout (136 bytes, 256 elements per block):
//   [0..1]    d      : f16   — global scale (2 bytes)
//   [2..7]   scales  : 6 bytes — 8 sub-blocks of 6-bit (16-bit) scale factors
//   [8..135] qs      : 128 bytes — packed 4-bit codes, 2 per byte
//
// IQ4_XS uses the same 16-entry codebook as IQ4_NL but with the sign bit
// in bit 3 of the nibble. The codebook values are the same IQ4_NL_CODEBOOK.
//
// Contract: K must be divisible by 256.

#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint size;
    uint dim;
    uint k;
    uint n;
    uint m;
    float eps;
} params;

layout(std430, binding = 0) readonly buffer BufA   { float A[]; };
layout(std430, binding = 1) readonly buffer BufB   { uint  B_bytes[]; };
layout(std430, binding = 2) writeonly buffer BufC  { float C[]; };

uint get_byte(uint byte_idx) {
    uint word  = B_bytes[byte_idx / 4u];
    uint shift = (byte_idx % 4u) * 8u;
    return (word >> shift) & 0xFFu;
}

float unpack_f16_bytes(uint b0, uint b1) {
    uint bits = b0 | (b1 << 8u);
    if (bits == 0u) return 0.0;
    uint sign = (bits >> 15u) & 1u;
    uint exp  = (bits >> 10u) & 0x1Fu;
    uint mant =  bits         & 0x3FFu;
    if (exp == 0u) {
        if (mant == 0u) return 0.0;
        float f = float(mant) / 1024.0 * exp2(-14.0);
        return sign == 1u ? -f : f;
    } else if (exp == 31u) {
        return sign == 1u ? -1.0/0.0 : 1.0/0.0;
    } else {
        float f = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
        return sign == 1u ? -f : f;
    }
}

// IQ4_NL / IQ4_XS shared 16-entry codebook (llama.cpp iq4nl_table).
float iq4nl_lookup(uint code) {
    const float tbl[16] = float[16](
        0.0,
        0.11314126,
        0.24373604,
        0.39743365,
        0.56574355,
        0.72294140,
        0.89705455,
        1.07576285,
        1.29459881,
        1.52851904,
        1.82685633,
        2.27001130,
        3.23719119,
        5.50829601,
        10.4162559,
        34.5695092
    );
    return tbl[code & 15u];
}

// Extract 6-bit scale factor for sub-block sb (0..7) from the 6-byte scale buffer.
// Each scale is packed MSB-first: 8 × 6 bits = 48 bits = 6 bytes.
float iq4xs_get_scale(uint scale_offset, uint sb) {
    uint bit_offset = sb * 6u;
    uint byte_idx   = scale_offset + bit_offset / 8u;
    uint in_byte   = bit_offset % 8u;
    // 6-bit value starting at in_byte offset within the 6-byte stream.
    uint raw = get_byte(byte_idx);
    if (in_byte + 6u <= 8u) {
        // Fits in one byte
        raw = (raw >> (8u - in_byte - 6u)) & 0x3Fu;
    } else {
        // Spans two bytes
        uint next_byte = get_byte(byte_idx + 1u);
        uint bits_in_first = 8u - in_byte;
        uint low_bits = raw & ((1u << bits_in_first) - 1u);
        uint high_bits = (next_byte >> (8u - (6u - bits_in_first))) & ((1u << (6u - bits_in_first)) - 1u);
        raw = (low_bits << (6u - bits_in_first)) | high_bits;
    }
    // sc_val * 1.0 / 32.0 with sign: scale = d * (sc_val - 32) / 32
    return float(int(raw) - 32) * (1.0 / 32.0);
}

/// Dequantize one element from an IQ4_XS block.
/// block_start: byte offset of the 136-byte block.
/// in_sb      : element index within the 256-element block (0..255).
float dequant_iq4xs_element(uint block_start, uint in_sb) {
    float d = unpack_f16_bytes(get_byte(block_start), get_byte(block_start + 1u));

    uint sb_idx = in_sb / 32u;    // sub-block 0..7
    uint idx_in_sub = in_sb % 32u; // index within sub-block

    float scale = d * iq4xs_get_scale(block_start + 2u, sb_idx);

    // qs at block_start + 8, 128 bytes, 2 codes per byte.
    uint qs_offset = block_start + 8u + in_sb / 2u;
    uint qs_byte   = get_byte(qs_offset);
    uint nibble    = (in_sb % 2u == 0u) ? (qs_byte & 0x0Fu) : (qs_byte >> 4u);

    float code_mag = iq4nl_lookup(nibble & 0x07u);
    float sign     = (nibble & 0x08u) != 0u ? -1.0 : 1.0;

    return scale * code_mag * sign;
}

shared float s_a[16][16];
shared float s_b[16][16];

void main() {
    uint M = params.m;
    uint N = params.n;
    uint K = params.k;

    uint bx = gl_WorkGroupID.x;
    uint by = gl_WorkGroupID.y;
    uint tx = gl_LocalInvocationID.x;
    uint ty = gl_LocalInvocationID.y;

    uint row = by * 16u + ty;
    uint col = bx * 16u + tx;

    // IQ4_XS: 256 elements per block, 136 bytes per block.
    uint blocks_per_col = K / 256u;
    uint col_stride     = blocks_per_col * 136u;

    float acc = 0.0;

    for (uint bk = 0u; bk < K; bk += 16u) {
        if (row < M && (bk + tx) < K) {
            s_a[ty][tx] = A[row * K + bk + tx];
        } else {
            s_a[ty][tx] = 0.0;
        }

        uint k_idx = bk + ty;
        if (col < N && k_idx < K) {
            uint sb_idx      = k_idx / 256u;
            uint in_sb       = k_idx % 256u;
            uint block_start = col * col_stride + sb_idx * 136u;
            s_b[ty][tx] = dequant_iq4xs_element(block_start, in_sb);
        } else {
            s_b[ty][tx] = 0.0;
        }

        barrier();

        for (uint k = 0u; k < 16u; ++k) {
            acc += s_a[ty][k] * s_b[k][tx];
        }

        barrier();
    }

    if (row < M && col < N) {
        C[row * N + col] = acc;
    }
}
