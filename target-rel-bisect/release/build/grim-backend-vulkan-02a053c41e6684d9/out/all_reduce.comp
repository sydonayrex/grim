#version 450

// all_reduce accumulate kernel (sum reduction).
//   Out[i] += A[i]
// The caller must pre-zero `Out`. Dispatch once per input tensor to
// accumulate a sum across N same-shape inputs (tree-reduction-style
// fan-in without temporary buffers).
// push_params.size = number of elements to reduce.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint size;
    uint dim;
    uint k;
    uint n;
    uint m;
    float eps;
} params;

layout(std430, binding = 0) readonly buffer BufA { float A[]; };
layout(std430, binding = 1) buffer BufOut { float Out[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.size) return;
    Out[i] += A[i];
}
