#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint size;
    uint dim;
    uint k;
    uint n;
    uint m;
    float eps;
} params;

layout(std430, binding = 0) readonly buffer BufX { float X[]; };
layout(std430, binding = 1) readonly buffer BufLastX { float LastX[]; };
layout(std430, binding = 2) readonly buffer BufMix { float Mix[]; };
layout(std430, binding = 3) writeonly buffer BufOut { float Out[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.size) return;

    float x = X[i];
    float last_x = LastX[i];
    float mix = Mix[i];

    Out[i] = x * mix + last_x * (1.0 - mix);
}
