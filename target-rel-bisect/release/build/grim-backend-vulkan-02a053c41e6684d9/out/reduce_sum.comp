#version 450

layout(local_size_x = 256) in;

layout(push_constant) uniform Params {
    uint size;
    uint dim;
    uint k;
    uint n;
    uint m;
    float eps;
} params;

layout(std430, binding = 0) readonly buffer X { float x[]; };
layout(std430, binding = 1) writeonly buffer Y { float y[]; };

// Barrier-free reduction (workgroup shared-memory barrier trees have proven
// wedging on some RADV driver versions — see the grim-nn/flash kernels which
// use subgroup ops instead). Thread 0 walks the whole buffer: for the decode
// sampling sizes this targets (vocab-length logit rows), the serial pass is
// within a millisecond and correctness beats marginal bandwidth.
void main() {
    if (gl_GlobalInvocationID.x != 0) return;
    float acc = 0.0;
    for (uint i = 0; i < params.size; i++) {
        acc += x[i];
    }
    y[0] = acc;
}
