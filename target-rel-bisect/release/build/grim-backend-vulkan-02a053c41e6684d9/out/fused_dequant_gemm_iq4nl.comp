// fused_dequant_gemm_iq4nl.comp
//
// Fused dequantize-GEMM for IQ4_NL weights (llama.cpp block_iq4_nl).
//
// Block layout (18 bytes, 32 elements per block):
//   [0..1]  d  : f16  — block scale
//   [2..17] qs : 16×u8 — packed 4-bit codes (2 per byte)
//
// IQ4_NL uses a fixed 16-entry lookup table (GGML_TABLE_F32_F16_IQ4NL) derived
// from importance-matrix optimization. The table is baked into this shader.
//
// Contract: K must be divisible by 32.

#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint size;
    uint dim;
    uint k;
    uint n;
    uint m;
    float eps;
} params;

layout(std430, binding = 0) readonly buffer BufA  { float A[]; };
layout(std430, binding = 1) readonly buffer BufB  { uint  B_bytes[]; };
layout(std430, binding = 2) writeonly buffer BufC { float C[]; };

uint get_byte(uint byte_idx) {
    uint word  = B_bytes[byte_idx / 4u];
    uint shift = (byte_idx % 4u) * 8u;
    return (word >> shift) & 0xFFu;
}

float unpack_f16_bytes(uint b0, uint b1) {
    uint bits = b0 | (b1 << 8u);
    if (bits == 0u) return 0.0;
    uint sign = (bits >> 15u) & 1u;
    uint exp  = (bits >> 10u) & 0x1Fu;
    uint mant =  bits         & 0x3FFu;
    if (exp == 0u) {
        if (mant == 0u) return 0.0;
        float f = float(mant) / 1024.0 * exp2(-14.0);
        return sign == 1u ? -f : f;
    } else if (exp == 31u) {
        return sign == 1u ? -1.0/0.0 : 1.0/0.0;
    } else {
        float f = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
        return sign == 1u ? -f : f;
    }
}

// IQ4_NL 16-entry importance-matrix lookup table.
// Values from ggml-quants.c: iq4k_values[] (non-linear 4-bit grid).
float iq4nl_lookup(uint code) {
    // GGML_TABLE_F32_F16_IQ4NL (16 entries, indices 0..15)
    const float tbl[16] = float[16](
        -127.0, -104.0, -83.0, -65.0,
         -49.0,  -35.0, -22.0, -10.0,
           1.0,   13.0,  25.0,  38.0,
          53.0,   69.0,  89.0, 113.0
    );
    return tbl[code & 15u];
}

/// Dequantize one IQ4_NL element.
/// block_start: byte offset of the 18-byte block.
/// in_sb      : element index within the 32-element block (0..31).
float dequant_iq4nl_element(uint block_start, uint in_sb) {
    float d = unpack_f16_bytes(get_byte(block_start), get_byte(block_start + 1u));

    // qs: 16 bytes starting at block_start + 2; each byte packs two 4-bit codes.
    uint qs_byte_idx = block_start + 2u + in_sb / 2u;
    uint qs_byte     = get_byte(qs_byte_idx);
    uint code        = (in_sb % 2u == 0u) ? (qs_byte & 0x0Fu) : (qs_byte >> 4u);

    return d * iq4nl_lookup(code) / 127.0;
}

shared float s_a[16][16];
shared float s_b[16][16];

void main() {
    uint M = params.m;
    uint N = params.n;
    uint K = params.k;

    uint bx = gl_WorkGroupID.x;
    uint by = gl_WorkGroupID.y;
    uint tx = gl_LocalInvocationID.x;
    uint ty = gl_LocalInvocationID.y;

    uint row = by * 16u + ty;
    uint col = bx * 16u + tx;

    // IQ4_NL: 32 elements per block, 18 bytes per block.
    uint blocks_per_col = K / 32u;
    uint col_stride     = blocks_per_col * 18u;

    float acc = 0.0;

    for (uint bk = 0u; bk < K; bk += 16u) {
        if (row < M && (bk + tx) < K) {
            s_a[ty][tx] = A[row * K + bk + tx];
        } else {
            s_a[ty][tx] = 0.0;
        }

        uint k_idx = bk + ty;
        if (col < N && k_idx < K) {
            uint sb_idx      = k_idx / 32u;
            uint in_sb       = k_idx % 32u;
            uint block_start = col * col_stride + sb_idx * 18u;
            s_b[ty][tx] = dequant_iq4nl_element(block_start, in_sb);
        } else {
            s_b[ty][tx] = 0.0;
        }

        barrier();

        for (uint k = 0u; k < 16u; ++k) {
            acc += s_a[ty][k] * s_b[k][tx];
        }

        barrier();
    }

    if (row < M && col < N) {
        C[row * N + col] = acc;
    }
}
