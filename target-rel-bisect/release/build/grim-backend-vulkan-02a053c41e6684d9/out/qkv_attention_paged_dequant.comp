#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable

layout(local_size_x = 256) in;

layout(push_constant) uniform Params {
    uint num_heads;
    uint num_kv_heads;
    uint head_dim;
    uint kv_seq_len;
    uint page_size;
    float scale;
} params;

layout(std430, binding = 0) readonly buffer Q { float q_in[]; };
layout(std430, binding = 1) readonly buffer BlockTable { uint block_table[]; };
layout(std430, binding = 2) readonly buffer KPages { int k_pages_int8[]; };
layout(std430, binding = 3) readonly buffer KScales { float k_scales[]; };
layout(std430, binding = 4) readonly buffer VPages { int v_pages_int8[]; };
layout(std430, binding = 5) readonly buffer VScales { float v_scales[]; };
layout(std430, binding = 6) writeonly buffer Out { float out_buf[]; };

shared float s_sub_dot[32];
shared float s_scores[4096];

void main() {
    uint h = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (h >= params.num_heads) return;

    uint gqa_ratio = params.num_heads / max(params.num_kv_heads, 1u);
    uint kv_h = h / max(gqa_ratio, 1u);

    uint q_base = h * params.head_dim;

    // 1. Attention logits over paged quantized K
    for (uint j = 0; j < params.kv_seq_len; ++j) {
        uint block_idx = j / params.page_size;
        uint page_offset = j % params.page_size;
        uint phys_block = block_table[block_idx];

        uint k_entry = (phys_block * params.page_size + page_offset) * (params.num_kv_heads * params.head_dim) + kv_h * params.head_dim;
        uint scale_entry = (phys_block * params.page_size + page_offset) * params.num_kv_heads + kv_h;
        float ks = k_scales[scale_entry];

        float dot = 0.0;
        for (uint d = tid; d < params.head_dim; d += 256u) {
            float k_val = float(k_pages_int8[k_entry + d]) * ks;
            dot += q_in[q_base + d] * k_val;
        }

        #ifdef GL_KHR_shader_subgroup_arithmetic
        dot = subgroupAdd(dot);
        if (subgroupElect()) {
            s_sub_dot[gl_SubgroupID] = dot;
        }
        barrier();
        if (tid < 32u) {
            float s = (tid < gl_NumSubgroups) ? s_sub_dot[tid] : 0.0;
            s = subgroupAdd(s);
            if (tid == 0u) {
                s_scores[j] = s * params.scale;
            }
        }
        barrier();
        #else
        if (tid == 0u) {
            s_scores[j] = dot * params.scale;
        }
        barrier();
        #endif
    }

    // 2. Softmax normalization
    if (tid == 0u) {
        float max_s = -1e20;
        for (uint j = 0; j < params.kv_seq_len; ++j) {
            if (s_scores[j] > max_s) max_s = s_scores[j];
        }
        float sum_e = 0.0;
        for (uint j = 0; j < params.kv_seq_len; ++j) {
            s_scores[j] = exp(s_scores[j] - max_s);
            sum_e += s_scores[j];
        }
        float inv_sum = 1.0 / max(sum_e, 1e-8);
        for (uint j = 0; j < params.kv_seq_len; ++j) {
            s_scores[j] *= inv_sum;
        }
    }
    barrier();

    // 3. Value aggregation over paged quantized V
    uint out_base = h * params.head_dim;
    for (uint d = tid; d < params.head_dim; d += 256u) {
        float acc = 0.0;
        for (uint j = 0; j < params.kv_seq_len; ++j) {
            uint block_idx = j / params.page_size;
            uint page_offset = j % params.page_size;
            uint phys_block = block_table[block_idx];

            uint v_entry = (phys_block * params.page_size + page_offset) * (params.num_kv_heads * params.head_dim) + kv_h * params.head_dim;
            uint scale_entry = (phys_block * params.page_size + page_offset) * params.num_kv_heads + kv_h;
            float vs = v_scales[scale_entry];

            float v_val = float(v_pages_int8[v_entry + d]) * vs;
            acc += s_scores[j] * v_val;
        }
        out_buf[out_base + d] = acc;
    }
}
